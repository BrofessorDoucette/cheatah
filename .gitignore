# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Local reference material (copyrighted books, papers — never commit)
books/

# Editor / IDE
.vscode/
.idea/

# Local agent/tool settings — machine-specific, and they accumulate absolute paths
# to whatever else is checked out on that machine. Never committed to a public tree.
.claude/

# Doxygen XML — intermediate build artifact for the docs generator
docs/xml/
docs/xml-ext/

# clang source-based coverage profiles (scripts/coverage.sh); never committed
*.profraw
*.profdata

# Release packaging artifacts (uploaded to GitHub Releases, not committed)
dist/

# QA release staging + archive (scripts/stage_review.sh, scripts/archive_release.sh):
# review/  holds the latest release build to inspect before pushing;
# archive/ holds compressed tarballs of versions actually released to GitHub.
review/
archive/

# VS Code extension build artifacts (regenerated by the QA gate / install-extension.sh)
editors/vscode/headers/
editors/vscode/*.vsix

# pure-cheatah docgen build artifacts
docs/gen-cheatah/*.so
docs/gen-cheatah/*.gen.cpp

# purrc-generated module outputs (a .purr with a folded sibling .hpp/.cpp; the authored files track)
*.gen.hpp
*.gen.cpp
*.gen.hpp.sha512
# ...except the committed VS Code extension test fixture, which the provider tests read directly.
!editors/vscode/test/fixtures/pkg/text/lexer.gen.hpp

# Python bytecode from the benchmark/QA scripts.
__pycache__/
*.pyc

# Raw Google Benchmark JSON beside a generated table. The stamped .md IS the artifact and is
# committed; the multi-megabyte JSON it came from is reproducible and is not.
docs/bench/*.json
