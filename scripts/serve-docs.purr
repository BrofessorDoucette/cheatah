# serve-docs.purr — the cheatah docs server, written in pure cheatah. 🐆
#
# Production-grade and nginx-shaped, using only the standard library we wrote:
#   socket  — the listener + per-connection fds (a thin BSD-socket wrapper)
#   memory  — the WHOLE site lives in ONE pinned Owner; every worker serves from
#             coexisting shared read leases (zero copies, zero contention, and a
#             future hot-reload is just an exclusive write lease away)
#   thread  — thread.spawn'd workers all accept() on the same listener; the kernel
#             load-balances connections across them
#   hashlib — a sha256 ETag per asset, computed once at startup; conditional GETs
#             answer 304 Not Modified with ~100 bytes instead of the body
#   requests — our own HTTP client smoke-checks the server at startup (the same
#             process serves itself a request before it announces readiness)
#
# The site is loaded into RAM once: a request is a hash lookup + one sendall — no
# stat(), no open(), no disk. Path traversal is structurally impossible: we only
# ever serve exact keys of the in-RAM map, so "../" is not a case to defend, it
# is just a missing key -> 404.
#
#   purrc scripts/serve-docs.purr -o serve-docs.so
#   cheatah serve-docs.so                  # 127.0.0.1:8080 (local preview)
#   cheatah serve-docs.so 80 0.0.0.0       # production: any port/interface
#
# HTTPS with ZERO non-cheatah software: set CHEATAH_DOCS_TLS_CERT + CHEATAH_DOCS_TLS_KEY to an
# Ed25519 leaf cert + its PKCS#8 key (PEM paths) and each connection is wrapped with tls.accept
# — our own from-scratch TLS 1.3 server. Then `cheatah serve-docs.so 443 0.0.0.0`.
#
# Env: CHEATAH_DOCS_LOG=1 logs every request (quiet by default — four workers
# logging every hit costs more than serving it).

import io
import os
import socket
import string
import thread
import memory
import hashlib
import requests
import tls
import sys

# Map a path's extension to a Content-Type.
fn content_type(p) {
    if string.endswith(p, ".html") { return "text/html; charset=utf-8" }
    if string.endswith(p, ".css") { return "text/css; charset=utf-8" }
    if string.endswith(p, ".js") { return "text/javascript; charset=utf-8" }
    if string.endswith(p, ".svg") { return "image/svg+xml" }
    if string.endswith(p, ".png") { return "image/png" }
    if string.endswith(p, ".json") { return "application/json" }
    if string.endswith(p, ".map") { return "application/json" }
    if string.endswith(p, ".woff2") { return "font/woff2" }
    if string.endswith(p, ".ico") { return "image/x-icon" }
    if string.endswith(p, ".txt") { return "text/plain; charset=utf-8" }
    if string.endswith(p, ".xml") { return "application/xml" }
    return "application/octet-stream"
}

# Load every file under root into the site maps: url -> body bytes, url ->
# Content-Type, url -> strong ETag (a sha256 of the bytes, quoted per RFC 9110).
# Iterative walk over an append-only worklist of relative prefixes.
fn load_tree(root, bodies : dict<str, str>, ctypes : dict<str, str>, etags : dict<str, str>) {
    let prefixes = [""]
    let i = 0
    while i < len(prefixes) {
        let prefix = prefixes[i]
        for name in os.listdir(root + prefix) {
            let url = prefix + "/" + name
            let full = root + url
            if os.path.isdir(full) {
                prefixes.append(url)
            } else {
                let body = io.read_file(full)
                bodies[url] = body
                ctypes[url] = content_type(name)
                etags[url] = "\"" + hashlib.sha256(body) + "\""
            }
        }
        i = i + 1
    }
}

# Build a response head. Every response carries the exact Content-Length, a
# Cache-Control that forces revalidation (so browsers ride the 304 path), and
# nosniff so nothing is ever type-guessed.
fn resp_head(status, ctype, clen, etag, keep) {
    let h = "HTTP/1.1 " + status + "\r\n"
    h = h + "Server: cheatah-docs/1.3\r\n"
    h = h + "Content-Type: " + ctype + "\r\n"
    h = h + "Content-Length: " + str(clen) + "\r\n"
    h = h + "Cache-Control: public, max-age=0, must-revalidate\r\n"
    h = h + "X-Content-Type-Options: nosniff\r\n"
    if etag != "" {
        h = h + "ETag: " + etag + "\r\n"
    }
    if keep {
        h = h + "Connection: keep-alive\r\n"
    } else {
        h = h + "Connection: close\r\n"
    }
    return h + "\r\n"
}

# A tiny text/plain response (400/405/431) as complete bytes; these always close the connection.
fn plain_bytes(status, text) {
    let body = status + " " + text
    return resp_head(status, "text/plain; charset=utf-8", len(body), "", false) + body
}

# The reply for one request: the exact bytes to send, whether to keep the connection
# alive afterwards, and whether to close immediately (a hard error / disallowed method).
struct Reply {
    out: str
    keep: bool
    hard_close: bool
}

# Route ONE complete request head into a Reply. The transport-independent core: both the
# plaintext and TLS serve loops build their responses here, so the HTTP semantics (keep-alive
# negotiation, ETag/304, GET/HEAD, 404) live in exactly one place. The site bytes come from a
# shared read lease on the pinned Owner.
fn respond(head_block, is_last, bodies_o : memory.Owner<dict<str, str>>,
           ctypes : dict<str, str>, etags : dict<str, str>, log) -> Reply {
    let line_end = string.find(head_block, "\r\n")
    if line_end < 0 { line_end = len(head_block) }
    let parts = string.split(head_block[:line_end])
    if len(parts) < 3 {
        return Reply({.out = plain_bytes("400 Bad Request", "malformed request line"),
                      .keep = false, .hard_close = true})
    }
    let method = parts[0]
    let target = parts[1]
    let version = parts[2]

    # the two headers we act on (names are case-insensitive)
    let keep = version == "HTTP/1.1"     # 1.1 defaults to keep-alive, 1.0 to close
    let want_etag = ""
    let rest = head_block[line_end + 2:]
    while len(rest) > 0 {
        let eol = string.find(rest, "\r\n")
        if eol < 0 { eol = len(rest) }
        let line = rest[:eol]
        let colon = string.find(line, ":")
        if colon > 0 {
            let name = string.lower(string.strip(line[:colon]))
            let value = string.strip(line[colon + 1:])
            if name == "connection" {
                let v = string.lower(value)
                if string.contains(v, "close") { keep = false }
                if string.contains(v, "keep-alive") { keep = true }
            }
            if name == "if-none-match" { want_etag = value }
        }
        if eol == len(rest) { break }
        rest = rest[eol + 2:]
    }
    if is_last { keep = false }          # last request before we recycle the connection

    # A disallowed method may carry a body we will not parse; close so leftover bytes can never
    # be misread as the next request.
    if method != "GET" and method != "HEAD" {
        return Reply({.out = plain_bytes("405 Method Not Allowed", "GET and HEAD only"),
                      .keep = false, .hard_close = true})
    }
    let q = string.find(target, "?")
    if q >= 0 { target = target[:q] }
    let path = target
    if path == "/" { path = "/index.html" }

    let status = "404"
    let out = ""
    if path in ctypes {
        let etag = etags[path]
        if want_etag == etag {
            out = resp_head("304 Not Modified", ctypes[path], 0, etag, keep)
            status = "304"
        } else {
            if method == "HEAD" {
                with bodies_o.rread().acquire() as r {
                    out = resp_head("200 OK", ctypes[path], len(r.read(path)), etag, keep)
                }
            } else {
                with bodies_o.rread().acquire() as r {
                    out = resp_head("200 OK", ctypes[path], len(r.read(path)), etag, keep) + r.read(path)
                }
            }
            status = "200"
        }
    } else {
        let body = "<h1>404 Not Found</h1>"
        out = resp_head("404 Not Found", "text/html; charset=utf-8", len(body), "", keep) + body
    }
    if log { io.print(status, method, target) }
    return Reply({.out = out, .keep = keep, .hard_close = false})
}

# Serve one PLAINTEXT connection: HTTP/1.1 keep-alive with pipelining (leftover bytes after a
# request head are the start of the next request), hard caps on head size and requests-per-
# connection, and an idle timeout so a slow client cannot pin a worker (the slowloris defense).
fn handle_conn(conn, bodies_o : memory.Owner<dict<str, str>>,
               ctypes : dict<str, str>, etags : dict<str, str>, log) {
    socket.set_timeout(conn, 2000)      # idle / slow-client timeout (slowloris defense)
    let buf = ""
    let served = 0
    while served < 500 {                 # requests per connection before recycling
        let head_end = string.find(buf, "\r\n\r\n")
        while head_end < 0 {
            if len(buf) > 16384 {        # request-head cap
                socket.sendall(conn, plain_bytes("431 Request Header Fields Too Large", "head too large"))
                socket.close(conn)
                return
            }
            let chunk = socket.recv(conn, 8192)
            if chunk == "" {             # idle timeout, EOF, or error: the connection is done
                socket.close(conn)
                return
            }
            buf = buf + chunk
            head_end = string.find(buf, "\r\n\r\n")
        }
        let head_block = buf[:head_end]
        buf = buf[head_end + 4:]         # pipelining: keep whatever follows for the next round
        let reply = respond(head_block, served + 1 == 500, bodies_o, ctypes, etags, log)
        socket.sendall(conn, reply.out)
        if reply.hard_close or not reply.keep {
            socket.close(conn)
            return
        }
        served = served + 1
    }
    socket.close(conn)
}

# Serve one TLS connection: the same HTTP loop as handle_conn, but every read/write goes through
# the encrypting tls.Conn instead of the raw fd. `tc` is borrowed (the worker owns the guard).
fn serve_tls(tc : tls.Conn, bodies_o : memory.Owner<dict<str, str>>,
             ctypes : dict<str, str>, etags : dict<str, str>, log) {
    let buf = ""
    let served = 0
    while served < 500 {
        let head_end = string.find(buf, "\r\n\r\n")
        while head_end < 0 {
            if len(buf) > 16384 {
                tc.send(plain_bytes("431 Request Header Fields Too Large", "head too large"))
                return
            }
            let chunk = tc.recv(8192)
            if chunk == "" {             # close_notify, EOF, timeout, or error
                return
            }
            buf = buf + chunk
            head_end = string.find(buf, "\r\n\r\n")
        }
        let head_block = buf[:head_end]
        buf = buf[head_end + 4:]
        let reply = respond(head_block, served + 1 == 500, bodies_o, ctypes, etags, log)
        tc.send(reply.out)
        if reply.hard_close or not reply.keep {
            return
        }
        served = served + 1
    }
}

# One worker: accept forever on the shared listener. All workers (and the main
# thread) accept on the SAME fd — the kernel hands each connection to one of them.
fn worker(listen_fd : int, bodies_o : memory.Owner<dict<str, str>>,
          ctypes : dict<str, str>, etags : dict<str, str>, log) {
    while true {
        let conn = socket.accept(listen_fd)
        if conn >= 0 {
            handle_conn(conn, bodies_o, ctypes, etags, log)
        }
    }
}

# Spawn n workers, each guard held by a `with` scope on the recursion's way down;
# the innermost frame becomes the calling thread's own accept loop, so the guards
# only join if that loop ever returns (i.e. never, in normal operation). The
# explicit return type makes the self-call legal (a deduced return cannot recurse).
fn spawn_workers(n : int, listen_fd : int, bodies_o : memory.Owner<dict<str, str>>,
                 ctypes : dict<str, str>, etags : dict<str, str>, log) -> int {
    if n <= 0 {
        worker(listen_fd, bodies_o, ctypes, etags, log)
        return 0
    }
    with thread.spawn(worker, listen_fd, bodies_o, ctypes, etags, log) {
        return spawn_workers(n - 1, listen_fd, bodies_o, ctypes, etags, log)
    }
}

# One TLS worker: accept a TCP connection, run the cheatah TLS 1.3 server handshake against it
# (presenting the Ed25519 cert + key), and serve HTTP over the encrypted channel. The tls.Conn
# guard closes the session at scope exit; the TCP fd (not owned by tls) is closed after.
fn tls_worker(listen_fd : int, cert_pem : str, key_pem : str,
              bodies_o : memory.Owner<dict<str, str>>,
              ctypes : dict<str, str>, etags : dict<str, str>, log) {
    while true {
        let conn = socket.accept(listen_fd)
        if conn >= 0 {
            socket.set_timeout(conn, 5000)     # covers the handshake + slow-client reads
            with tls.accept(conn, cert_pem, key_pem) as tc {
                if tc.is_open() {
                    serve_tls(tc, bodies_o, ctypes, etags, log)
                } elif log {
                    io.print("tls handshake failed:", tls.last_error())
                }
            }
            socket.close(conn)
        }
    }
}

# The TLS mirror of spawn_workers.
fn spawn_tls_workers(n : int, listen_fd : int, cert_pem : str, key_pem : str,
                     bodies_o : memory.Owner<dict<str, str>>,
                     ctypes : dict<str, str>, etags : dict<str, str>, log) -> int {
    if n <= 0 {
        tls_worker(listen_fd, cert_pem, key_pem, bodies_o, ctypes, etags, log)
        return 0
    }
    with thread.spawn(tls_worker, listen_fd, cert_pem, key_pem, bodies_o, ctypes, etags, log) {
        return spawn_tls_workers(n - 1, listen_fd, cert_pem, key_pem, bodies_o, ctypes, etags, log)
    }
}

fn main() {
    let port = 8080
    let host = "127.0.0.1"
    if len(sys.argv) > 1 {
        port = requests.parse_uint(sys.argv[1])
        if port <= 0 or port > 65535 {
            io.print("usage: cheatah serve-docs.so [port] [host]   (bad port: " + sys.argv[1] + ")")
            return
        }
    }
    if len(sys.argv) > 2 { host = sys.argv[2] }
    let log = os.getenv("CHEATAH_DOCS_LOG") == "1"

    # ---- load the whole site into RAM, once ---------------------------------
    let bodies: dict<str, str> = {}
    let ctypes: dict<str, str> = {}
    let etags: dict<str, str> = {}
    let root = "docs/html"
    load_tree(root, bodies, ctypes, etags)
    let pages = len(ctypes)
    let total = 0
    for kv in bodies { total = total + len(kv.second) }
    if pages == 0 {
        io.print("nothing to serve: " + root + " is empty — run docs/build-docs.sh first")
        return
    }
    let bodies_o = memory.own(bodies)    # the site's single shared home

    let listen_fd = socket.tcp_listen(host, port, 128)
    if listen_fd < 0 {
        io.print("could not bind " + host + ":" + str(port) + " - " + socket.last_error())
        return
    }

    # ---- workers ------------------------------------------------------------
    # Blocking-serve model: one worker owns one connection at a time, so the pool
    # size bounds how many clients are served SIMULTANEOUSLY (waiters queue in the
    # listen backlog). 2x cores is a good default for network-bound work; override
    # with CHEATAH_DOCS_WORKERS. ctypes/etags are small and COPIED into each
    # worker (thread.spawn copies plain values); the site bodies are SHARED
    # through the one pinned Owner.
    let nworkers = os.cpu_count() * 2
    let env_workers = os.getenv("CHEATAH_DOCS_WORKERS")
    if env_workers != "" {
        let w = requests.parse_uint(env_workers)
        if w > 0 and w <= 256 { nworkers = w }
    }

    # ---- HTTPS when a cert + key are provided (pure-cheatah TLS 1.3) ---------
    let cert_path = os.getenv("CHEATAH_DOCS_TLS_CERT")
    let key_path = os.getenv("CHEATAH_DOCS_TLS_KEY")
    if cert_path != "" and key_path != "" {
        let cert_pem = io.read_file(cert_path)
        let key_pem = io.read_file(key_path)
        if cert_pem == "" or key_pem == "" {
            io.print("could not read TLS cert/key (" + cert_path + ", " + key_path + ")")
            return
        }
        # self-check: our own requests client speaks HTTPS to our own TLS server (localhost, both
        # ends ours — skip cert validation; production clients validate the real cert).
        with thread.spawn(tls_worker, listen_fd, cert_pem, key_pem, bodies_o, ctypes, etags, log) {
            let opt = requests.Options({.timeout_ms = 5000, .insecure = true})
            let check = requests.get("https://127.0.0.1:" + str(port) + "/index.html", opt)
            if not check.ok() {
                io.print("TLS self-check FAILED: " + check.error + " " + str(check.status_code))
            } else {
                io.print("🐆 cheatah docs (HTTPS): " + str(pages) + " assets, " + str(total) + " bytes in RAM, " + str(nworkers) + " workers")
                io.print("🐆 self-check OK (" + str(len(check.body)) + " bytes) — serving at https://" + host + ":" + str(port) + "/")
            }
            spawn_tls_workers(nworkers - 2, listen_fd, cert_pem, key_pem, bodies_o, ctypes, etags, log)
        }
        return
    }

    # ---- self-check: our own requests client, against our own server --------
    with thread.spawn(worker, listen_fd, bodies_o, ctypes, etags, log) {
        let check = requests.get("http://127.0.0.1:" + str(port) + "/index.html")
        if not check.ok() {
            io.print("self-check FAILED: " + check.error + " " + str(check.status_code))
        } else {
            io.print("🐆 cheatah docs: " + str(pages) + " assets, " + str(total) + " bytes in RAM, " + str(nworkers) + " workers")
            io.print("🐆 self-check OK (" + str(len(check.body)) + " bytes) — serving at http://" + host + ":" + str(port) + "/")
        }
        spawn_workers(nworkers - 2, listen_fd, bodies_o, ctypes, etags, log)   # this thread is the last worker
    }
}

main()
