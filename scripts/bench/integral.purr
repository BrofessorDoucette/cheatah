import io
import time
import math
let a = 0.0
let b = 50.0
let n = 20000000
let h = (b - a) / n
let s = 0.5 * (math.sin(a) * math.exp(-0.01 * a) + math.sin(b) * math.exp(-0.01 * b))
let t0 = time.monotonic()
for i in range(1, n) {
    let x = a + h * i
    s = s + math.sin(x) * math.exp(-0.01 * x)
}
let t1 = time.monotonic()
io.print(s * h)
io.print(t1 - t0)
