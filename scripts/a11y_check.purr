# Original work; see ACKNOWLEDGMENTS.md for the open-source ideas we build upon.
# a11y_check.purr — the static half of the docs accessibility gate, in PURE CHEATAH.
#
# Two jobs, neither of which needs a browser:
#   1. WCAG 1.4.3 contrast. Parse the colour tokens straight out of the stylesheet and
#      compute the real relative-luminance ratio for every (foreground, ground) pair the
#      theme actually draws. #8a8170 on #24201a measured 4.21:1 and shipped for months —
#      a number nobody had computed. Both palettes (dark, and the prefers-color-scheme
#      light one) are checked.
#   2. Per-page structure over the generated tree: skip link, exactly one <h1>, a lang
#      attribute, no labelled-but-empty landmark, no <script> (the serving CSP has no
#      script-src, so a script tag is dead weight AND a broken promise), alt on every img.
#
# The literal-** check deliberately ignores anything inside <code>/<pre>/.srcview: `2 ** 10`
# and `char **argv` are real source, and an earlier blanket sweep would have corrupted them.
#
# Run from the repo root (see scripts/docs_a11y_gate.sh, which also runs the reflow half):
#     purrc scripts/a11y_check.purr -o /tmp/a11y_check.so && cheatah /tmp/a11y_check.so
import io
import os
import string
import math

# ---- colour ----------------------------------------------------------------------------

struct Rgb {
    r: int
    g: int
    b: int
}

# One (foreground token, background token, minimum ratio) obligation.
struct Pair {
    fg: str
    bg: str
    minimum: float
    why: str
}

fn hex_nibble(c: str) -> int {
    if c >= "0" and c <= "9" { return ord(c) - ord("0") }
    if c >= "a" and c <= "f" { return ord(c) - ord("a") + 10 }
    if c >= "A" and c <= "F" { return ord(c) - ord("A") + 10 }
    return -1
}

# "#24201a" -> Rgb. Returns r = -1 when the value is not a plain 6-digit hex colour
# (rgba(), color-mix(), a var() reference — those are checked by eye, not here).
fn parse_hex(s: str) -> Rgb {
    let t = string.strip(s)
    if len(t) != 7 or t[0] != "#" { return Rgb({.r = -1, .g = 0, .b = 0}) }
    let v = [0, 0, 0]
    let i = 0
    while i < 3 {
        let hi = hex_nibble(t[1 + i * 2])
        let lo = hex_nibble(t[2 + i * 2])
        if hi < 0 or lo < 0 { return Rgb({.r = -1, .g = 0, .b = 0}) }
        v[i] = hi * 16 + lo
        i = i + 1
    }
    return Rgb({.r = v[0], .g = v[1], .b = v[2]})
}

# WCAG 2.1 relative luminance: sRGB channel -> linear, then the Rec.709 weighting.
fn channel(c: int) -> float {
    let x = float(c) / 255.0
    if x <= 0.03928 { return x / 12.92 }
    return math.pow((x + 0.055) / 1.055, 2.4)
}

fn luminance(c: Rgb) -> float {
    return 0.2126 * channel(c.r) + 0.7152 * channel(c.g) + 0.0722 * channel(c.b)
}

fn contrast(a: Rgb, b: Rgb) -> float {
    let la = luminance(a)
    let lb = luminance(b)
    if la > lb { return (la + 0.05) / (lb + 0.05) }
    return (lb + 0.05) / (la + 0.05)
}

# Pull `--name: #rrggbb;` declarations out of one CSS block. `start` is the byte offset of
# the block's opening brace; scanning stops at the matching close, so the dark :root block
# and the light prefers-color-scheme block yield separate palettes.
fn tokens_in_block(css: str, start: int) {   # return type inferred: purrc has no dict annotation
    let out: dict<str, str> = {}
    let depth = 0
    let i = start
    while i < len(css) {
        let ch = css[i]
        if ch == "{" { depth = depth + 1 }
        if ch == "}" {
            depth = depth - 1
            if depth <= 0 { return out }
        }
        if ch == "-" and i + 1 < len(css) and css[i + 1] == "-" {
            let colon = string.find(css, ":", i)
            let semi = string.find(css, ";", i)
            if colon > 0 and semi > colon {
                let name = string.strip(css[i:colon])
                let val = string.strip(css[colon + 1:semi])
                if string.find(val, "#", 0) == 0 { out[name] = val }
                i = semi
            }
        }
        i = i + 1
    }
    return out
}

# Deliberately NOT a `-> dict` helper: the palette stays a local of check_palette, which
# returns a plain count. Keeps every dict inside one frame.

# The pairs the theme actually paints. --surface is the lightest ground --fg-faint is ever
# drawn on, so it is the binding case; checking it against --bg alone would pass a colour
# that fails on a card.
#
# A sibling repo with a different palette (the storefront's --ink/--muted/--panel) reuses
# this whole tool by setting A11Y_PAIRS instead of copying it:
#     A11Y_PAIRS="--ink|--bg|4.5|body text;--muted|--panel|4.5|captions"
fn parse_pairs(spec: str) -> list<Pair> {
    let out: list<Pair> = []
    for entry in string.split(spec, ";") {
        let e = string.strip(entry)
        if e == "" { continue }
        let f = string.split(e, "|")
        if len(f) < 3 { continue }
        let why = ""
        if len(f) > 3 { why = f[3] }
        out.append(Pair({.fg = string.strip(f[0]), .bg = string.strip(f[1]),
                         .minimum = float(string.strip(f[2])), .why = why}))
    }
    return out
}

fn obligations() -> list<Pair> {
    let spec = os.getenv("A11Y_PAIRS")
    if spec != "" { return parse_pairs(spec) }
    return [
        Pair({.fg = "--fg", .bg = "--bg", .minimum = 4.5, .why = "body text"}),
        Pair({.fg = "--fg", .bg = "--surface", .minimum = 4.5, .why = "text on cards"}),
        Pair({.fg = "--fg-dim", .bg = "--bg", .minimum = 4.5, .why = "sidebar + TOC links"}),
        Pair({.fg = "--fg-dim", .bg = "--surface", .minimum = 4.5, .why = "dim text on cards"}),
        Pair({.fg = "--fg-faint", .bg = "--bg", .minimum = 4.5, .why = "faint prose"}),
        Pair({.fg = "--fg-faint", .bg = "--surface", .minimum = 4.5, .why = "faint text on cards"}),
        Pair({.fg = "--accent", .bg = "--bg", .minimum = 4.5, .why = "links"}),
        Pair({.fg = "--accent", .bg = "--surface", .minimum = 4.5, .why = "links on cards"}),
        Pair({.fg = "--code-fg", .bg = "--code-bg", .minimum = 4.5, .why = "code"})
    ]
}

fn check_palette(css: str, anchor: str, name: str) -> int {
    let at = string.find(css, anchor, 0)
    let brace = -1
    if at >= 0 { brace = string.find(css, "{", at) }
    if brace < 0 {
        io.print("  a11y: FAIL - palette '" + name + "' not found in the stylesheet")
        return 1
    }
    let pal = tokens_in_block(css, brace)
    if len(pal) == 0 {
        io.print("  a11y: FAIL - palette '" + name + "' defines no colour tokens")
        return 1
    }
    let bad = 0
    for p in obligations() {
        if not (p.fg in pal) or not (p.bg in pal) { continue }
        let fg = parse_hex(pal[p.fg])
        let bg = parse_hex(pal[p.bg])
        if fg.r < 0 or bg.r < 0 { continue }
        let ratio = contrast(fg, bg)
        if ratio < p.minimum {
            io.print("  a11y: FAIL [" + name + "] " + p.fg + " on " + p.bg +
                     " = " + io.format("{:.2f}", ratio) + ":1, need " +
                     io.format("{:.1f}", p.minimum) + ":1 (" + p.why + ")")
            bad = bad + 1
        }
    }
    return bad
}

# ---- page structure --------------------------------------------------------------------

fn count_of(hay: str, needle: str) -> int {
    let n = 0
    let i = string.find(hay, needle, 0)
    while i >= 0 {
        n = n + 1
        i = string.find(hay, needle, i + len(needle))
    }
    return n
}

# Blank out <code>…</code>, <pre>…</pre> and the source-listing blocks so a check for
# literal markdown never trips over real source text that legitimately contains them.
fn strip_code(html: str) -> str {
    let out = html
    for tag in ["code", "pre"] {
        let open = "<" + tag
        let close = "</" + tag + ">"
        let res = ""
        let i = 0
        while i < len(out) {
            let a = string.find(out, open, i)
            if a < 0 {
                res = res + out[i:]
                break
            }
            let b = string.find(out, close, a)
            if b < 0 {
                res = res + out[i:]
                break
            }
            res = res + out[i:a]
            i = b + len(close)
        }
        out = res
    }
    return out
}

# The stylesheet's own structural invariants. These are the layout regressions that reached
# readers once already: a table taken out of table layout, and controls hidden from the
# keyboard. Contrast is checked by check_palette; this is everything else the CSS must hold.
fn check_stylesheet(css: str, want_anchors: bool) -> int {
    let bad = 0

    # A <table> cannot be its own scroll container. `display:block` takes it OUT of table
    # layout — the rows collapse into an anonymous shrink-to-fit box, so width:100% sizes
    # only the frame while the cells hug the left. The .tscroll wrapper scrolls instead.
    let d = string.find(css, ".dtable, table.dtable {", 0)
    if d < 0 {
        io.print("  a11y: FAIL stylesheet has no '.dtable, table.dtable' rule")
        bad = bad + 1
    } elif string.contains(css[d:string.find(css, "}", d)], "display: block") {
        io.print("  a11y: FAIL .dtable declares display:block - that leaves table layout and the cells stop filling the frame; scroll the .tscroll wrapper instead")
        bad = bad + 1
    }
    if string.find(css, ".tscroll {", 0) < 0 {
        io.print("  a11y: FAIL stylesheet has no '.tscroll' rule - a wide table would widen the document (WCAG 1.4.10)")
        bad = bad + 1
    }

    # `opacity` applies to an element's WHOLE rendering, its focus outline included, so a
    # control revealed only on :hover is invisible to a keyboard user even while focused
    # (WCAG 2.4.7 - hover is not a mode of operation a keyboard has). Every opacity:0
    # control needs a :focus-within/:focus-visible companion. The count is PINNED so a third
    # hidden control cannot be introduced without coming back here to give it one.
    #
    # PERMALINK ANCHORS ARE A REFERENCE-DOC CONCEPT. .member and .overload are Doxygen's
    # per-member rows; a marketing site has no per-member headings and no permalinks, so
    # demanding these selectors of it would mean writing dead CSS whose only purpose is to
    # satisfy a counter - and the pin is bidirectional, so it would also forbid that site ever
    # having a third opacity:0 for an unrelated reason. A tree with no permalinks sets
    # A11Y_ANCHORS=0, exactly as one with no light palette sets A11Y_LIGHT=0. The docs pass
    # leaves it on, so the pin still guards the tree it was written for.
    if want_anchors {
        let hidden = count_of(css, "opacity: 0;")
        if hidden != 2 {
            io.print("  a11y: FAIL " + str(hidden) + " 'opacity: 0' declarations, expected 2 (.anchor, .overload .anchor) - a newly hidden control needs a :focus companion (WCAG 2.4.7)")
            bad = bad + 1
        }
        for sel in [".member:focus-within .anchor", ".overload:focus-within .anchor", ".anchor:focus-visible"] {
            if string.find(css, sel, 0) < 0 {
                io.print("  a11y: FAIL stylesheet has no '" + sel + "' rule - a focused permalink would be invisible (WCAG 2.4.7)")
                bad = bad + 1
            }
        }
    }

    # The sticky topbar covers whatever scrolls to the very top of the viewport. scroll-margin
    # is what keeps a focused or :target element clear of it - WCAG 2.4.11 Focus Not Obscured
    # (Minimum), new at AA in WCAG 2.2. On every id, not just .member: headings, overload rows
    # and source lines are all fragment targets.
    if string.find(css, "[id] { scroll-margin-top:", 0) < 0 {
        io.print("  a11y: FAIL stylesheet has no '[id] { scroll-margin-top: … }' rule - a focused element can land entirely under the sticky topbar (WCAG 2.4.11)")
        bad = bad + 1
    }

    # A FIXED height on the bar clips the brand under the text-spacing overrides WCAG 1.4.12
    # requires the page to survive. min-height lets it grow instead. The height is a token
    # because four rules must agree on it (the bar, the two sticky offsets, the scroll-margin).
    for sel in [".topbar {", ".topbar-inner {"] {
        let s = string.find(css, sel, 0)
        let e = string.find(css, "}", s)
        if s < 0 or not string.contains(css[s:e], "min-height: var(--topbar-h)") {
            io.print("  a11y: FAIL '" + sel + "' does not set min-height: var(--topbar-h) - a fixed height clips the brand under the WCAG 1.4.12 text-spacing overrides")
            bad = bad + 1
        }
    }

    return bad
}

# ---- dead-class census -------------------------------------------------------------------
# A rule that targets a class no page carries is invisible: it neither errors nor renders, it
# just silently stops applying. The storefront's whole nav was styled by six rules scoped to
# `header.site` after the element had been renamed to `.topbar`; the brand, the flex row, the
# link colour, hover and aria-current all died at once and nothing complained. This is the
# check that would have caught it in the same commit.

fn is_class_char(c: str) -> bool {
    if c >= "a" and c <= "z" { return true }
    if c >= "A" and c <= "Z" { return true }
    if c >= "0" and c <= "9" { return true }
    return c == "-" or c == "_"
}

# Each collector fills a (seen, names) PAIR: the dict answers membership, the list gives a
# stable iteration order. A dict alone would not do — purr iterates a dict as key/value pairs
# and has no .keys(), and both comparison directions need to walk one set while testing the
# other.
fn note_class(name: str, seen, names: list<str>) {
    if name == "" { return }
    if name in seen { return }
    seen[name] = true
    names.append(name)
}

# Pull `.name` tokens out of one selector fragment.
fn classes_in_selector(sel: str, seen, names: list<str>) {
    let i = 0
    while i < len(sel) {
        if sel[i] == "." and i + 1 < len(sel) and is_class_char(sel[i + 1]) {
            let j = i + 1
            while j < len(sel) and is_class_char(sel[j]) { j = j + 1 }
            note_class(sel[i + 1:j], seen, names)
            i = j
            continue
        }
        i = i + 1
    }
}

# Every class the stylesheet TARGETS. Selector text is whatever precedes a '{' since the last
# brace, which handles nested at-rules without a parser: an `@media (...)` prelude carries no
# class, and the rules inside it are read exactly like top-level ones. Comments are blanked
# first so a class merely NAMED in prose is not counted as styled — this file's own comments
# mention .topbar and .anchor.
fn css_classes_into(css: str, seen, names: list<str>) {
    let src = ""
    let k = 0
    while k < len(css) {
        let a = string.find(css, "/*", k)
        if a < 0 { src = src + css[k:]; break }
        let b = string.find(css, "*/", a)
        if b < 0 { src = src + css[k:a]; break }
        src = src + css[k:a]
        k = b + 2
    }
    let i = 0
    let start = 0
    while i < len(src) {
        let c = src[i]
        if c == "{" {
            classes_in_selector(src[start:i], seen, names)
            start = i + 1
        } elif c == "}" {
            start = i + 1
        }
        i = i + 1
    }
}

# Every class an HTML page USES, accumulated across a tree.
fn html_classes_into(html: str, seen, names: list<str>) {
    let i = string.find(html, "class=\"", 0)
    while i >= 0 {
        let e = string.find(html, "\"", i + 7)
        if e < 0 { return }
        for c in string.split(html[i + 7:e], " ") {
            note_class(string.strip(c), seen, names)
        }
        i = string.find(html, "class=\"", e)
    }
}

fn check_page(path: str, html: str) -> int {
    let bad = 0
    let prose = strip_code(html)

    if string.find(html, "<html lang=", 0) < 0 {
        io.print("  a11y: FAIL " + path + " - <html> has no lang attribute (WCAG 3.1.1)")
        bad = bad + 1
    }
    if string.find(html, "class=\"skip\"", 0) < 0 {
        io.print("  a11y: FAIL " + path + " - no skip-to-content link (WCAG 2.4.1)")
        bad = bad + 1
    }
    let h1s = count_of(html, "<h1")
    if h1s != 1 {
        io.print("  a11y: FAIL " + path + " - " + str(h1s) + " <h1> elements, expected 1 (WCAG 1.3.1)")
        bad = bad + 1
    }
    # The zero-JS invariant. The serving CSP is `default-src 'none'; style-src 'self';
    # img-src 'self'` — there is no script-src, so a <script> tag can only ever be dead.
    if string.find(html, "<script", 0) >= 0 {
        io.print("  a11y: FAIL " + path + " - ships a <script> tag; the serving CSP has no script-src")
        bad = bad + 1
    }
    # A labelled landmark with nothing in it is announced and leads nowhere.
    if string.find(html, "aria-label=\"On this page\"></aside>", 0) >= 0 {
        io.print("  a11y: FAIL " + path + " - empty labelled 'On this page' landmark (WCAG 1.3.1)")
        bad = bad + 1
    }
    if string.find(html, "<img", 0) >= 0 and count_of(html, "<img") != count_of(html, "alt=") {
        io.print("  a11y: FAIL " + path + " - an <img> is missing alt (WCAG 1.1.1)")
        bad = bad + 1
    }
    # Every table is wrapped in its own scroll container. A <table> cannot be its own
    # scroller, so the wrapper is what keeps a wide table from widening the page
    # (WCAG 1.4.10); tabindex makes that scroller keyboard-operable (WCAG 2.1.1) - a scroll
    # region containing no focusable element is unreachable by keyboard in Safari.
    let tables = count_of(html, "<table class=\"dtable\"")
    let wrapped = count_of(html, "<div class=\"tscroll\" tabindex=\"0\"><table class=\"dtable\"")
    if wrapped != tables {
        io.print("  a11y: FAIL " + path + " - " + str(tables - wrapped) + " of " + str(tables) + " table(s) not wrapped in '<div class=\"tscroll\" tabindex=\"0\">' (WCAG 1.4.10 / 2.1.1)")
        bad = bad + 1
    }
    # Header cells must say which way they head, or the header/data relationship is not
    # programmatically determinable (WCAG 1.3.1, technique H63). <thead> is discounted: it
    # shares the prefix but is not a header cell.
    let ths = count_of(html, "<th") - count_of(html, "<thead")
    if ths != count_of(html, "<th scope=") {
        io.print("  a11y: FAIL " + path + " - a <th> is missing scope= (WCAG 1.3.1)")
        bad = bad + 1
    }
    # Literal markdown emphasis that Doxygen failed to convert, in PROSE only.
    if string.find(prose, "**", 0) >= 0 {
        io.print("  a11y: FAIL " + path + " - literal '**' in prose (unconverted markdown bold)")
        bad = bad + 1
    }
    return bad
}

fn main() {
    let root = os.getenv("DOCS_HTML")
    if root == "" { root = "docs/html" }
    let css_path = os.getenv("A11Y_CSS")
    if css_path == "" { css_path = "docs/gen/assets/cheatah-docs.css" }
    # A repo with no light palette (the storefront ships one theme) sets A11Y_LIGHT=0
    # rather than failing a check for a block it never intended to have.
    let want_light = os.getenv("A11Y_LIGHT") != "0"
    # A tree with no permalink anchors (a marketing site has no per-member headings) sets
    # A11Y_ANCHORS=0 - the same shape, for the same reason.
    let want_anchors = os.getenv("A11Y_ANCHORS") != "0"
    # Comma-separated path fragments to skip. The storefront's site/docs/cheatah-docs is a
    # dev SYMLINK to cheatah's generated tree — walking it would check those pages twice,
    # against the wrong stylesheet, and hide the storefront's own page count.
    let excludes = string.split(os.getenv("A11Y_EXCLUDE"), ",")
    # A11Y_DEADCLASS=0 turns off the dead-class census — same shape as A11Y_LIGHT/A11Y_ANCHORS.
    let want_deadclass = os.getenv("A11Y_DEADCLASS") != "0"
    # Colon-separated EXTRA page roots that share this stylesheet. The census must span every
    # tree the stylesheet serves or it invents findings: the storefront checks site/ and docs/
    # in separate passes against ONE styles.css, so a class used only in site/products/ would
    # look dead during the docs/ pass. These roots contribute classes only — their page
    # structure is checked by their own pass.
    let also_trees = string.split(os.getenv("A11Y_ALSO_TREES"), ":")

    io.print("[a11y] contrast (WCAG 1.4.3) over " + css_path)
    let css = io.read_file(css_path)
    let bad = check_palette(css, ":root {", "dark")
    if want_light { bad = bad + check_palette(css, "prefers-color-scheme: light", "light") }
    bad = bad + check_stylesheet(css, want_anchors)

    # Walk subdirectories too: the extension subsites (cheatah-gpu/, cheatah-plot/, …) are
    # real pages readers land on, and a top-level-only scan quietly skipped every one.
    io.print("[a11y] page structure over " + root)
    let used: dict<str, bool> = {}
    let used_names: list<str> = []
    let pages = 0
    let queue = [""]
    let qi = 0
    while qi < len(queue) {
        let rel = queue[qi]
        qi = qi + 1
        let dir = root
        if rel != "" { dir = root + "/" + rel }
        for name in os.listdir(dir) {
            let child = name
            if rel != "" { child = rel + "/" + name }
            let skip = false
            for ex in excludes {
                let e = string.strip(ex)
                if e != "" and string.contains(child, e) { skip = true }
            }
            if skip { continue }
            if os.path.isdir(dir + "/" + name) {
                queue.append(child)
                continue
            }
            if not string.endswith(name, ".html") { continue }
            pages = pages + 1
            let page_html = io.read_file(dir + "/" + name)
            html_classes_into(page_html, used, used_names)
            bad = bad + check_page(child, page_html)
        }
    }

    # The extra roots: classes only, no structure checks and no page count.
    for extra in also_trees {
        let xr = string.strip(extra)
        if xr == "" { continue }
        let xq = [""]
        let xi = 0
        while xi < len(xq) {
            let xrel = xq[xi]
            xi = xi + 1
            let xdir = xr
            if xrel != "" { xdir = xr + "/" + xrel }
            for xname in os.listdir(xdir) {
                let xchild = xname
                if xrel != "" { xchild = xrel + "/" + xname }
                let xskip = false
                for ex in excludes {
                    let e = string.strip(ex)
                    if e != "" and string.contains(xchild, e) { xskip = true }
                }
                if xskip { continue }
                if os.path.isdir(xdir + "/" + xname) {
                    xq.append(xchild)
                    continue
                }
                if not string.endswith(xname, ".html") { continue }
                html_classes_into(io.read_file(xdir + "/" + xname), used, used_names)
            }
        }
    }

    if want_deadclass {
        let styled: dict<str, bool> = {}
        let styled_names: list<str> = []
        css_classes_into(css, styled, styled_names)
        let dead = 0
        for name in styled_names {
            if not (name in used) {
                io.print("  a11y: FAIL stylesheet styles '." + name + "' but no page uses it - a renamed element leaves rules that silently stop applying")
                dead = dead + 1
            }
        }
        # The other direction is INFORMATIONAL, deliberately. A class with no rule usually
        # inherits something sensible on purpose — .badge-type and .badge-enum fall back to
        # .badge, and several are semantic hooks Doxygen emits that we never chose to paint.
        # A dead RULE is the real defect: it is styling that silently stopped applying, which
        # is exactly how the storefront's whole nav went unstyled. Failing on both directions
        # would bury that signal under a standing backlog nobody can act on.
        let unstyled = 0
        let unstyled_list = ""
        for name in used_names {
            if not (name in styled) {
                unstyled = unstyled + 1
                unstyled_list = unstyled_list + " ." + name
            }
        }
        if unstyled > 0 {
            io.print("  a11y: note - " + str(unstyled) + " class(es) used with no rule (inheriting):" + unstyled_list)
        }
        bad = bad + dead
    }

    if bad > 0 {
        # An uncaught raise is how a .purr tool fails its caller: the runtime exits non-zero.
        raise "a11y: " + str(bad) + " problem(s) across " + str(pages) + " pages"
    }
    io.print("[a11y] OK - " + str(pages) + " pages checked")
}

main()
