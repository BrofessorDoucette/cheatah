#!/usr/bin/env bash
# Git pre-push hook — runs the QA gate before EVERY push to ANY remote/branch.
# A non-zero exit aborts the push. Enabled via `git config core.hooksPath .githooks`
# (run scripts/setup_hooks.sh once). Bypass (discouraged): `git push --no-verify`
# or `QA_GATE_SKIP=1 git push`.
#
# After a PASSING gate, and ONLY when pushing `main`, it regenerates the docs site
# (Doxygen XML -> docs/gen generator -> docs/html). When a version TAG (refs/tags/v*) is
# pushed — i.e. a release actually goes to GitHub — it archives that version's review
# bundle. Never on a failing gate, never on a manual `scripts/qa_gate.sh` run.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# pre-push receives "<local_ref> <local_sha> <remote_ref> <remote_sha>" lines on
# stdin; note whether main, and/or a version tag (refs/tags/v*), is being pushed.
pushing_main=0
pushed_tag=""
push_ranges=()
while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] && pushing_main=1
    case "$remote_ref" in
        refs/tags/v*) pushed_tag="${remote_ref#refs/tags/}" ;;
    esac
    # Range of commits this push would publish (all-zero remote sha = new ref).
    if [ -n "${local_sha:-}" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        case "$remote_sha" in
            ""|0000000000000000000000000000000000000000) push_ranges+=("$local_sha") ;;
            *) push_ranges+=("$remote_sha..$local_sha") ;;
        esac
    fi
done

# 0. Private-reference scan on the commit MESSAGES about to be published. Once a
#    message is on the remote it cannot be fixed without rewriting history (which
#    would invalidate every release tag), so this is the last chance to catch one.
for _range in ${push_ranges+"${push_ranges[@]}"}; do
    bash "$repo_root/scripts/check_no_private_refs.sh" --range "$_range" || exit 1
done

# 1. QA gate — blocks the push on failure.
bash "$repo_root/scripts/qa_gate.sh" || exit 1

# 2. Gate passed. Refresh the docs site only for a real main push (not when the
#    gate was bypassed with QA_GATE_SKIP).
if [ "$pushing_main" = "1" ] && [ "${QA_GATE_SKIP:-0}" != "1" ]; then
    printf '\n\033[1m[pre-push] gate passed + pushing main — regenerating docs site…\033[0m\n'
    bash "$repo_root/docs/build-docs.sh" || { echo "[pre-push] docs regeneration FAILED"; exit 1; }
    if ! git -C "$repo_root" diff --quiet -- docs/html; then
        printf '[pre-push] docs/html was refreshed — commit the update to publish it.\n'
    fi
fi

# 3. Pushing a version tag = the release actually goes to GitHub: archive its review
#    bundle into archive/<name>.tar.gz (the gate already staged review/ on the release
#    commit). Non-fatal — a hiccup here must not abort a release push.
if [ -n "$pushed_tag" ] && [ "${QA_GATE_SKIP:-0}" != "1" ]; then
    printf '\n\033[1m[pre-push] pushing release tag %s — archiving its review bundle…\033[0m\n' "$pushed_tag"
    bash "$repo_root/scripts/archive_release.sh" --pushing "$pushed_tag" \
        || echo "[pre-push] archive step skipped/failed (non-fatal)."
fi
exit 0
