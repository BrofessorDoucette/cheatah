// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "linalg.hpp"
#include "ndarray.hpp"

namespace cheatah_program {

namespace io = ::cheatah::io;
namespace linalg = ::cheatah::linalg;
namespace ndarray = ::cheatah::ndarray;

void purr_main() {
    auto A = ndarray::array(std::vector{
        std::vector{4.0, 1.0, 0.0, 1.0},
        std::vector{1.0, 5.0, 1.0, 0.0},
        std::vector{0.0, 1.0, 6.0, 1.0},
        std::vector{1.0, 0.0, 1.0, 7.0}
    });
    auto b = ndarray::array(std::vector{1.0, 2.0, 3.0, 4.0});
    io::print(ndarray::to_string(linalg::solve(A, b)));
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

