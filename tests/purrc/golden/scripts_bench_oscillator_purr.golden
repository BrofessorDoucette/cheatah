// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "time.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace time = ::cheatah::time;

namespace {

static auto fx(builtins::Value auto&& x, builtins::Value auto&& v) {
    return v;
}


static auto fv(builtins::Value auto&& x, builtins::Value auto&& v) {
    return (-x);
}


}  // namespace

void purr_main() {
    auto x = 1.0;
    auto v = 0.0;
    auto dt = 0.0005;
    auto n = 4000000LL;
    auto t0 = time::monotonic();
    for (long long i = 0LL; i < n; ++i) {
        auto k1x = fx(x, v);
        auto k1v = fv(x, v);
        auto k2x = fx((x + ((0.5 * dt) * k1x)), (v + ((0.5 * dt) * k1v)));
        auto k2v = fv((x + ((0.5 * dt) * k1x)), (v + ((0.5 * dt) * k1v)));
        auto k3x = fx((x + ((0.5 * dt) * k2x)), (v + ((0.5 * dt) * k2v)));
        auto k3v = fv((x + ((0.5 * dt) * k2x)), (v + ((0.5 * dt) * k2v)));
        auto k4x = fx((x + (dt * k3x)), (v + (dt * k3v)));
        auto k4v = fv((x + (dt * k3x)), (v + (dt * k3v)));
        x += builtins::truediv((dt * (((k1x + (2.0 * k2x)) + (2.0 * k3x)) + k4x)), 6.0);
        v += builtins::truediv((dt * (((k1v + (2.0 * k2v)) + (2.0 * k3v)) + k4v)), 6.0);
    }
    auto t1 = time::monotonic();
    io::print((0.5 * ((x * x) + (v * v))));
    io::print((t1 - t0));
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

