// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "ndarray.hpp"
#include "random.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace ndarray = ::cheatah::ndarray;
namespace random = ::cheatah::random;

static auto solve_system() {
    auto A = ndarray::array(std::vector{
        std::vector{random::uniform(0.0, 1.0), random::uniform(0.0, 1.0)},
        std::vector{random::uniform(0.0, 1.0), random::uniform(0.0, 1.0)}
    });
    return A;
}


void purr_main() {
    random::seed(1LL);
    for (long long k = 0; k < 10LL; ++k) {
        solve_system();
    }
    io::print("ok");
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

