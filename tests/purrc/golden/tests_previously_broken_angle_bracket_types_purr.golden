// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "ndarray.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace ndarray = ::cheatah::ndarray;

struct Mixed {
    long long n{};
    double x{};
    std::string name;
    bool flag{};
    std::vector<long long> xs;
    std::vector<std::vector<long long>> grid;
    std::unordered_map<std::string, long long> counts;
    std::array<double, 4> fixed;
    ::cheatah::ndarray::basic_ndarray<double> w;
    ::cheatah::ndarray::basic_ndarray<long long> mask;
    ::cheatah::ndarray::NDArray raw;
};

static auto main() {
    std::vector<long long> a = std::vector{1LL, 2LL, 3LL};
    std::unordered_map<std::string, long long> d = std::unordered_map{std::pair{std::string("k"), 7LL}};
    auto v = Mixed{
        .n = 5LL,
        .x = 2.5,
        .name = static_cast<std::string>(std::string("hi")),
        .flag = static_cast<bool>(true),
        .w = static_cast<::cheatah::ndarray::basic_ndarray<double>>(ndarray::zeros(std::vector{2LL, 3LL})),
        .mask = static_cast<::cheatah::ndarray::basic_ndarray<long long>>(ndarray::array(std::vector{1LL, 0LL})),
        .raw = static_cast<::cheatah::ndarray::NDArray>(ndarray::zeros(std::vector{4LL}))
    };
    io::print((std::string("n=") + builtins::str(v.n)));
    io::print((std::string("name=") + builtins::str(v.name)));
    io::print((std::string("wsize=") + builtins::str(ndarray::size_of(v.w))));
    io::print((std::string("masksize=") + builtins::str(ndarray::size_of(v.mask))));
    io::print((std::string("a0=") + builtins::str(builtins::index(a, 0LL))));
    io::print((std::string("dk=") + builtins::str(builtins::index(d, std::string("k")))));
}


void purr_main() {
    main();
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

