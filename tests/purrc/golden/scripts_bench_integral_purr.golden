// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "math.hpp"
#include "time.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace math = ::cheatah::math;
namespace time = ::cheatah::time;

void purr_main() {
    auto a = 0.0;
    auto b = 50.0;
    auto n = 20000000LL;
    auto h = builtins::truediv((b - a), n);
    auto s = (0.5 * ((math::sin(a) * math::exp(((-0.01) * a))) + (math::sin(b) * math::exp(((-0.01) * b)))));
    auto t0 = time::monotonic();
    for (long long i = 1LL; i < n; ++i) {
        auto x = (a + (h * i));
        s += (math::sin(x) * math::exp(((-0.01) * x)));
    }
    auto t1 = time::monotonic();
    io::print((s * h));
    io::print((t1 - t0));
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

