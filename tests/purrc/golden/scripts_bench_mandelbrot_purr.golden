// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "time.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace time = ::cheatah::time;

void purr_main() {
    auto W = 800LL;
    auto H = 600LL;
    auto maxit = 256LL;
    auto total = 0LL;
    auto t0 = time::monotonic();
    for (long long py = 0LL; py < H; ++py) {
        for (long long px = 0LL; px < W; ++px) {
            auto x0 = ((-2.5) + builtins::truediv((3.5 * px), W));
            auto y0 = ((-1.0) + builtins::truediv((2.0 * py), H));
            auto x = 0.0;
            auto y = 0.0;
            auto it = 0LL;
            while (((((x * x) + (y * y)) <= 4.0) && (it < maxit))) {
                auto xt = (((x * x) - (y * y)) + x0);
                y = (((2.0 * x) * y) + y0);
                x = xt;
                it += 1LL;
            }
            total += it;
        }
    }
    auto t1 = time::monotonic();
    io::print(total);
    io::print((t1 - t0));
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

