// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;

struct Bar {
    std::string date;
    double open{};
    double high{};
    double low{};
    double close{};
    void cheatah_pretty_print(std::ostream& os_, long long indent_) const {
        os_ << "Bar(\n";
        os_ << std::string(indent_ + 4, ' ') << "date = ";
        os_ << this->date;
        os_ << ",\n";
        os_ << std::string(indent_ + 4, ' ') << "open = ";
        os_ << this->open;
        os_ << ",\n";
        os_ << std::string(indent_ + 4, ' ') << "high = ";
        os_ << this->high;
        os_ << ",\n";
        os_ << std::string(indent_ + 4, ' ') << "low = ";
        os_ << this->low;
        os_ << ",\n";
        os_ << std::string(indent_ + 4, ' ') << "close = ";
        os_ << this->close;
        os_ << "\n";
        os_ << std::string(indent_, ' ') << ")";
    }
};
inline std::ostream& operator<<(std::ostream& os_, const Bar& v_) {
    return os_ << "Bar(" << "date=" << v_.date << ", open=" << v_.open << ", high=" << v_.high << ", low=" << v_.low << ", close=" << v_.close << ")";
}

static auto add(builtins::Value auto&& a, builtins::Value auto&& b) {
    return (a + b);
}


static auto fib(builtins::Value auto&& n) {
    if (n < 2LL) {
        return n;
    }
    return (fib((n - 1LL)) + fib((n - 2LL)));
}


void purr_main() {
    auto total = 0LL;
    for (long long i = 1LL; i < 6LL; ++i) {
        total += i;
    }
    io::print("sum 1..5 =", total);
    auto n = 5LL;
    auto f = 1LL;
    while (n > 1LL) {
        f = (f * n);
        n = (n - 1LL);
    }
    io::print("5! =", f);
    io::print("add(3, 4) =", add(3LL, 4LL));
    io::print("fib(10) =", fib(10LL));
    auto b = Bar{std::string("2024-01-02"), 100.0, 105.5, 99.0, 103.25};
    if (b.close > b.open) {
        io::print(b.date, "was an up day, close", b.close);
    } else {
        io::print(b.date, "was a down day");
    }
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

