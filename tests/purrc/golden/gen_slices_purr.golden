// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "ndarray.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace ndarray = ::cheatah::ndarray;

static auto main() {
    auto xs = std::vector{1LL, 2LL, 3LL, 4LL, 5LL};
    io::print(builtins::slice(xs, 1LL, 4LL), builtins::slice(xs, (-2LL), builtins::slice_end));
    builtins::slice_assign(xs, 1LL, 3LL, std::vector{9LL, 9LL});
    io::print(xs);
    builtins::slice_assign(xs, 1LL, 3LL, std::vector{7LL, 7LL, 7LL});
    io::print(xs);
    builtins::slice_assign(xs, 0LL, 2LL, builtins::empty_seq{});
    io::print(xs);
    auto a = ndarray::array(std::vector{1.0, 2.0, 3.0, 4.0});
    builtins::slice_assign(a, 1LL, 3LL, 5.0);
    io::print(ndarray::to_string(a));
}


void purr_main() {
    main();
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

