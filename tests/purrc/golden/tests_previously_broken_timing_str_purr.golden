// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "time.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace time = ::cheatah::time;

void purr_main() {
    auto t0 = time::monotonic_ns();
    for (long long k = 0; k < 100LL; ++k) {
        io::print("stupid stupid stupid");
    }
    auto t1 = time::monotonic_ns();
    io::print((std::string("Took: ") + builtins::str((t1 - t0))));
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

