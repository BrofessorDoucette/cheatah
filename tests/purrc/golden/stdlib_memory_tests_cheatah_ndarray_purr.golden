// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "memory.hpp"
#include "ndarray.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace memory = ::cheatah::memory;
namespace ndarray = ::cheatah::ndarray;

namespace {

auto main() {
    auto arr = memory::own(ndarray::zeros(std::vector{4LL}));
    {
        auto w = arr.rwrite().acquire();
        w.write(0LL, 10.0);
        w.write(3LL, 20.0);
    }
    {
        auto r = arr.rread().acquire();
        io::print((builtins::index(r.read(), 0LL) == 10.0));
        io::print((builtins::index(r.read(), 3LL) == 20.0));
        io::print(((builtins::index(r.read(), 1LL) == 0.0) && (builtins::index(r.read(), 2LL) == 0.0)));
    }
}


}  // namespace

void purr_main() {
    main();
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

