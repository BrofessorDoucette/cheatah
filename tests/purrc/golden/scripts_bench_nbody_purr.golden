// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "math.hpp"
#include "time.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace math = ::cheatah::math;
namespace time = ::cheatah::time;

void purr_main() {
    auto N = 256LL;
    auto steps = 200LL;
    std::vector<double> px;
    std::vector<double> py;
    std::vector<double> vx;
    std::vector<double> vy;
    for (long long i = 0LL; i < N; ++i) {
        auto fi = (1.0 + i);
        builtins::append(px, math::sin((fi * 1.3)));
        builtins::append(py, math::cos((fi * 0.7)));
        builtins::append(vx, 0.0);
        builtins::append(vy, 0.0);
    }
    auto dt = 0.001;
    auto eps = 0.01;
    auto t0 = time::monotonic();
    for (long long s = 0LL; s < steps; ++s) {
        for (long long i = 0LL; i < N; ++i) {
            auto ax = 0.0;
            auto ay = 0.0;
            for (long long j = 0LL; j < N; ++j) {
                auto dx = (builtins::index(px, j) - builtins::index(px, i));
                auto dy = (builtins::index(py, j) - builtins::index(py, i));
                auto r2 = (((dx * dx) + (dy * dy)) + eps);
                auto inv = builtins::truediv(1.0, (r2 * math::sqrt(r2)));
                ax += (dx * inv);
                ay += (dy * inv);
            }
            vx[i] = (builtins::index(vx, i) + (dt * ax));
            vy[i] = (builtins::index(vy, i) + (dt * ay));
        }
        for (long long i = 0LL; i < N; ++i) {
            px[i] = (builtins::index(px, i) + (dt * builtins::index(vx, i)));
            py[i] = (builtins::index(py, i) + (dt * builtins::index(vy, i)));
        }
    }
    auto chk = 0.0;
    for (long long i = 0LL; i < N; ++i) {
        (chk += builtins::index(px, i)) += builtins::index(py, i);
    }
    auto t1 = time::monotonic();
    io::print(chk);
    io::print((t1 - t0));
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

