// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "memory.hpp"

namespace cheatah_program {

namespace io = ::cheatah::io;
namespace memory = ::cheatah::memory;

struct Point {
    long long x{};
    long long y{};
    void cheatah_pretty_print(std::ostream& os_, long long indent_) const {
        os_ << "Point(\n";
        os_ << std::string(indent_ + 4, ' ') << "x = ";
        os_ << this->x;
        os_ << ",\n";
        os_ << std::string(indent_ + 4, ' ') << "y = ";
        os_ << this->y;
        os_ << "\n";
        os_ << std::string(indent_, ' ') << ")";
    }
};
inline std::ostream& operator<<(std::ostream& os_, const Point& v_) {
    return os_ << "Point(" << "x=" << v_.x << ", y=" << v_.y << ")";
}

namespace {

auto main() {
    auto owner = memory::own(Point{0LL, 0LL});
    {
        auto r = owner.rread().acquire();
        io::print(r.read().x, r.read().y);
    }
    {
        auto w = owner.rwrite().acquire();
        w.write(Point{3LL, 4LL});
    }
    {
        auto r = owner.rread().acquire();
        io::print(r.read().x, r.read().y);
    }
    {
        auto r = owner.rread().acquire();
        io::print((r.read().x + r.read().y));
    }
}


}  // namespace

void purr_main() {
    main();
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

