#include "sys.hpp"
#include "thread.hpp"
#include "time.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace math = ::cheatah::math;
namespace memory = ::cheatah::memory;
namespace stamp = ::cheatah::stamp;
namespace statistics = ::cheatah::statistics;
namespace sys = ::cheatah::sys;
namespace thread = ::cheatah::thread;
namespace time = ::cheatah::time;

struct Sample {
    double integral{};
    double secs{};
    void cheatah_pretty_print(std::ostream& os_, long long indent_) const {
        os_ << "Sample(\n";
        os_ << std::string(indent_ + 4, ' ') << "integral = ";
        os_ << this->integral;
        os_ << ",\n";
        os_ << std::string(indent_ + 4, ' ') << "secs = ";
        os_ << this->secs;
        os_ << "\n";
        os_ << std::string(indent_, ' ') << ")";
    }
};
inline std::ostream& operator<<(std::ostream& os_, const Sample& v_) {
    return os_ << "Sample(" << "integral=" << v_.integral << ", secs=" << v_.secs << ")";
}

static auto rounds() {
    return 7LL;
}


static auto points() {
    return 20000000LL;
}


static auto width() {
    return builtins::truediv(50.0, points());
}


static auto chunk(memory::Owner<double>& o, builtins::Value auto&& lo, builtins::Value auto&& hi) {
    auto h = width();
    auto s = 0.0;
    for (long long i = lo; i < hi; ++i) {
        auto x = (h * i);
        s += (math::sin(x) * math::exp(((-0.01) * x)));
    }
    {
        auto w = o.rwrite().acquire();
        w.write((w.read() + s));
    }
}


static double edges() {
    auto b = 50.0;
    return (0.5 * ((math::sin(0.0) * math::exp(0.0)) + (math::sin(b) * math::exp(((-0.01) * b)))));
}


static double integral_of(builtins::Value auto&& total) {
    return ((total + edges()) * width());
}


static auto report(builtins::Value auto&& tag, builtins::Value auto&& integral, builtins::Value auto&& samples) {
    auto lo = builtins::index(samples, 0LL);
    auto hi = builtins::index(samples, 0LL);
    for (auto& v : samples) {
        if (v < lo) {
            lo = v;
        }
        if (v > hi) {
            hi = v;
        }
    }
    io::print(tag, integral, statistics::median(samples), statistics::stdev(samples), lo, hi);
}


static std::string ms(builtins::Value auto&& v) {
    return (builtins::str(io::fixed((v * 1000.0), 0LL)) + std::string(" ms"));
}


static std::string row(builtins::Value auto&& workers, builtins::Value auto&& samples, builtins::Value auto&& base, builtins::Value auto&& integral) {
    auto med = statistics::median(samples);
    auto sp = std::string("—");
    if ((base > 0.0) && (workers != std::string("1"))) {
        sp = ((std::string("**") + builtins::str(io::fixed(builtins::truediv(base, med), 2LL))) + std::string("×**"));
    }
    auto out = (((((std::string("| ") + builtins::str(workers)) + std::string(" | ")) + builtins::str(ms(med))) + std::string(" | ±")) + builtins::str(ms(statistics::stdev(samples))));
    ((((out += " | ") += sp) += " | ") += io::str(integral)) += " |\n";
    return out;
}


static auto run_1() {
    auto o = memory::own(0.0);
    auto t0 = time::monotonic();
    chunk(o, 1LL, points());
    auto t1 = time::monotonic();
    return Sample{integral_of(o.rread().acquire().read()), (t1 - t0)};
}


static auto run_2() {
    auto o = memory::own(0.0);
    auto n = points();
    auto t0 = time::monotonic();
    {
        auto _purr_with_0 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, 1LL, builtins::truediv(n, 2LL));
        {
            auto _purr_with_1 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, builtins::truediv(n, 2LL), n);
        }
    }
    auto t1 = time::monotonic();
    return Sample{integral_of(o.rread().acquire().read()), (t1 - t0)};
}


static auto run_4() {
    auto o = memory::own(0.0);
    auto n = points();
    auto q = builtins::truediv(n, 4LL);
    auto t0 = time::monotonic();
    {
        auto _purr_with_2 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, 1LL, q);
        {
            auto _purr_with_3 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, q, (2LL * q));
            {
                auto _purr_with_4 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, (2LL * q), (3LL * q));
                {
                    auto _purr_with_5 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, (3LL * q), n);
                }
            }
        }
    }
    auto t1 = time::monotonic();
    return Sample{integral_of(o.rread().acquire().read()), (t1 - t0)};
}


static auto run_8() {
    auto o = memory::own(0.0);
    auto n = points();
    auto e = builtins::truediv(n, 8LL);
    auto t0 = time::monotonic();
    {
        auto _purr_with_6 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, 1LL, e);
        {
            auto _purr_with_7 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, e, (2LL * e));
            {
                auto _purr_with_8 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, (2LL * e), (3LL * e));
                {
                    auto _purr_with_9 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, (3LL * e), (4LL * e));
                    {
                        auto _purr_with_10 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, (4LL * e), (5LL * e));
                        {
                            auto _purr_with_11 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, (5LL * e), (6LL * e));
                            {
                                auto _purr_with_12 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, (6LL * e), (7LL * e));
                                {
                                    auto _purr_with_13 = thread::spawn([](auto&&... _a){ return chunk(_a...); }, o, (7LL * e), n);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    auto t1 = time::monotonic();
    return Sample{integral_of(o.rread().acquire().read()), (t1 - t0)};
}


static auto main() {
    std::vector<double> s1;
    std::vector<double> s2;
    std::vector<double> s4;
    std::vector<double> s8;
    auto i1 = 0.0;
    auto i2 = 0.0;
    auto i4 = 0.0;
    auto i8 = 0.0;
    for (long long r = 0LL; r < rounds(); ++r) {
        auto a = run_1();
        auto b = run_2();
        auto c = run_4();
        auto d = run_8();
        builtins::append(s1, a.secs);
        builtins::append(s2, b.secs);
        builtins::append(s4, c.secs);
        builtins::append(s8, d.secs);
        i1 = a.integral;
        i2 = b.integral;
        i4 = c.integral;
        i8 = d.integral;
    }
    io::print("workers integral median_s stdev_s min_s max_s");
    report(std::string("1:"), i1, s1);
    report(std::string("2:"), i2, s2);
    report(std::string("4:"), i4, s4);
    report(std::string("8:"), i8, s8);
    if (builtins::len(sys::argv) > 1LL) {
        auto base = statistics::median(s1);
        auto t = std::string("| workers | wall time (median) | spread | speedup | integral |\n");
        t += "|--------:|-------------------:|-------:|--------:|----------|\n";
        t += row(std::string("1"), s1, base, i1);
        t += row(std::string("2"), s2, base, i2);
        t += row(std::string("4"), s4, base, i4);
        t += row(std::string("8"), s8, base, i8);
        auto st = stamp::build(std::string("thread-scaling"), std::string("stdlib/thread/, stdlib/memory/, scripts/bench/integral_threads.purr"), std::string("none — cheatah against itself at 1/2/4/8 workers"), rounds(), std::string("median wall clock; ± is the sample standard deviation"), std::string("purrc scripts/bench/integral_threads.purr -o /tmp/it.so --import-root scripts && cheatah /tmp/it.so docs/bench/thread-scaling.md"));
        stamp::write_region(builtins::index(sys::argv, 1LL), st, t);
    }
}


void purr_main() {
    main();
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

