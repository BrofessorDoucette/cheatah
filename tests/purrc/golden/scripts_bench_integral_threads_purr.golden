        t += row(std::string("2"), s2, base, i2);
        t += row(std::string("4"), s4, base, i4);
        t += row(std::string("8"), s8, base, i8);
        auto st = stamp::build(std::string("thread-scaling"), std::string("stdlib/thread/, stdlib/memory/, scripts/bench/integral_threads.purr"), std::string("none — cheatah against itself at 1/2/4/8 workers"), rounds(), std::string("median wall clock; ± is the sample standard deviation"), std::string("purrc scripts/bench/integral_threads.purr -o /tmp/it.so --import-root scripts && cheatah /tmp/it.so docs/bench/thread-scaling.md"));
