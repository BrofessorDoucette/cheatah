// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;

struct DumbDumb {
    double what{};
    double what2{};
    void cheatah_pretty_print(std::ostream& os_, long long indent_) const {
        os_ << "DumbDumb(\n";
        os_ << std::string(indent_ + 4, ' ') << "what = ";
        os_ << this->what;
        os_ << ",\n";
        os_ << std::string(indent_ + 4, ' ') << "what2 = ";
        os_ << this->what2;
        os_ << "\n";
        os_ << std::string(indent_, ' ') << ")";
    }
};
inline std::ostream& operator<<(std::ostream& os_, const DumbDumb& v_) {
    return os_ << "DumbDumb(" << "what=" << v_.what << ", what2=" << v_.what2 << ")";
}

void purr_main() {
    auto d = DumbDumb{
        .what = static_cast<double>(10LL),
        .what2 = 300.2
    };
    io::print(d);
    io::rprint(d);
    io::print(d.what);
    io::print(d.what2);
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

