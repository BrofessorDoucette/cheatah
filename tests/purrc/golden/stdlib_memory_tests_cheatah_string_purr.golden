// Generated by purrc — do not edit.
#include "cheatah.hpp"
#include "io.hpp"
#include "memory.hpp"

namespace cheatah_program {

namespace builtins = ::cheatah::builtins;
namespace io = ::cheatah::io;
namespace memory = ::cheatah::memory;

static auto main() {
    auto s = memory::own(std::string(""));
    {
        auto w = s.rwrite().acquire();
        w.write(std::string("hello"));
    }
    {
        auto r = s.rread().acquire();
        io::print(builtins::len(r.read()));
    }
    {
        auto w = s.rwrite().acquire();
        w.write((builtins::str(w.read()) + std::string(" world")));
    }
    {
        auto r = s.rread().acquire();
        io::print(r.read());
    }
    {
        auto r = s.rread().acquire();
        io::print(builtins::len(r.read()));
    }
}


void purr_main() {
    main();
}

}  // namespace cheatah_program

PURR_EXPORT void purr_main() { cheatah_program::purr_main(); }

