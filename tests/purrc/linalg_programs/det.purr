# linalg.det — determinant via LU. Cross-checked vs numpy.linalg.det.
import io
import ndarray
import linalg

let A = ndarray.array([[4.0, 1.0, 0.0, 1.0],
                       [1.0, 5.0, 1.0, 0.0],
                       [0.0, 1.0, 6.0, 1.0],
                       [1.0, 0.0, 1.0, 7.0]])
io.print(linalg.det(A))
