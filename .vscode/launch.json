{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug purrc (compile tour.purr) [Debug]",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/purrc",
      "args": [
        "${workspaceFolder}/stdlib/scripts/tour.purr",
        "-o",
        "${workspaceFolder}/build/debug/tour.so"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Build purrc compiler (Debug)",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Debug cheatah runtime (run tour.so) [Debug]",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/cheatah",
      "args": ["${workspaceFolder}/build/debug/tour.so"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "purrc: compile tour.purr (Debug)",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Run purrc (compile tour.purr) [Release]",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/release/bin/purrc",
      "args": [
        "${workspaceFolder}/stdlib/scripts/tour.purr",
        "-o",
        "${workspaceFolder}/build/release/tour.so"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Build purrc compiler (Release)"
    },
    {
      "name": "Run cheatah runtime (run tour.so) [Release]",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/release/bin/cheatah",
      "args": ["${workspaceFolder}/build/release/tour.so"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "purrc: compile tour.purr (Release)"
    }
  ]
}
