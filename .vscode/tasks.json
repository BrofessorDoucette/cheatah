{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "presentation": { "reveal": "always", "panel": "shared", "clear": true },
  "tasks": [
    {
      "label": "Configure (Debug)",
      "type": "shell",
      "command": "cmake --preset debug",
      "problemMatcher": []
    },
    {
      "label": "Configure (Release)",
      "type": "shell",
      "command": "cmake --preset release",
      "problemMatcher": []
    },

    {
      "label": "Build All (Debug)",
      "type": "shell",
      "command": "cmake --build --preset debug",
      "dependsOn": "Configure (Debug)",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build All (Release)",
      "type": "shell",
      "command": "cmake --build --preset release",
      "dependsOn": "Configure (Release)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },

    {
      "label": "Build cheatah runtime (Debug)",
      "type": "shell",
      "command": "cmake --build --preset debug --target cheatah",
      "dependsOn": "Configure (Debug)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build cheatah runtime (Release)",
      "type": "shell",
      "command": "cmake --build --preset release --target cheatah",
      "dependsOn": "Configure (Release)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },

    {
      "label": "Build purrc compiler (Debug)",
      "type": "shell",
      "command": "cmake --build --preset debug --target purrc",
      "dependsOn": "Configure (Debug)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build purrc compiler (Release)",
      "type": "shell",
      "command": "cmake --build --preset release --target purrc",
      "dependsOn": "Configure (Release)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },

    {
      "label": "Build stdlib libs (Debug)",
      "type": "shell",
      "command": "cmake --build --preset debug --target cheatah_stdlib",
      "dependsOn": "Configure (Debug)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build stdlib libs (Release)",
      "type": "shell",
      "command": "cmake --build --preset release --target cheatah_stdlib",
      "dependsOn": "Configure (Release)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },

    {
      "label": "Run Tests (Debug)",
      "type": "shell",
      "command": "ctest --preset debug --output-on-failure",
      "dependsOn": "Build All (Debug)",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "QA Gate",
      "type": "shell",
      "command": "bash scripts/qa_gate.sh",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean (Debug)",
      "type": "shell",
      "command": "cmake --build --preset debug --target clean",
      "problemMatcher": []
    },

    {
      "label": "purrc: compile tour.purr (Debug)",
      "detail": "Build everything, then compile stdlib/scripts/tour.purr to build/debug/tour.so (used by the runtime debug config).",
      "type": "shell",
      "command": "${workspaceFolder}/build/debug/bin/purrc ${workspaceFolder}/stdlib/scripts/tour.purr -o ${workspaceFolder}/build/debug/tour.so",
      "dependsOn": "Build All (Debug)",
      "problemMatcher": []
    },
    {
      "label": "purrc: compile tour.purr (Release)",
      "detail": "Build everything (release), then compile stdlib/scripts/tour.purr to build/release/tour.so.",
      "type": "shell",
      "command": "${workspaceFolder}/build/release/bin/purrc ${workspaceFolder}/stdlib/scripts/tour.purr -o ${workspaceFolder}/build/release/tour.so",
      "dependsOn": "Build All (Release)",
      "problemMatcher": []
    }
  ]
}
