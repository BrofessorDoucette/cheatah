{
  "version": 4,
  "configurations": [
    {
      "name": "cheatah (clang, C++20)",
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-clang-x64",

      "//": "Primary source of truth: per-file flags + include dirs from the CMake build.",
      "compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",

      "//fallback": "Used for files not yet in compile_commands (e.g. a freshly added header).",
      "includePath": [
        "${workspaceFolder}/compiler",
        "${workspaceFolder}/runtime",
        "${workspaceFolder}/stdlib",
        "${workspaceFolder}/stdlib/**"
      ],
      "browse": {
        "path": ["${workspaceFolder}/compiler", "${workspaceFolder}/runtime", "${workspaceFolder}/stdlib"],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
