# Doxyfile for cheatah's standard library.
# Generate the site (output lands in docs/html/) with:
#     doxygen Doxyfile
# Modern styling via doxygen-awesome-css + a cheetah-themed palette (docs/theme/).

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "cheatah"
PROJECT_NUMBER         =
PROJECT_BRIEF          = "🐱 Programs so fast they purrrrrrrrrrrrr like a kitten. 🐆"
PROJECT_LOGO           = docs/theme/cheatah-logo.png
PROJECT_ICON           = docs/theme/cheatah-logo.png
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
AUTOLINK_SUPPORT       = YES
TAB_SIZE               = 4

#---------------------------------------------------------------------------
# Build / extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
INLINE_INHERITED_MEMB  = NO
SORT_MEMBER_DOCS       = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = stdlib docs/mainpage.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */tests/* */scripts/* */README.md
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO

#---------------------------------------------------------------------------
# HTML output + doxygen-awesome-css theme
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            = docs/theme/header.html
HTML_FOOTER            = docs/theme/footer.html
HTML_COLORSTYLE        = LIGHT
HTML_COPY_CLIPBOARD    = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_DYNAMIC_SECTIONS  = YES
HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome.css \
                         docs/theme/doxygen-awesome-sidebar-only.css \
                         docs/theme/doxygen-awesome-sidebar-only-darkmode-toggle.css \
                         docs/theme/cheetah.css
HTML_EXTRA_FILES       = docs/theme/doxygen-awesome-darkmode-toggle.js \
                         docs/theme/doxygen-awesome-fragment-copy-button.js \
                         docs/theme/doxygen-awesome-paragraph-link.js \
                         docs/theme/doxygen-awesome-interactive-toc.js \
                         docs/theme/doxygen-awesome-tabs.js

#---------------------------------------------------------------------------
# Diagrams (graphviz optional — off to keep the build self-contained)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = YES

#---------------------------------------------------------------------------
# Preprocessor (keep template/concept-heavy headers parseable)
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = YES
