# Doxyfile for cheatah's standard library.
# Generate the site (output lands in docs/html/) with:
#     doxygen Doxyfile
# Styling: a fixed dark cheetah theme via doxygen-awesome-css + docs/theme/cheetah.css
# (WCAG 2.1 contrast — see docs/theme/ACCESSIBILITY.md). Diagrams: Graphviz dot.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "cheatah"
PROJECT_NUMBER         =
PROJECT_BRIEF          = "🐱 Programs so fast they purrrrrrrrrrrrr. 🐆"
PROJECT_LOGO           = docs/theme/cheatah-logo.png
PROJECT_ICON           = docs/theme/cheatah-logo.png
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
AUTOLINK_SUPPORT       = YES
TAB_SIZE               = 4

# Custom doc tags: split the old combined @note into structured, separately
# styled sections (see docs/theme/cheetah.css for their colors).
ALIASES                = "complexity=\xrefitem complexity \"Complexity\" \"Complexity\""
ALIASES               += "alloc=\xrefitem alloc \"Allocation\" \"Allocation\""
# Three test kinds, all shown per function and linked to their source by the generator.
ALIASES               += "crtest=\xrefitem crtest \"Compile-run test\" \"Compile-run test\""
ALIASES               += "systest=\xrefitem systest \"System test\" \"System test\""

#---------------------------------------------------------------------------
# Build / extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
INLINE_INHERITED_MEMB  = NO
SORT_MEMBER_DOCS       = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------------------
# Input — headers (the API) + implementations (so call/reference graphs have
# real data) + the hand-written guides + the per-module READMEs (merged into each
# module's page by the site generator) + the feature matrix + the changelog.
# Tests/scripts and the project-overview stdlib/README.md (a homepage duplicate)
# are excluded.
#---------------------------------------------------------------------------
INPUT                  = stdlib docs/mainpage.md docs/why.md docs/getting_started.md docs/performance.md docs/optimizations.md docs/porting.md docs/security.md docs/cpp.md docs/runtime.md docs/purrc.md docs/biome.md docs/extensions.md docs/imports.md docs/threading.md compiler/PYTHON.md CHANGELOG.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
# Treat a module's README.md as a normal documentation page (whose body the site
# generator merges into that module's page), NOT as the enclosing directory's docs
# (the default, which would swallow the content and emit nothing usable in XML).
IMPLICIT_DIR_DOCS      = NO
# Wholly-INTERNAL headers are excluded as files: their symbols live in the module's main
# namespace (or a non-`detail` sub-namespace), so no symbol pattern can catch them, and none
# of them are the API a cheatah user should see. The code itself stays browsable in the repo —
# this only keeps the machinery off the docs site / hover DB / Javadoc gate:
#   - tls_lowlevel / websocket_lowlevel — C++-only raw-handle APIs (the resolver never
#     surfaces them to cheatah; the guards are the public path)
#   - rsa_verify / x509 — TLS's bignum + certificate plumbing (cheatah::tls::rsa / ::x509)
#   - aes_gcm_ni — AEAD's hardware kernels (cheatah::aead::accel)
#   - parsers/json simd + builder/cursor machinery (construction policies, scan kernels)
EXCLUDE                = stdlib/README.md \
                         stdlib/tls/tls_lowlevel.hpp \
                         stdlib/tls/rsa_verify.hpp \
                         stdlib/tls/x509.hpp \
                         stdlib/websocket/websocket_lowlevel.hpp \
                         stdlib/aead/aes_gcm_ni.hpp \
                         stdlib/parsers/json/simd.hpp \
                         stdlib/parsers/json/pool_builder.hpp \
                         stdlib/parsers/json/owning_builder.hpp \
                         stdlib/parsers/json/cursor.hpp
EXCLUDE_PATTERNS       = */tests/* */scripts/*
# Internal implementation helpers (any `detail` namespace) are NOT public API: the
# site generator and the hover index already hide them, so they are excluded here
# too (and from the 100%-Javadoc gate). Also hidden:
#   - `testonly` namespaces (white-box seams behind CHEATAH_*_TESTING defines)
#   - `module_abi` (the ABI marker purrc emits into every pure-cheatah library module)
#   - requests' .purr implementation helpers (a .purr module emits every top-level fn
#     into its namespace; these back the get/post/... verbs and are not user API)
EXCLUDE_SYMBOLS        = *::detail::* *::detail
EXCLUDE_SYMBOLS       += *::testonly::* *::testonly
EXCLUDE_SYMBOLS       += *::module_abi
# Function-level internals with globally-UNIQUE names (bare names — this Doxygen build
# matches member symbols by name, and each of these appears in exactly one module):
# requests' .purr implementation helpers, sys's runtime hook, and the tls/websocket
# low-level entry points whose names don't collide with public API. The lowlevel
# functions whose names DO collide (tls/websocket send/recv/close/shutdown/connect —
# also public socket API) are hidden at their definitions instead (\cond in the .cpp).
EXCLUDE_SYMBOLS       += percent_encode b64encode json_escape has_header
EXCLUDE_SYMBOLS       += parse_hex parse_uint dechunk read_all
EXCLUDE_SYMBOLS       += parse_response request_once strip_sensitive
EXCLUDE_SYMBOLS       += set_argv client_connect connect_url send_text
EXCLUDE_SYMBOLS       += module_abi cheatah_set_argv
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

#---------------------------------------------------------------------------
# Source browser + cross-references ("References" / "Referenced by")
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

#---------------------------------------------------------------------------
# Output: Doxygen is used ONLY as the C++ parser — it emits XML, and our own
# generator (docs/gen/generate.py) renders the site into docs/html. No Doxygen HTML.
#---------------------------------------------------------------------------
GENERATE_HTML          = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            = docs/theme/header.html
HTML_FOOTER            = docs/theme/footer.html
HTML_COLORSTYLE        = DARK
HTML_COPY_CLIPBOARD    = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = NO
HTML_DYNAMIC_SECTIONS  = YES
HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome.css \
                         docs/theme/doxygen-awesome-sidebar-only.css \
                         docs/theme/cheetah.css \
                         docs/theme/cheatah-palette.generated.css
HTML_EXTRA_FILES       = docs/theme/doxygen-awesome-fragment-copy-button.js \
                         docs/theme/doxygen-awesome-paragraph-link.js \
                         docs/theme/doxygen-awesome-interactive-toc.js \
                         docs/theme/doxygen-awesome-tabs.js

#---------------------------------------------------------------------------
# Diagrams — Graphviz dot (inheritance, collaboration, include, call/caller,
# hierarchy, directory). Rendered as SVG; dark-aware because HTML_COLORSTYLE=DARK.
#---------------------------------------------------------------------------
HAVE_DOT               = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
DOT_MULTI_TARGETS      = YES
GENERATE_LEGEND        = YES
HIDE_UNDOC_RELATIONS   = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

#---------------------------------------------------------------------------
# Preprocessor — expand macros so generated docs/graphs reflect real code
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SKIP_FUNCTION_MACROS   = YES
SEARCH_INCLUDES        = YES
PREDEFINED             =
