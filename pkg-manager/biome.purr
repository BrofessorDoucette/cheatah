# biome — the cheatah package manager.
#
# "biome" because both pythons and cheetahs roam the African savanna: it is where
# a cheatah project and its (Python-like) dependencies live together.
#
# biome is itself a cheatah program: purrc compiles this file to a module
# (biome.so) and a small native launcher named `biome` runs it through the cheatah
# runtime. It manages a project's `cheatah.toml` manifest and drives CMake/CPM so
# that, ultimately, EVERYTHING is built by CMake: `biome configure` regenerates the
# project's CMakeLists.txt from the manifest and runs the CMake configure (CPM fetches
# the cheatah toolchain plus whichever optional standard-library extensions —
# cheatah-gpu, cheatah-plot, cheatah-space, … — the user chose), and `biome build`
# compiles it.
#
# biome BUILDS; it never RUNS your program. A cheatah program is a loadable module,
# and it is run by the `cheatah` runtime (`cheatah build/<name>.so`) — never by biome.
#
# Versions are governed by the Biome Standard: one user-facing semantic version that
# names a SET of component releases (toolchain + extensions) tested to work together.
# A project's cheatah.toml pins `standard = "<ver>"`; biome resolves every git tag it
# writes into the generated CMake from that standard, so users track ONE number.
#
# Commands:
#   biome init <name>       scaffold a new project
#   biome add <ext>         add an optional stdlib extension to the manifest
#   biome remove <ext>      remove an extension
#   biome list [dir]        list the extensions used by the project at <dir> (default: .)
#   biome standards         list the Biome Standards this biome knows
#   biome configure         regenerate CMakeLists.txt and run the CMake configure
#   biome build             build the configured project (add --clean-first to rebuild)
#   biome help              usage
#   biome version           print the biome version

import io
import os
import string
import sys

# The GitHub owner that hosts the cheatah toolchain and the official extensions.
fn github_owner() { return "BrofessorDoucette" }

fn biome_version() { return "0.2.0-alpha" }

fn manifest_path() { return "cheatah.toml" }

# ---- the registry of optional standard-library extensions ------------------
# Each is a separate git repository, fetched by CPM at build time. This is the
# single source of truth biome consults; `add`/`list` validate names against it.
fn known_extensions() {
    let xs: list<str> = []
    xs.append("cheatah-gpu")
    xs.append("cheatah-gpu-linalg")
    xs.append("cheatah-plot")
    xs.append("cheatah-space")
    return xs
}

fn extension_desc(name) {
    if name == "cheatah-gpu" { return "GPU arrays and compute kernels" }
    elif name == "cheatah-gpu-linalg" { return "GPU linear algebra (the linalg device backend)" }
    elif name == "cheatah-plot" { return "Plotting and charting" }
    elif name == "cheatah-space" { return "Astronomy and spatial math" }
    else { return "(unregistered extension)" }
}

# owner/repo for an extension — every official extension lives under the same owner.
fn extension_repo(name) {
    return github_owner() + "/" + name
}

fn is_known_extension(name) {
    for x in known_extensions() {
        if x == name { return true }
    }
    return false
}

# ---- the Biome Standard ----------------------------------------------------
# A Biome Standard is ONE user-facing semantic version naming a set of component
# releases (the cheatah toolchain + extensions) that were tested to work together.
# The table below is append-only and mirrors the canonical files in standards/
# (scripts/check_standards.sh fails the QA gate if the two ever drift). Its major
# version only ever increments when user programs cannot carry forward — a forced
# security change or a fundamental language change — never because one member broke
# compatibility with another inside the set.
#
# status is "current" (the newest), "supported" (older, still patched), or
# "deprecated: <advisory>" (security-only retirement; the sources stay archived).

struct StandardComponent {
    name: str
    tag: str
}

struct Standard {
    version: str
    released: str
    status: str
    components: list<StandardComponent>
}

fn known_standards() {
    let xs: list<Standard> = []

    # Biome Standard 0.1.0-alpha — the first tested-together set.
    let c0: list<StandardComponent> = []
    c0.append(StandardComponent("cheatah", "v1.7.0-alpha"))
    c0.append(StandardComponent("cheatah-gpu", "v0.5.0-alpha"))
    xs.append(Standard("0.1.0-alpha", "2026-07-25", "supported", c0))

    # Biome Standard 0.2.0-alpha — cheatah v1.8.0-alpha. A MINOR bump: the allocation-free
    # crypto surface is added BESIDE the existing string-returning functions, so every program
    # written against 0.1.0-alpha compiles and behaves identically. New capability, nothing
    # removed, no signature changed.
    let c1: list<StandardComponent> = []
    c1.append(StandardComponent("cheatah", "v1.8.0-alpha"))
    c1.append(StandardComponent("cheatah-gpu", "v0.5.0-alpha"))
    xs.append(Standard("0.2.0-alpha", "2026-07-27", "supported", c1))

    # Biome Standard 0.3.0-alpha — cheatah v1.9.0-alpha. Minor: macOS portability fixes plus the
    # portable RNG distributions. No API changed, so every program written against 0.2.0-alpha
    # still compiles; what moved is the SEQUENCE a seed produces, which was never portable before.
    let c2: list<StandardComponent> = []
    c2.append(StandardComponent("cheatah", "v1.9.0-alpha"))
    c2.append(StandardComponent("cheatah-gpu", "v0.5.0-alpha"))
    xs.append(Standard("0.3.0-alpha", "2026-07-27", "supported", c2))

    # Biome Standard 0.4.0-alpha — cheatah v1.10.0-alpha. Minor: the regex matcher rewrite
    # (one-pass search, reversed `$`, run skipping) keeps the API and semantics; the one
    # user-visible change is that a pattern over 64 KiB (or one relying on the old, less
    # precise nested-parse error message) now reports a different `error` string. Every real
    # program written against 0.3.0-alpha compiles and behaves identically.
    let c3: list<StandardComponent> = []
    c3.append(StandardComponent("cheatah", "v1.10.0-alpha"))
    c3.append(StandardComponent("cheatah-gpu", "v0.5.0-alpha"))
    xs.append(Standard("0.4.0-alpha", "2026-08-13", "supported", c3))

    # Biome Standard 0.5.0-alpha — the FIVE-member set: three extensions join (cheatah-gpu-linalg,
    # cheatah-plot, cheatah-space), each at its first standard-worthy release, and the toolchain
    # moves to v1.11.0-alpha. A MINOR bump: membership is ADDITIVE — every program written against
    # 0.4.0-alpha compiles and behaves identically (the toolchain release carries the library-mode
    # `inline` emission fix and the docs site; no API changed, nothing removed). From here every
    # standard names a WORKING COMBINATION of all five members, tested together.
    let c4: list<StandardComponent> = []
    c4.append(StandardComponent("cheatah", "v1.11.0-alpha"))
    c4.append(StandardComponent("cheatah-gpu", "v0.5.0-alpha"))
    c4.append(StandardComponent("cheatah-gpu-linalg", "v0.4.0-alpha"))
    c4.append(StandardComponent("cheatah-plot", "v0.1.0-alpha"))
    c4.append(StandardComponent("cheatah-space", "v0.1.0-alpha"))
    xs.append(Standard("0.5.0-alpha", "2026-08-14", "supported", c4))

    # Biome Standard 0.5.1-alpha — the PATCH the acceptance test earned: 0.5.0-alpha's members
    # were individually gate-proven, but the fresh-directory e2e (an empty dir consuming every
    # member from GitHub through biome) caught two consumer-context defects — cheatah-gpu-linalg
    # configuring its dev battery inside a consumer's _deps tree, and the toolchain's program
    # builder not wiring an extension's consumer interface (module path, includes, links) into
    # the purrc compile. cheatah v1.11.1-alpha + cheatah-gpu-linalg v0.4.1-alpha fix exactly
    # that; no API changed anywhere — a PATCH.
    let c5: list<StandardComponent> = []
    c5.append(StandardComponent("cheatah", "v1.11.1-alpha"))
    c5.append(StandardComponent("cheatah-gpu", "v0.5.0-alpha"))
    c5.append(StandardComponent("cheatah-gpu-linalg", "v0.4.1-alpha"))
    c5.append(StandardComponent("cheatah-plot", "v0.1.0-alpha"))
    c5.append(StandardComponent("cheatah-space", "v0.1.0-alpha"))
    xs.append(Standard("0.5.1-alpha", "2026-08-14", "supported", c5))

    # Biome Standard 0.5.2-alpha — the acceptance test's second round: 0.5.1-alpha fixed the
    # first seam it caught, and the SAME test then reached the compile line and caught the
    # next two — consumer.cmake generated at the consumer's ROOT build dir instead of the
    # extension's own (invisible to the per-extension path, colliding between extensions),
    # and `import gpu` compiling against system Vulkan headers too old for the generated 1.4
    # surface. cheatah-gpu v0.5.1-alpha (consumer.cmake with the SDK include) and
    # cheatah-gpu-linalg v0.4.2-alpha (CURRENT_BINARY_DIR) fix them; cheatah v1.11.2-alpha
    # carries this table. Still a PATCH: fixes only, no API change anywhere.
    let c6: list<StandardComponent> = []
    c6.append(StandardComponent("cheatah", "v1.11.2-alpha"))
    c6.append(StandardComponent("cheatah-gpu", "v0.5.1-alpha"))
    c6.append(StandardComponent("cheatah-gpu-linalg", "v0.4.2-alpha"))
    c6.append(StandardComponent("cheatah-plot", "v0.1.0-alpha"))
    c6.append(StandardComponent("cheatah-space", "v0.1.0-alpha"))
    xs.append(Standard("0.5.2-alpha", "2026-08-14", "supported", c6))

    # Biome Standard 0.5.3-alpha — round three: the acceptance test reached gpu-linalg's
    # cross-repo include and caught its sibling-checkout default (../cheatah-gpu), which does
    # not exist inside a consumer's _deps tree. cheatah-gpu-linalg v0.4.3-alpha prefers the
    # consumer's CPM source dir; everything else unchanged. Still a PATCH.
    let c7: list<StandardComponent> = []
    c7.append(StandardComponent("cheatah", "v1.11.3-alpha"))
    c7.append(StandardComponent("cheatah-gpu", "v0.5.1-alpha"))
    c7.append(StandardComponent("cheatah-gpu-linalg", "v0.4.3-alpha"))
    c7.append(StandardComponent("cheatah-plot", "v0.1.0-alpha"))
    c7.append(StandardComponent("cheatah-space", "v0.1.0-alpha"))
    xs.append(Standard("0.5.3-alpha", "2026-08-14", "current", c7))

    return xs
}

# The standard a fresh `biome init` pins: the newest (last) entry in the table.
fn default_standard() {
    let all = known_standards()
    return all[len(all) - 1].version
}

# Index of a standard in known_standards(), or -1 if this biome does not know it
# (e.g. the manifest names a standard newer than this biome release).
fn standard_index(ver) {
    let all = known_standards()
    let i = 0
    for s in all {
        if s.version == ver { return i }
        i = i + 1
    }
    return -1
}

# The git tag a standard pins for a component, or "" when the component is not a
# member of that standard (i.e. it was not tested with this set).
fn component_tag(s, name) {
    for c in s.components {
        if c.name == name { return c.tag }
    }
    return ""
}

# Canonical TOML rendering of a standard — byte-identical to standards/
# biome-standard-<ver>.toml, which is what scripts/check_standards.sh diffs.
fn emit_standard_toml(s) {
    let t = "# Biome Standard " + s.version + " — the set of component releases tested to work together.\n"
    t = t + "# Append-only: once released, only the status line may change (security advisories).\n\n"
    t = t + "[standard]\n"
    t = t + "version = \"" + s.version + "\"\n"
    t = t + "released = \"" + s.released + "\"\n"
    t = t + "status = \"" + s.status + "\"\n\n"
    t = t + "[components]\n"
    for c in s.components {
        t = t + c.name + " = \"" + c.tag + "\"\n"
    }
    return t
}

fn list_contains(xs, v) {
    for x in xs {
        if x == v { return true }
    }
    return false
}

# ---- the parsed manifest ---------------------------------------------------
# A local/path dependency: `import <name>...` resolves under <path> (a package dir or a
# folder of sibling modules). Crate-style — the value is `{ path = "..." }` in cheatah.toml.
struct Dep {
    name: str
    path: str
}

# A cheatah.toml carries the project name, the pinned Biome Standard, the chosen
# stdlib extensions, and any path dependencies. biome parses it into this record, edits the
# record, and re-serializes — deterministically (comments are not preserved).
# `cheatah` is a legacy/manual override of the toolchain tag alone: empty means "resolve
# the toolchain from the standard like every other component" (the normal case).
struct Manifest {
    name: str
    cheatah: str
    standard: str
    extensions: list<str>
    dependencies: list<Dep>
}

fn write_file(path, content) {
    let f = io.open(path, "w")
    f.write(content)
    f.close()
}

# Strip surrounding whitespace, then surrounding double quotes, from a TOML value.
fn unquote(s) {
    return string.strip(string.strip(s), "\"")
}

# Parse cheatah.toml into a Manifest. A missing/empty file yields an empty record;
# callers that require a project guard with os.path.exists(manifest_path()) first.
# Pull the path out of a dependency value — either a bare `"../pkg"` or a crate-style inline
# table `{ path = "../pkg" }`. Returns the first quoted substring (the path).
fn dep_path(raw) {
    let q1 = string.find(raw, "\"")
    if q1 < 0 { return string.strip(raw) }
    let rest = raw[q1 + 1:]
    let q2 = string.find(rest, "\"")
    if q2 < 0 { return rest }
    return rest[:q2]
}

fn read_manifest_at(path) {
    let name = ""
    let cver = ""
    let sver = default_standard()
    let exts: list<str> = []
    let deps: list<Dep> = []
    let section = ""
    let content = io.read_file(path)
    let lines = string.split(content, "\n")
    for raw in lines {
        let line = string.strip(raw)
        if len(line) == 0 { continue }
        if string.startswith(line, "#") { continue }
        if string.startswith(line, "[") {
            section = string.strip(line, "[]")
            continue
        }
        let eq = string.find(line, "=")
        if eq < 0 { continue }
        let key = string.strip(line[:eq])
        let val = unquote(line[eq + 1:])
        if section == "project" and key == "name" {
            name = val
        } elif section == "cheatah" and key == "version" {
            cver = val
        } elif section == "cheatah" and key == "standard" {
            sver = val
        } elif section == "extensions" {
            exts.append(key)
        } elif section == "dependencies" {
            # `name = { path = "../pkg" }` (or `name = "../pkg"`) -> a path dependency that
            # purrc resolves imports from (passed through CMake as --import-root).
            deps.append(Dep(key, dep_path(line[eq + 1:])))
        }
    }
    return Manifest(name, cver, sver, exts, deps)
}

# Load the manifest in the current project (cwd). Callers that need a project must guard
# with require_project() first; `read_manifest_at` reads a manifest at an explicit path.
fn load_manifest() {
    return read_manifest_at(manifest_path())
}

# Render a Manifest as cheatah.toml text — the single serializer, so `init` and every
# later edit produce the identical shape.
fn manifest_text(m) {
    let s = "# cheatah project manifest — managed by biome.\n\n"
    s = s + "[project]\n"
    s = s + "name = \"" + m.name + "\"\n\n"
    s = s + "[cheatah]\n"
    s = s + "# The Biome Standard: one version naming the toolchain + extension releases\n"
    s = s + "# tested to work together. `biome standards` lists the known sets.\n"
    s = s + "standard = \"" + m.standard + "\"\n"
    if len(m.cheatah) > 0 {
        # A manual toolchain override — kept verbatim; the standard covers everything else.
        s = s + "version = \"" + m.cheatah + "\"\n"
    }
    s = s + "\n[extensions]\n"
    if len(m.extensions) > 0 {
        s = s + "# Managed by the Biome Standard above — values are the resolved release tags.\n"
    }
    let si = standard_index(m.standard)
    for e in m.extensions {
        let tag = ""
        if si >= 0 { tag = component_tag(known_standards()[si], e) }
        s = s + e + " = \"" + tag + "\"\n"
    }
    s = s + "\n# Path dependencies — `import <name>` resolves under <path>.\n"
    s = s + "[dependencies]\n"
    for d in m.dependencies {
        s = s + d.name + " = { path = \"" + d.path + "\" }\n"
    }
    return s
}

# The cheatah.toml a fresh `biome init` writes (no extensions yet).
fn default_manifest(name) {
    let exts: list<str> = []
    let deps: list<Dep> = []
    return manifest_text(Manifest(name, "", default_standard(), exts, deps))
}

# Re-serialize a Manifest to cheatah.toml.
fn save_manifest(m) {
    write_file(manifest_path(), manifest_text(m))
}

# ---- generated files -------------------------------------------------------
# The CPM bootstrap: downloads a pinned CPM.cmake at configure time if absent.
# This is what makes "everything handled by CMake" true — CPM (a CMake module)
# fetches the cheatah toolchain and the chosen extensions.
fn template_cpm() {
    let v = "0.40.2"
    let s = "# Auto-downloads CPM.cmake (the CMake package manager) — managed by biome.\n"
    s = s + "set(CPM_DOWNLOAD_VERSION " + v + ")\n"
    s = s + "set(CPM_DOWNLOAD_LOCATION \"${CMAKE_BINARY_DIR}/cmake/CPM_${CPM_DOWNLOAD_VERSION}.cmake\")\n"
    s = s + "if(NOT EXISTS \"${CPM_DOWNLOAD_LOCATION}\")\n"
    s = s + "  message(STATUS \"biome: downloading CPM.cmake v${CPM_DOWNLOAD_VERSION}\")\n"
    s = s + "  file(DOWNLOAD\n"
    s = s + "    https://github.com/cpm-cmake/CPM.cmake/releases/download/v${CPM_DOWNLOAD_VERSION}/CPM.cmake\n"
    s = s + "    \"${CPM_DOWNLOAD_LOCATION}\")\n"
    s = s + "endif()\n"
    s = s + "include(\"${CPM_DOWNLOAD_LOCATION}\")\n"
    return s
}

# A hello-world starter program for a fresh project.
fn template_main(name) {
    let s = "# " + name + " — a cheatah program.\n"
    s = s + "import io\n"
    s = s + "import sys\n\n"
    s = s + "io.print(\"hello from " + name + "!\")\n"
    s = s + "if len(sys.argv) > 1 {\n"
    s = s + "    io.print(\"args:\", sys.argv[1:])\n"
    s = s + "}\n"
    return s
}

fn template_gitignore() {
    let s = "build/\n"
    s = s + "*.gen.cpp\n"
    # Ignore compiled loadable modules for every platform (a repo may be shared across them).
    s = s + "*.so\n"
    s = s + "*.dylib\n"
    s = s + "*.dll\n"
    return s
}

# Validate a manifest against the Biome Standard table before anything is generated:
# the standard must be one this biome knows, and every chosen extension must be a member
# of that standard (i.e. actually tested with the set). Prints the reason on failure.
fn validate_manifest(m) {
    let si = standard_index(m.standard)
    if si < 0 {
        io.print("biome: unknown Biome Standard:", m.standard)
        io.print("       this biome (" + biome_version() + ") knows up to", default_standard(), "— run `biome standards`,")
        io.print("       or update the cheatah toolchain to get a newer biome")
        return false
    }
    let s = known_standards()[si]
    for e in m.extensions {
        if len(component_tag(s, e)) == 0 {
            io.print("biome:", e, "is not a member of Biome Standard", m.standard)
            io.print("       (it has not been tested with this set; `biome standards` shows members)")
            return false
        }
    }
    return true
}

# The toolchain git tag a manifest resolves to: the manual [cheatah] version override
# when present, otherwise the standard's cheatah tag. Callers validate first.
fn toolchain_tag(m) {
    if len(m.cheatah) > 0 { return "v" + m.cheatah }
    return component_tag(known_standards()[standard_index(m.standard)], "cheatah")
}

# Generate the project CMakeLists.txt from the manifest. It pulls in the cheatah
# toolchain via CPM, then each chosen extension — every GIT_TAG resolved from the
# project's Biome Standard — then uses cheatah's own CheatahProgram helper to compile
# src/main.purr into a native executable. Callers run validate_manifest(m) first.
fn generate_cmake(m) {
    let std = known_standards()[standard_index(m.standard)]
    let s = "# Generated by biome from cheatah.toml — do not edit by hand.\n"
    s = s + "# Re-run `biome build` (or `biome add`/`biome remove`) to regenerate.\n"
    s = s + "# Component tags resolved from Biome Standard " + std.version + ".\n"
    s = s + "cmake_minimum_required(VERSION 3.24)\n"
    s = s + "project(" + m.name + " LANGUAGES CXX)\n"
    s = s + "set(CMAKE_CXX_STANDARD 20)\n\n"
    s = s + "include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/CPM.cmake)\n\n"
    s = s + "# The cheatah language toolchain (purrc + runtime + stdlib).\n"
    s = s + "CPMAddPackage(NAME cheatah GITHUB_REPOSITORY " + github_owner() + "/cheatah GIT_TAG " + toolchain_tag(m) + ")\n\n"
    if len(m.extensions) > 0 {
        s = s + "# Optional standard-library extensions chosen in cheatah.toml.\n"
        for e in m.extensions {
            s = s + "CPMAddPackage(NAME " + e + " GITHUB_REPOSITORY " + extension_repo(e) + " GIT_TAG " + component_tag(std, e) + ")\n"
        }
        s = s + "\n"
    }
    s = s + "# cheatah_add_program(): compile src/main.purr to a module + a launcher.\n"
    s = s + "include(${cheatah_SOURCE_DIR}/cmake/CheatahProgram.cmake)\n\n"
    s = s + "cheatah_add_program(" + m.name + " SOURCES src/main.purr"
    if len(m.extensions) > 0 {
        s = s + " EXTENSIONS"
        for e in m.extensions {
            s = s + " " + e
        }
    }
    if len(m.dependencies) > 0 {
        # Each path dependency becomes an --import-root so purrc resolves its modules.
        s = s + " IMPORT_ROOTS"
        for d in m.dependencies {
            s = s + " " + d.path
        }
    }
    s = s + ")\n"
    return s
}

# ---- commands --------------------------------------------------------------
fn require_project() {
    if os.path.exists(manifest_path()) {
        return true
    }
    io.print("biome: no cheatah.toml in", os.getcwd())
    io.print("       run `biome init <name>` to create a project")
    return false
}

fn cmd_init(name) {
    if os.path.exists(name) {
        io.print("biome: path already exists:", name)
        return 1
    }
    os.makedirs(os.path.join(name, "src"))
    os.makedirs(os.path.join(name, "cmake"))

    let exts: list<str> = []
    let deps: list<Dep> = []
    let m = Manifest(name, "", default_standard(), exts, deps)

    write_file(os.path.join(name, "cheatah.toml"), default_manifest(name))
    write_file(os.path.join(name, os.path.join("src", "main.purr")), template_main(name))
    write_file(os.path.join(name, os.path.join("cmake", "CPM.cmake")), template_cpm())
    write_file(os.path.join(name, "CMakeLists.txt"), generate_cmake(m))
    write_file(os.path.join(name, ".gitignore"), template_gitignore())

    io.print("biome: created project", name)
    io.print("  next:  cd", name)
    io.print("         biome add cheatah-gpu    # optional")
    io.print("         biome configure")
    io.print("         biome build")
    io.print("         cheatah build/" + name + os.module_ext() + "   # run it with the cheatah runtime")
    return 0
}

fn cmd_add(name) {
    if not require_project() { return 1 }
    if not is_known_extension(name) {
        io.print("biome: unknown extension:", name)
        io.print("       run `biome list` to see available extensions")
        return 1
    }
    let m = load_manifest()
    if list_contains(m.extensions, name) {
        io.print("biome: already added:", name)
        return 0
    }
    m.extensions.append(name)
    if not validate_manifest(m) { return 1 }
    save_manifest(m)
    write_file("CMakeLists.txt", generate_cmake(m))
    let si = standard_index(m.standard)
    let tag = component_tag(known_standards()[si], name)
    io.print("biome: added", name, tag, "—", extension_desc(name))
    io.print("       (from Biome Standard " + m.standard + ")")
    io.print("       run `biome configure` then `biome build` to fetch and build it")
    return 0
}

fn cmd_remove(name) {
    if not require_project() { return 1 }
    let m = load_manifest()
    if not list_contains(m.extensions, name) {
        io.print("biome: not in this project:", name)
        return 0
    }
    let kept: list<str> = []
    for e in m.extensions {
        if e != name {
            kept.append(e)
        }
    }
    let updated = Manifest(m.name, m.cheatah, m.standard, kept, m.dependencies)
    if not validate_manifest(updated) { return 1 }
    save_manifest(updated)
    write_file("CMakeLists.txt", generate_cmake(updated))
    io.print("biome: removed", name)
    return 0
}

fn cmd_list(dir) {
    # `list` is project-scoped: biome is a per-project virtual environment, so it shows
    # nothing unless it is pointed at a directory that actually holds a cheatah.toml.
    # This keeps the extension picture tied to a concrete, hermetic project rather than a
    # global, ambient registry view.
    let path = os.path.join(dir, manifest_path())
    if not os.path.exists(path) {
        io.print("biome: no cheatah.toml in", dir)
        io.print("       `biome list` only works inside a cheatah project.")
        io.print("       run `biome init <name>`, or point it at a project: `biome list <dir>`")
        return 1
    }
    let m = read_manifest_at(path)
    io.print("extensions for project '" + m.name + "' (" + dir + ", Biome Standard " + m.standard + "):")
    let si = standard_index(m.standard)
    for e in known_extensions() {
        let mark = "  "
        if list_contains(m.extensions, e) {
            mark = "* "
        }
        let tag = ""
        if si >= 0 { tag = component_tag(known_standards()[si], e) }
        if len(tag) == 0 { tag = "(not in this standard)" }
        io.print(mark + string.ljust(e, 20) + string.ljust(tag, 24) + extension_desc(e))
    }
    io.print("")
    io.print("(* = used by this project; `biome add <name>` to add one)")
    return 0
}

# `biome standards [--emit-toml <ver>]` — list every Biome Standard this biome knows,
# newest last, with members and status. `--emit-toml` prints one standard in the
# canonical standards/*.toml form (used by scripts/check_standards.sh to detect drift
# between this table and the committed files).
fn cmd_standards() {
    if len(sys.argv) >= 4 and sys.argv[2] == "--emit-toml" {
        let i = standard_index(sys.argv[3])
        if i < 0 {
            io.print("biome: unknown Biome Standard:", sys.argv[3])
            return 1
        }
        # io.print terminates with exactly one newline, so stripping the trailing one
        # from the rendered text reproduces the standards/*.toml bytes on stdout.
        io.print(string.rstrip(emit_standard_toml(known_standards()[i]), "\n"))
        return 0
    }
    io.print("Biome Standards known to this biome (" + biome_version() + "):")
    io.print("")
    for s in known_standards() {
        let mark = "  "
        if s.version == default_standard() { mark = "* " }
        io.print(mark + s.version + "  (" + s.status + ", released " + s.released + ")")
        for c in s.components {
            io.print("    " + string.ljust(c.name, 20) + c.tag)
        }
    }
    io.print("")
    io.print("(* = newest; a project pins one via `standard = \"<ver>\"` in cheatah.toml)")
    io.print("Older standards stay selectable and their sources stay archived; one is only")
    io.print("ever deprecated for a security flaw we could not patch.")
    return 0
}

# `biome configure` — the CMake *configure* step, on its own. Regenerates CMakeLists.txt
# from the manifest (so the two never drift), then runs `cmake -S . -B build`, where CPM
# fetches the pinned cheatah toolchain + chosen extensions into this project's own build
# tree. Nothing is compiled yet.
fn cmd_configure() {
    if not require_project() { return 1 }
    let m = load_manifest()
    if not validate_manifest(m) { return 1 }
    write_file("CMakeLists.txt", generate_cmake(m))
    io.print("biome: configuring (cmake -S . -B build)")
    let rc = os.system("cmake -S . -B build")
    if rc != 0 {
        io.print("biome: cmake configure failed")
        return 1
    }
    io.print("biome: configured -> build/  (now run `biome build`)")
    return 0
}

# `biome build [--clean-first]` — the CMake *build* step, on its own. Requires a prior
# `biome configure` (a `build/` tree). `--clean-first` maps to `cmake --build build
# --clean-first` (a from-scratch rebuild). biome never RUNS the result — see the note below.
fn cmd_build(clean_first) {
    if not require_project() { return 1 }
    let m = load_manifest()
    if not os.path.exists("build") {
        io.print("biome: project not configured — run `biome configure` first")
        return 1
    }
    let cmd = "cmake --build build"
    if clean_first {
        cmd = cmd + " --clean-first"
    }
    io.print("biome:", cmd)
    let brc = os.system(cmd)
    if brc != 0 {
        io.print("biome: build failed")
        return 1
    }
    # biome builds; it does NOT run your program. A cheatah program is a loadable module,
    # run by the cheatah runtime — always explicitly, so it is unambiguous what executes.
    let modpath = os.path.join("build", m.name) + os.module_ext()
    io.print("biome: built", modpath)
    io.print("       run it with the cheatah runtime:  cheatah " + modpath)
    return 0
}

fn cmd_help() {
    io.print("biome — the cheatah package manager")
    io.print("")
    io.print("usage: biome <command> [args]")
    io.print("")
    io.print("commands:")
    io.print("  init <name>     scaffold a new cheatah project")
    io.print("  add <ext>       add an optional standard-library extension")
    io.print("  remove <ext>    remove an extension")
    io.print("  list [dir]      list the extensions used by the project at <dir> (default: .)")
    io.print("  standards       list the Biome Standards (tested-together component sets)")
    io.print("  configure       regenerate CMakeLists.txt and run the CMake configure")
    io.print("  build           build the configured project (add --clean-first to rebuild)")
    io.print("  version         print the biome version")
    io.print("  help            show this message")
    io.print("")
    io.print("biome builds; it never runs your code. run a built program with the cheatah")
    io.print("runtime:  cheatah build/<name>" + os.module_ext())
    return 0
}

# ---- dispatch --------------------------------------------------------------
fn need_arg(cmd) {
    if len(sys.argv) < 3 {
        io.print("biome:", cmd, "needs an argument")
        return false
    }
    return true
}

fn run() {
    if len(sys.argv) < 2 {
        cmd_help()
        return 1
    }
    let cmd = sys.argv[1]
    if cmd == "init" {
        if not need_arg("init") { return 1 }
        return cmd_init(sys.argv[2])
    } elif cmd == "add" {
        if not need_arg("add") { return 1 }
        return cmd_add(sys.argv[2])
    } elif cmd == "remove" {
        if not need_arg("remove") { return 1 }
        return cmd_remove(sys.argv[2])
    } elif cmd == "list" {
        let dir = "."
        if len(sys.argv) >= 3 { dir = sys.argv[2] }
        return cmd_list(dir)
    } elif cmd == "standards" {
        return cmd_standards()
    } elif cmd == "configure" {
        return cmd_configure()
    } elif cmd == "build" {
        let clean = false
        if len(sys.argv) >= 3 and sys.argv[2] == "--clean-first" { clean = true }
        return cmd_build(clean)
    } elif cmd == "version" or cmd == "--version" or cmd == "-v" {
        io.print("biome", biome_version())
        return 0
    } elif cmd == "help" or cmd == "--help" or cmd == "-h" {
        return cmd_help()
    } else {
        io.print("biome: unknown command:", cmd)
        cmd_help()
        return 1
    }
}

run()
