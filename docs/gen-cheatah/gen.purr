# Original work; see ACKNOWLEDGMENTS.md for the open-source ideas we build upon.
# gen.purr — the cheatah docs site generator, in pure cheatah. 🐆
#
# Began as the 1:1 port of docs/gen/generate.py. That file is now a historical
# reference only — it has diverged (no package switcher, no Biome Standard page,
# no extension subsites; 252 pages to this file's 297, every shared page different)
# and nothing checks the two against each other. THIS file is the authority, and
# the only generator anything runs. Reads the Doxygen XML in
# docs/xml/ and renders the site into docs/html/. Extensions render as their own
# SUBSITES under docs/html/<ext>/ (landing + releases + module pages), and
# docs/html/standard.html renders the Biome Standard — its member table imported
# straight from the package manager's own in-source table (pkg-manager/biome.purr,
# emitted as a library by docs/build-docs.sh), so the standards data has exactly
# one home. The site is ZERO-JS by design: it must work under a serving CSP of
# `default-src 'none'; style-src 'self'; img-src 'self'`, which forbids script
# execution entirely — search was removed for that reason, and the sidebar's
# active-link highlight + open dropdown chain are rendered server-side
# (mark_active) instead of by a client script. The ONE thing that looks like an
# exception and is not: `<script type="application/ld+json">`, the JSON-LD block
# page_shell_in emits. A non-JS `type` makes it a data block per the HTML spec —
# never compiled, never run, fetching nothing — so zero-JS still holds literally.
# scripts/a11y_check.purr exempts it by that exact name and fails every other
# <script>. Standing on our own stdlib:
#   parsers.xml  — the slab-DOM Doxygen XML reader (mixed text/element children)
#   parsers.html — escape() (byte-identical to Python's html.escape)
#   parsers.json — the typed reader for docs/perf_data.json (list-of-records)
#   hashlib      — the stylesheet's sha256 cache-busting query string (?v=…)
#   io.fixed     — printf-fixed float formatting for the perf rows
#   requests     — parse_uint for the joined-index bookkeeping
#   biome        — known_standards()/extension_desc(): the Biome Standard table
#
#   bash docs/build-docs.sh          # emits the biome library + compiles + runs this

import io
import os
import string
import sys
import hashlib
import requests
import parsers.xml
import parsers.html
import parsers.json
import biome

# ---------------------------------------------------------------------------
# Model structs
# ---------------------------------------------------------------------------

# docs/perf_data.json: {"meta": {...}, "functions": [record, ...]} — every record
# carries every field (parsers.json.read fills a struct; nothing is optional).
struct PerfMeta {
    cheatah_commit: str
    cpython: str
    generated: str
    machine: str
    numpy: str
}

struct PerfEntry {
    name: str
    kind: str
    note: str
    cheatah_ns: float
    compare_ns: float
    speedup: float
    vs: str
    cheatah_us: float
    numpy_us: float
    dims: str
    warn: str
    has_compare: bool
}

struct PerfData {
    meta: PerfMeta
    functions: list<PerfEntry>
}

# One documented symbol (ids index into its compound's parsers.xml Document; -1 = absent).
struct Member {
    id: str
    kind: str
    name: str
    args: str
    is_static: bool
    type_id: int
    brief_id: int
    detail_id: int
    compound: str
    srcfile: str
    srcline: str
}

# One page-producing compound (namespace / class / markdown page).
struct Compound {
    refid: str
    kind: str
    name: str
    short: str
    title: str
    brief_id: int
    detail_id: int
    members: list<Member>
    ext: str                       # owning extension name ("" = the stdlib)
}

# The generator's whole state (Documents are re-parsed per page — see doc_of).
struct Gen {
    comps: list<Compound>          # insertion order == index.xml order
    comp_idx: dict<str, int>       # refid -> index into comps
    mi: dict<str, str>             # member id -> owning compound refid
    modules: dict<str, str>        # module short name -> refid
    mod_short: dict<str, str>      # namespace refid -> dotted module name
    valid: dict<str, bool>         # refids/anchors that have a page/target
    src_map: dict<str, str>        # repo-relative source path -> source-page html name
    test_index: dict<str, str>     # "Suite.Name" -> path <US> line
    app_usage: dict<str, str>      # "module <US> func" -> <US>-joined sorted test names
    readme_key: dict<str, str>     # module short -> the README page's doc key (refid)
    readme_node: dict<str, int>    # module short -> detaileddescription node id
    bench_key: dict<str, str>      # module short -> its BENCHMARKS.md page's refid (the benchmark subpage)
    bench_node: dict<str, int>     # module short -> that page's detaileddescription node id
    bench_title: dict<str, str>    # module short -> that page's Doxygen title ("regex benchmarks")
    page_href: dict<str, str>      # page refid -> output file, when it is not <refid>.html
    missing_tests: dict<str, bool> # @test names no test source defines (reported at the end)
    page_by_file: dict<str, str>   # repo-relative markdown path -> its Doxygen page refid
    decl_files: dict<str, bool>    # every header that declares a documented member
    in_ext: bool                   # rendering an extension subsite page (their @test tags differ)
    classes_of: dict<str, str>     # owning module short -> <US>-joined class refids (sorted)
    perf: list<PerfEntry>
    perf_i: dict<str, int>         # "module.name" -> index into perf
    perf_numpy: str
    perf_cpython: str
    vers_css: str
    ext_names: list<str>           # extensions on the site (sorted xml-ext dirs) — one subsite each
    ext_deps: dict<str, str>       # ext -> <US>-joined extension deps from its manifest ("" = none)
    ext_toolchain: dict<str, str>  # ext -> the [cheatah] toolchain version its manifest targets
    ext_manifest: dict<str, bool>  # ext -> cheatah.toml present in the sibling checkout
    ext_classes: dict<str, str>    # ext<US>owner-short -> <US>-joined comp indices (classes/concepts)
    cur_module: str
    cur_func: str
    kw: dict<str, bool>            # cheatah (+ Python) keywords for the highlighter
    consts: dict<str, bool>
    cpp_kw: dict<str, bool>
    cpp_consts: dict<str, bool>
    block_tags: dict<str, bool>    # children of <para> that render block-level
    site_base: str                 # absolute origin+path the site is served at (see seo_head)
}

# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

# The unit separator (0x1f) — this file's stand-in for Python tuples/sets:
# composite dict keys and joined lists that can never collide with content.
fn us() { return chr(31) }

fn esc(s) { return parsers.html.escape(s) }

# ---------------------------------------------------------------------------
# The SEO head: canonical, description, robots
# ---------------------------------------------------------------------------
# These tags are injected at WRITE time rather than inside page_shell_in, because the only
# thing they need that the shell does not have is the page's own output path — and every
# write site already holds it, since mark_active takes the same filename. Threading a path
# and a description through nine render_* signatures to reach one string concatenation would
# be the worse trade.
#
# WHY A CANONICAL AT ALL. The serving host registers each page at two or three routes
# (`why.html` and `why`; `index.html`, `index` and `./`) so that no spelling ever 404s. That
# is right for readers and wrong for crawlers, which would otherwise count one page as three
# and divide whatever ranking it earns between them. The canonical names the one spelling
# that counts, and it must be ABSOLUTE — a relative canonical cannot express "the copy on
# the other host is the same page", which is the case it exists to handle.
#
# This is the one place the generator knows where it is served. Everything else is
# deliberately base-path-agnostic (every internal href is bare-relative), so the base lives
# in g.site_base, is set once in main(), and is overridable with DOCS_BASE_URL for a tree
# served somewhere else.

# Plain text from a rendered HTML fragment: drop the tags, unescape the entities, and squash
# runs of whitespace to single spaces. A description carrying markup is not merely ugly — the
# attribute would terminate at the first quote in the markup and spill the rest into the tag.
# @param s the HTML fragment.
# @return its text content, whitespace-normalised.
fn strip_tags(s) {
    let out = ""
    let depth = 0
    let i = 0
    while i < len(s) {
        let c = s[i:i + 1]
        if c == "<" {
            depth = depth + 1
        } elif c == ">" {
            if depth > 0 { depth = depth - 1 }
            out = out + " "
        } elif depth == 0 {
            out = out + c
        }
        i = i + 1
    }
    out = parsers.html.unescape(out)
    # Squash whitespace. Newlines and tabs inside a content="" attribute are legal but make
    # the generated HTML unreadable in a diff, which is how this file is reviewed.
    let flat = ""
    let sp = false
    i = 0
    while i < len(out) {
        let c = out[i:i + 1]
        if c == " " or c == "\n" or c == "\t" or c == "\r" {
            sp = true
        } else {
            if sp and len(flat) > 0 { flat = flat + " " }
            sp = false
            flat = flat + c
        }
        i = i + 1
    }
    return flat
}

# Clamp a description to `n` characters, cutting at a word boundary and adding an ellipsis.
# Search engines truncate around 155-160 characters; cutting here means WE choose where the
# sentence breaks instead of it being severed mid-word in the result listing.
# @param s the description text.
# @param n the budget.
# @return s, or a clamped copy ending in "…".
fn clamp_desc(s, n) {
    if len(s) <= n { return s }
    let cut = n
    let i = n
    while i > 0 {
        if s[i - 1:i] == " " { cut = i - 1; break }
        i = i - 1
    }
    if cut <= 0 { cut = n }
    return s[0:cut] + "…"
}

# The canonical URL for a page written to `rel` under `base`.
#
# The rule mirrors the serving host's: the `.html` suffix comes off (the pretty route is what
# the sitemap advertises), and a trailing `index` comes off too, because a directory's
# canonical form is the directory itself — the generated pages address every asset relatively,
# so only the slashed form resolves correctly anyway.
# @param base the site base, slash-terminated.
# @param rel the output path relative to docs/html ("why.html", "cheatah-plot/index.html").
# @return the absolute canonical URL.
fn canon_url(base, rel) {
    let path = rel
    if string.endswith(path, ".html") { path = path[0:len(path) - 5] }
    if path == "index" {
        path = ""
    } elif string.endswith(path, "/index") {
        path = path[0:len(path) - 5]
    }
    return base + path
}

# The head fragment: canonical, description, and optionally robots.
# @param g the generator state (for site_base).
# @param rel the output path relative to docs/html.
# @param desc the meta description, as plain text.
# @param noindex true to keep the page out of search results (it still passes links on).
# @return the tags, newline-terminated.
fn seo_head(g, rel, desc, noindex) {
    let out = "<link rel=\"canonical\" href=\"" + esc(canon_url(g.site_base, rel)) + "\">\n"
    if desc != "" {
        out = out + "<meta name=\"description\" content=\"" + esc(clamp_desc(desc, 155)) + "\">\n"
    }
    if noindex { out = out + "<meta name=\"robots\" content=\"noindex, follow\">\n" }
    return out
}

# Splice seo_head into a rendered page, immediately before </head>.
# @param page the rendered page.
# @param g the generator state.
# @param rel the output path relative to docs/html.
# @param desc the meta description, as plain text.
# @param noindex true to keep the page out of search results.
# @return the page with the tags inserted, or unchanged if it has no </head>.
fn with_seo(page, g, rel, desc, noindex) {
    let at = string.find(page, "</head>", 0)
    if at < 0 { return page }
    return page[0:at] + seo_head(g, rel, desc, noindex) + page[at:]
}

# A page description from its rendered brief, falling back when Doxygen gave us nothing.
# @param brief_html the rendered brief (may be "").
# @param fallback the description to use when the brief is empty.
# @return plain-text description text.
fn desc_or(brief_html, fallback) {
    let t = strip_tags(brief_html)
    if t == "" { return fallback }
    return t
}

fn spaces(n) {
    let out = ""
    let i = 0
    while i < n {
        out = out + " "
        i = i + 1
    }
    return out
}

fn list_contains(xs, v) {
    for x in xs {
        if x == v { return true }
    }
    return false
}

# Insertion sort, ascending bytewise (== Python's codepoint order for UTF-8), stable.
fn sorted_strs(xs) {
    let out: list<str> = []
    for x in xs { out.append(x) }
    let i = 1
    while i < len(out) {
        let j = i
        while j > 0 and out[j - 1] > out[j] {
            let tmp = out[j - 1]
            out[j - 1] = out[j]
            out[j] = tmp
            j = j - 1
        }
        i = i + 1
    }
    return out
}

# Python's `{v:g}` for a value already rounded to one decimal: fixed(v, 1) with a
# bare trailing ".0" stripped ("12.0" -> "12", "12.3" stays).
fn strip_g(s) {
    if string.endswith(s, ".0") { return s[:len(s) - 2] }
    return s
}

fn fmt_g1(x) { return strip_g(io.fixed(x, 1)) }

fn fmt_ns(ns) {
    if ns < 100.0 { return io.fixed(ns, 2) + " ns/call" }
    return io.fixed(ns, 0) + " ns/call"
}

fn fmt_us(v) {
    if v < 100.0 { return io.fixed(v, 2) + " µs/op" }
    return io.fixed(v, 0) + " µs/op"
}

# Byte classes for the token scanners (\w == [A-Za-z0-9_], all ASCII — multibyte
# UTF-8 bytes are >= 0x80 and land in "other", exactly like Python's tokenizer
# treats the site's ×/≈/µ glyphs).
fn is_word_b(b) {
    if b >= 48 and b <= 57 { return true }
    if b >= 65 and b <= 90 { return true }
    if b >= 97 and b <= 122 { return true }
    return b == 95
}

fn is_digit_b(b) { return b >= 48 and b <= 57 }

fn is_alpha_b(b) {
    if b >= 65 and b <= 90 { return true }
    return b >= 97 and b <= 122
}

fn is_space_b(b) {
    if b == 32 or b == 9 or b == 10 or b == 13 { return true }
    return b == 11 or b == 12
}

fn byte_at(s, i) -> int {
    if i < 0 or i >= len(s) { return -1 }
    return ord(s[i:i + 1])
}

# ---------------------------------------------------------------------------
# Syntax highlighting — the hand tokenizers (they mirror generate.py's regexes,
# which are that generator's own logic too; everything reusable is stdlib).
# ---------------------------------------------------------------------------

# `"(?:\\.|[^"\\\n])*"` — a quoted string with backslash escapes, single line.
# Returns the index one past the closing quote, or -1 when unterminated.
fn string_token_end(text, i) {
    let q = byte_at(text, i)
    let j = i + 1
    while j < len(text) {
        let b = byte_at(text, j)
        if b == 92 {                       # backslash: skip the escaped char
            if j + 1 >= len(text) { return -1 }
            j = j + 2
        } else {
            if b == q { return j + 1 }
            if b == 10 { return -1 }
            j = j + 1
        }
    }
    return -1
}

# `\b\d+\.?\d*(?:[eE][+-]?\d+)?\b` with regex-faithful backtracking on the
# trailing \b (a boundary: word-ness differs across the match's end). Returns
# the end index of the number token, or -1.
fn number_token_end(text, i, allow_suffix) {
    if not is_digit_b(byte_at(text, i)) { return -1 }
    if is_word_b(byte_at(text, i - 1)) { return -1 }    # leading \b
    let d1 = i
    while is_digit_b(byte_at(text, d1)) { d1 = d1 + 1 }         # \d+ (greedy)
    let candidates: list<int> = []
    let has_dot = byte_at(text, d1) == 46
    let d2 = d1
    if has_dot {
        d2 = d1 + 1
        while is_digit_b(byte_at(text, d2)) { d2 = d2 + 1 }     # \d* (greedy)
    }
    # exponent after the dot-form (present first, then absent), then dot-form
    # shrinking \d* toward the dot, then the bare \d+ form. That is the regex's
    # backtracking order; the first end passing the trailing \b wins.
    if has_dot {
        let k = d2
        while k >= d1 + 1 {
            let eb = byte_at(text, k)
            if eb == 101 or eb == 69 {
                let e2 = k + 1
                let sb = byte_at(text, e2)
                if sb == 43 or sb == 45 { e2 = e2 + 1 }
                let e3 = e2
                while is_digit_b(byte_at(text, e3)) { e3 = e3 + 1 }
                if e3 > e2 { candidates.append(e3) }
            }
            candidates.append(k)
            k = k - 1
        }
    }
    let eb = byte_at(text, d1)
    if eb == 101 or eb == 69 {
        let e2 = d1 + 1
        let sb = byte_at(text, e2)
        if sb == 43 or sb == 45 { e2 = e2 + 1 }
        let e3 = e2
        while is_digit_b(byte_at(text, e3)) { e3 = e3 + 1 }
        if e3 > e2 { candidates.append(e3) }
    }
    candidates.append(d1)
    for cand in candidates {
        let stop = cand
        if allow_suffix {                   # C++: (?:[uUlLfF]+)? before the \b
            while true {
                let sb = byte_at(text, stop)
                if sb == 117 or sb == 85 or sb == 108 or sb == 76 or sb == 102 or sb == 70 {
                    stop = stop + 1
                } else { break }
            }
        }
        # trailing \b: last matched byte vs next byte — exactly one side a word char.
        let last_w = is_word_b(byte_at(text, stop - 1))
        let next_w = is_word_b(byte_at(text, stop))
        if last_w != next_w { return stop }
        if allow_suffix and stop != cand {  # suffix form failed; also try without it
            let lw = is_word_b(byte_at(text, cand - 1))
            let nw = is_word_b(byte_at(text, cand))
            if lw != nw { return cand }
        }
    }
    return -1
}

# Identifier continuation with Python's Unicode \w semantics for the one class
# the corpus contains: subscript digits (U+2080-U+2089, e.g. log₂ in math.hpp).
fn word_end(text, j) -> int {
    let k = j
    while true {
        if is_word_b(byte_at(text, k)) {
            k = k + 1
        } elif byte_at(text, k) == 226 and byte_at(text, k + 1) == 130 and byte_at(text, k + 2) >= 128 and byte_at(text, k + 2) <= 137 {
            k = k + 3
        } else {
            break
        }
    }
    return k
}

fn wrap_tok(cls, val) { return "<span class=\"tok-" + cls + "\">" + esc(val) + "</span>" }

# The cheatah/`#`-comment tokenizer (generate.py's highlight_code / _TOKEN_RE).
fn highlight_code(g, text) {
    let out = ""
    let i = 0
    while i < len(text) {
        let b = byte_at(text, i)
        if b == 35 {                                    # '#' comment to end of line
            let e = string.find(text[i:], "\n")
            let stop = len(text)
            if e >= 0 { stop = i + e }
            out = out + wrap_tok("com", text[i:stop])
            i = stop
        } elif b == 64 and is_alpha_b(byte_at(text, i + 1)) {   # @tag
            let j = word_end(text, i + 1)
            out = out + wrap_tok("doc", text[i:j])
            i = j
        } elif b == 34 or b == 39 {                     # string
            let e = string_token_end(text, i)
            if e >= 0 {
                out = out + wrap_tok("str", text[i:e])
                i = e
            } else {
                out = out + esc(text[i:i + 1])
                i = i + 1
            }
        } else {
            let ne = number_token_end(text, i, false)
            if ne >= 0 {
                out = out + wrap_tok("num", text[i:ne])
                i = ne
            } elif is_alpha_b(b) or b == 95 {           # identifier / keyword
                let j = word_end(text, i + 1)
                let word = text[i:j]
                if word in g.kw {
                    out = out + wrap_tok("kw", word)
                } elif word in g.consts {
                    out = out + wrap_tok("const", word)
                } elif byte_at(text, j) == 40 {         # call site: next char '('
                    out = out + wrap_tok("fn", word)
                } else {
                    out = out + esc(word)
                }
                i = j
            } else {
                out = out + esc(text[i:i + 1])
                i = i + 1
            }
        }
    }
    return out
}

# A C++ preprocessor line: `#include <…>`, `#define NAME …` (generate.py's _CPP_PRE_RE).
fn highlight_cpp_pre(text) {
    let out = ""
    let i = 0
    while i < len(text) {
        let b = byte_at(text, i)
        if b == 35 {                                    # `#\s*directive`
            let j = i + 1
            while is_space_b(byte_at(text, j)) { j = j + 1 }
            let k = j
            while is_word_b(byte_at(text, k)) { k = k + 1 }
            if k > j and (is_alpha_b(byte_at(text, j)) or byte_at(text, j) == 95) {
                out = out + wrap_tok("kw", text[i:k])
                i = k
                continue
            }
            out = out + esc(text[i:i + 1])
            i = i + 1
        } elif b == 60 {                                # <header> include target
            let seg = text[i:]
            let e = string.find(seg, ">")
            let nl = string.find(seg, "\n")
            if e > 0 and (nl < 0 or e < nl) {
                out = out + wrap_tok("str", text[i:i + e + 1])
                i = i + e + 1
            } else {
                out = out + esc(text[i:i + 1])
                i = i + 1
            }
        } elif b == 34 {                                # string
            let e = string_token_end(text, i)
            if e >= 0 {
                out = out + wrap_tok("str", text[i:e])
                i = e
            } else {
                out = out + esc(text[i:i + 1])
                i = i + 1
            }
        } else {
            out = out + esc(text[i:i + 1])
            i = i + 1
        }
    }
    return out
}

# The C++ tokenizer (generate.py's _highlight_cpp_line / _CPP_TOKEN_RE).
fn highlight_cpp_line(g, text) {
    if string.startswith(string.lstrip(text), "#") { return highlight_cpp_pre(text) }
    let out = ""
    let i = 0
    while i < len(text) {
        let b = byte_at(text, i)
        if b == 47 and byte_at(text, i + 1) == 47 {     # // comment
            let e = string.find(text[i:], "\n")
            let stop = len(text)
            if e >= 0 { stop = i + e }
            out = out + wrap_tok("com", text[i:stop])
            i = stop
        } elif b == 64 and is_alpha_b(byte_at(text, i + 1)) {
            let j = word_end(text, i + 1)
            out = out + wrap_tok("doc", text[i:j])
            i = j
        } elif b == 34 or b == 39 {
            let e = string_token_end(text, i)
            if e >= 0 {
                out = out + wrap_tok("str", text[i:e])
                i = e
            } else {
                out = out + esc(text[i:i + 1])
                i = i + 1
            }
        } else {
            let ne = number_token_end(text, i, true)
            if ne >= 0 {
                out = out + wrap_tok("num", text[i:ne])
                i = ne
            } elif is_alpha_b(b) or b == 95 {
                let j = word_end(text, i + 1)
                let word = text[i:j]
                if word in g.cpp_kw {
                    out = out + wrap_tok("kw", word)
                } elif word in g.cpp_consts {
                    out = out + wrap_tok("const", word)
                } elif text[j:j + 2] == "::" {          # namespace/type qualifier
                    out = out + wrap_tok("ns", word)
                } elif byte_at(text, j) == 40 {
                    out = out + wrap_tok("fn", word)
                } else {
                    out = out + esc(word)
                }
                i = j
            } else {
                out = out + esc(text[i:i + 1])
                i = i + 1
            }
        }
    }
    return out
}

fn highlight_block(g, text, lang) {
    let out = ""
    let sep = ""
    for line in string.split(text, "\n") {
        if lang == "cpp" {
            out = out + sep + highlight_cpp_line(g, line)
        } else {
            out = out + sep + highlight_code(g, line)
        }
        sep = "\n"
    }
    return out
}

# ---------------------------------------------------------------------------
# Verdict coloring + SIDEBYSIDE (generate.py's _color_verdict / apply_sidebyside)
# ---------------------------------------------------------------------------

# Match `[\d.]+×` starting at i; returns the end (past ×) or -1.
fn digits_x_end(text, i) {
    let j = i
    while is_digit_b(byte_at(text, j)) or byte_at(text, j) == 46 { j = j + 1 }
    if j == i { return -1 }
    if text[j:j + 2] == "×" { return j + 2 }            # × is 2 UTF-8 bytes
    return -1
}

# One "up" alternative at position i: `cheatah\s+[\d.]+×` | `≈?[\d.]+×\s+faster`.
fn verdict_up_end(text, i) {
    if text[i:i + 7] == "cheatah" {
        let j = i + 7
        let k = j
        while is_space_b(byte_at(text, k)) { k = k + 1 }
        if k > j {
            let e = digits_x_end(text, k)
            if e >= 0 { return e }
        }
    }
    let j = i
    if text[i:i + 3] == "≈" { j = i + 3 }               # ≈ is 3 UTF-8 bytes
    let e = digits_x_end(text, j)
    if e >= 0 {
        let k = e
        while is_space_b(byte_at(text, k)) { k = k + 1 }
        if k > e and text[k:k + 6] == "faster" { return k + 6 }
    }
    return -1
}

# `NumPy\s+[\d.]+×` | `Eigen\s+[\d.]+×` | `≈?[\d.]+×\s+slower`
fn verdict_down_end(text, i) {
    if text[i:i + 5] == "NumPy" or text[i:i + 5] == "Eigen" {
        let j = i + 5
        let k = j
        while is_space_b(byte_at(text, k)) { k = k + 1 }
        if k > j {
            let e = digits_x_end(text, k)
            if e >= 0 { return e }
        }
    }
    let j = i
    if text[i:i + 3] == "≈" { j = i + 3 }
    let e = digits_x_end(text, j)
    if e >= 0 {
        let k = e
        while is_space_b(byte_at(text, k)) { k = k + 1 }
        if k > e and text[k:k + 6] == "slower" { return k + 6 }
    }
    return -1
}

fn color_verdict(inner) {
    # up pass, then down pass over its result — the down patterns cannot match
    # inside an inserted perf-faster span, mirroring the Python sub order.
    let mid = ""
    let i = 0
    while i < len(inner) {
        let e = verdict_up_end(inner, i)
        if e >= 0 {
            mid = mid + "<span class=\"perf-faster\">" + inner[i:e] + "</span>"
            i = e
        } else {
            mid = mid + inner[i:i + 1]
            i = i + 1
        }
    }
    let out = ""
    i = 0
    while i < len(mid) {
        let e = verdict_down_end(mid, i)
        if e >= 0 {
            out = out + "<span class=\"perf-slower\">" + mid[i:e] + "</span>"
            i = e
        } else {
            out = out + mid[i:i + 1]
            i = i + 1
        }
    }
    return out
}

fn sxs_pane(label, code) {
    return "<figure class=\"xpile-pane\">" + code + "<figcaption>" + "<span class=\"fname\">" + esc(label) + "</span></figcaption></figure>"
}

# `<p>SIDEBYSIDE: left | right</p>` + two fenced code blocks -> a two-column grid
# (generate.py's _SXS_RE, hand-matched: same anchors, same lazy "first end" scans).
fn apply_sidebyside(content) {
    let out = ""
    let pos = 0
    while true {
        let m = string.find(content[pos:], "SIDEBYSIDE:")
        if m < 0 { break }
        let mark = pos + m
        # the enclosing <p> must precede with only whitespace between
        let p_open = string.rfind(content[:mark], "<p>")
        let ok = p_open >= 0
        if ok { ok = string.strip(content[p_open + 3:mark]) == "" }
        let p_close = string.find(content[mark:], "</p>")
        if ok and p_close >= 0 {
            let inner = content[mark + 11:mark + p_close]      # after "SIDEBYSIDE:"
            let bar = string.find(inner, "|")
            let lt = string.find(inner, "<")
            if bar > 0 and lt < 0 {
                let left = string.strip(inner[:bar])
                let right = string.strip(inner[bar + 1:])
                # two <pre class="code"><code>…</code></pre> blocks, whitespace apart
                let scan = mark + p_close + 4
                while is_space_b(byte_at(content, scan)) { scan = scan + 1 }
                if string.startswith(content[scan:], "<pre class=\"code\"><code>") {
                    let e1 = string.find(content[scan:], "</code></pre>")
                    if e1 >= 0 {
                        let end1 = scan + e1 + 13
                        let scan2 = end1
                        while is_space_b(byte_at(content, scan2)) { scan2 = scan2 + 1 }
                        if string.startswith(content[scan2:], "<pre class=\"code\"><code>") {
                            let e2 = string.find(content[scan2:], "</code></pre>")
                            if e2 >= 0 {
                                let end2 = scan2 + e2 + 13
                                out = out + content[pos:p_open] + "<div class=\"xpile\">" + sxs_pane(left, content[scan:end1]) + sxs_pane(right, content[scan2:end2]) + "</div>"
                                pos = end2
                                continue
                            }
                        }
                    }
                }
            }
        }
        out = out + content[pos:mark + 11]
        pos = mark + 11
    }
    return out + content[pos:]
}

# ---------------------------------------------------------------------------
# Test scrapers (generate.py's TEST_RE / _CALL_RE — our regex module has no
# capture groups, and these scrapers are the generator's own logic on both sides)
# ---------------------------------------------------------------------------

# First `TEST(Suite, Name)` / `TEST_F` / `TEST_P` in a line -> "Suite<US>Name" or "".
fn find_test_in_line(line) {
    let pos = 0
    while true {
        let m = string.find(line[pos:], "TEST")
        if m < 0 { return "" }
        let i = pos + m
        pos = i + 4
        if is_word_b(byte_at(line, i - 1)) { continue }         # \b before TEST
        let j = i + 4
        if line[j:j + 2] == "_F" or line[j:j + 2] == "_P" { j = j + 2 }
        if is_word_b(byte_at(line, j)) { continue }             # TESTX / TEST_Foo
        let k = j
        while is_space_b(byte_at(line, k)) { k = k + 1 }
        if byte_at(line, k) != 40 { continue }
        k = k + 1
        while is_space_b(byte_at(line, k)) { k = k + 1 }
        let s0 = k
        while is_word_b(byte_at(line, k)) { k = k + 1 }
        if k == s0 { continue }
        let suite = line[s0:k]
        while is_space_b(byte_at(line, k)) { k = k + 1 }
        if byte_at(line, k) != 44 { continue }
        k = k + 1
        while is_space_b(byte_at(line, k)) { k = k + 1 }
        let n0 = k
        while is_word_b(byte_at(line, k)) { k = k + 1 }
        if k == n0 { continue }
        let cname = line[n0:k]
        while is_space_b(byte_at(line, k)) { k = k + 1 }
        if byte_at(line, k) != 41 { continue }
        return suite + us() + cname
    }
    return ""
}

# The benchmark subpage of a module. stdlib/<mod>/BENCHMARKS.md renders as its own page and
# the module page links to it: the generated tables (a hundred rows and more for regex,
# fixarray and linalg) used to be folded into the reference and swamped it.
fn bench_page_name(mod) { return "benchmarks-" + string.replace(mod, "::", ".") + ".html" }

fn src_page_name(rel_path) {
    let out = "src_"
    let i = 0
    while i < len(rel_path) {
        let b = byte_at(rel_path, i)
        if is_word_b(b) and b != 95 {
            out = out + rel_path[i:i + 1]
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    return out + ".html"
}

# ---------------------------------------------------------------------------
# Description rendering
# ---------------------------------------------------------------------------

# ElementTree `findtext(tag)` semantics: the child's text BEFORE its first
# element child (its leading text node), not the full descendant text.
fn first_text(doc, id) {
    for c in parsers.xml.children(doc, id) {
        if parsers.xml.is_element(doc, c) { return "" }
        return parsers.xml.text(doc, c)
    }
    return ""
}

# Doxygen encodes every space in code as <sp/>; expand them back (recursive).
fn code_text(doc, id) -> str {
    let out = ""
    for c in parsers.xml.children(doc, id) {
        if parsers.xml.is_element(doc, c) {
            if parsers.xml.tag(doc, c) == "sp" {
                let v = parsers.xml.attr(doc, c, "value")
                let n = 1
                if v != "" and string.isdigit(v) { n = requests.parse_uint(v) }
                out = out + spaces(n)
            } else {
                out = out + code_text(doc, c)
            }
        } else {
            out = out + parsers.xml.text(doc, c)
        }
    }
    return out
}

# Color a gtest `Suite.Case` like a highlighted qualified name.
fn test_name_html(tname) {
    let d = string.find(tname, ".")
    if d >= 0 {
        return "<span class=\"tn-suite\">" + esc(tname[:d]) + "</span>." + "<span class=\"tn-case\">" + esc(tname[d + 1:]) + "</span>"
    }
    return "<span class=\"tn-case\">" + esc(tname) + "</span>"
}

fn link_test(g, tname) {
    let inner = test_name_html(tname)
    if tname in g.test_index {
        let loc = g.test_index[tname]
        let d = string.find(loc, us())
        let lpath = loc[:d]
        let lline = loc[d + 1:]
        if lpath in g.src_map {
            let href = g.src_map[lpath]
            if lline != "" { href = href + "#L" + lline }
            return "<a href=\"" + href + "\"><code>" + inner + "</code></a>"
        }
    } elif not g.in_ext and string.contains(tname, ".") {
        g.missing_tests[tname] = true
    }
    return "<code>" + inner + "</code>"
}

# re.split(r"[,\s]+") — split on runs of commas/whitespace, dropping empties.
fn split_names(text) {
    let names: list<str> = []
    let cur = ""
    let i = 0
    while i < len(text) {
        let b = byte_at(text, i)
        if b == 44 or is_space_b(b) {
            if cur != "" { names.append(cur) }
            cur = ""
        } else {
            cur = cur + text[i:i + 1]
        }
        i = i + 1
    }
    if cur != "" { names.append(cur) }
    return names
}

fn render_tests(g, text) {
    let out = ""
    let sep = ""
    for n in split_names(string.strip(text)) {
        out = out + sep + link_test(g, n)
        sep = " "
    }
    return out
}

# Every system test the current function appears in (tag + cross-module usage),
# truncated at 3 with the rest in a "…" title.
fn render_systests(g, text) {
    let names = split_names(string.strip(text))
    let ukey = g.cur_module + us() + g.cur_func
    if ukey in g.app_usage {
        for extra in string.split(g.app_usage[ukey], us()) {
            if extra != "" and not list_contains(names, extra) { names.append(extra) }
        }
    }
    let out = ""
    let sep = ""
    let i = 0
    while i < len(names) and i < 3 {
        out = out + sep + link_test(g, names[i])
        sep = " "
        i = i + 1
    }
    if len(names) > 3 {
        let rest = ""
        let rsep = ""
        while i < len(names) {
            rest = rest + rsep + names[i]
            rsep = ", "
            i = i + 1
        }
        out = out + sep + "<span class=\"more\" title=\"" + esc(rest) + "\">…</span>"
    }
    return out
}

# The 'Performance' tag row for <module>.<name>, if perf_data covers it.
fn perf_row(g, refid, mname) {
    if not (refid in g.mod_short) { return "" }
    let key = g.mod_short[refid] + "." + mname
    if not (key in g.perf_i) { return "" }
    let e = g.perf[g.perf_i[key]]
    let body = ""
    if e.kind == "numpy_cmp" {
        let cu = e.cheatah_us
        let nu = e.numpy_us
        let speed = 0.0
        if cu != 0.0 { speed = nu / cu }
        let faster = speed >= 1.0
        let factor = speed
        let verb = "faster"
        let cls = "perf-faster"
        if not faster {
            factor = 0.0
            if speed != 0.0 { factor = 1.0 / speed }
            verb = "slower"
            cls = "perf-slower"
        }
        let tgt = string.strip("NumPy " + g.perf_numpy)
        body = "<strong>" + fmt_us(cu) + "</strong> in cheatah · " + fmt_us(nu) + " in " + tgt + " · <strong class=\"" + cls + "\">≈" + fmt_g1(factor) + "× " + verb + "</strong>"
        if e.dims != "" {
            body = body + " <span class=\"perf-dims\">(" + esc(e.dims) + ")</span>"
        }
    } elif e.kind == "numpy" {
        body = "numeric — the honest baseline is NumPy/LAPACK, not a pure-Python loop; "
        let mod = g.mod_short[refid]
        if mod in g.bench_key {
            body = body + "see the <a href=\"" + bench_page_name(mod) + "\">vs-NumPy table</a> on the " + esc(mod) + " benchmarks page"
        } else {
            body = body + "see the vs-NumPy table on the module's benchmarks page"
        }
    } elif e.kind == "note" {
        body = esc(e.note)
    } elif e.kind == "compared" or e.kind == "cheatah_only" {
        body = "<strong>" + fmt_ns(e.cheatah_ns) + "</strong> in cheatah"
        if e.kind == "compared" and e.has_compare {
            let tgt = ""
            if e.vs == "numpy" {
                tgt = string.strip("NumPy " + g.perf_numpy)
            } else {
                let cp = g.perf_cpython
                if cp == "" { cp = "3.x" }
                tgt = "CPython " + cp
            }
            let faster = e.speedup >= 1.0
            let verb = "faster"
            let cls = "perf-faster"
            let factor = e.speedup
            if not faster {
                verb = "slower"
                cls = "perf-slower"
                factor = 1.0 / e.speedup
            }
            body = body + " · " + fmt_ns(e.compare_ns) + " in " + tgt + " · <strong class=\"" + cls + "\">≈" + fmt_g1(factor) + "× " + verb + "</strong>"
        } else {
            body = body + " · <em>(no direct equivalent)</em>"
        }
    } else {
        return ""
    }
    if "scripts/perf_suite.py" in g.src_map {
        body = body + " · <a class=\"perf-src\" href=\"" + g.src_map["scripts/perf_suite.py"] + "\">how measured</a>"
    }
    return "<div class=\"tag tag-perf\"><span class=\"tag-k\">Performance</span>" + "<span class=\"tag-v\">" + body + "</span></div>"
}

# One node of a Doxygen description -> HTML. THE renderer: a text node escapes;
# an element dispatches on its tag; unknown tags render their children inline.
# All child loops live inside this one function (cheatah has no forward
# declarations, so mutual recursion is spelled as self-recursion).
fn render_node(g, doc, id) -> str {
    if not parsers.xml.is_element(doc, id) {
        return esc(parsers.xml.text(doc, id))
    }
    let t = parsers.xml.tag(doc, id)
    if t == "para" {
        let out = ""
        let buf = ""
        for c in parsers.xml.children(doc, id) {
            let is_block = false
            if parsers.xml.is_element(doc, c) {
                is_block = parsers.xml.tag(doc, c) in g.block_tags
            }
            if is_block {
                let flushed = string.strip(buf)
                if flushed != "" { out = out + "<p>" + flushed + "</p>" }
                buf = ""
                out = out + render_node(g, doc, c)
            } else {
                buf = buf + render_node(g, doc, c)
            }
        }
        let flushed = string.strip(buf)
        if flushed != "" { out = out + "<p>" + flushed + "</p>" }
        return out
    }
    if t == "parameterlist" {
        let rows = ""
        for item in parsers.xml.findall(doc, id, "parameteritem") {
            let names = ""
            let nsep = ""
            for n in parsers.xml.iter(doc, item, "parametername") {
                names = names + nsep + esc(parsers.xml.text(doc, n))
                nsep = ", "
            }
            let desc = ""
            let pd = parsers.xml.find(doc, item, "parameterdescription")
            if pd >= 0 {
                for p in parsers.xml.children(doc, pd) {
                    if parsers.xml.is_element(doc, p) { desc = desc + render_node(g, doc, p) }
                }
            }
            rows = rows + "<tr><td class=\"pname\"><code>" + names + "</code></td>" + "<td class=\"pdesc\">" + desc + "</td></tr>"
        }
        let title = "Parameters"
        if parsers.xml.attr(doc, id, "kind") == "templateparam" { title = "Template parameters" }
        return "<div class=\"params\"><div class=\"params-h\">" + title + "</div>" + "<table class=\"params-t\">" + rows + "</table></div>"
    }
    if t == "simplesect" {
        let kind = parsers.xml.attr(doc, id, "kind")
        let title = ""
        if kind == "return" { title = "Returns" }
        elif kind == "note" { title = "Note" }
        elif kind == "see" { title = "See also" }
        elif kind == "warning" { title = "Warning" }
        elif kind == "remark" { title = "Remark" }
        elif kind == "attention" { title = "Attention" }
        elif kind == "pre" { title = "Precondition" }
        elif kind == "post" { title = "Postcondition" }
        elif kind == "par" { title = "" }
        elif kind != "" { title = string.capitalize(kind) }
        let body = ""
        for c in parsers.xml.children(doc, id) {
            if parsers.xml.is_element(doc, c) { body = body + render_node(g, doc, c) }
        }
        if kind == "return" {
            return "<div class=\"ret\"><span class=\"ret-h\">" + title + "</span> " + body + "</div>"
        }
        let cls = "admon note"
        if kind != "" { cls = "admon " + kind }
        return "<div class=\"" + cls + "\"><div class=\"admon-h\">" + title + "</div>" + "<div class=\"admon-b\">" + body + "</div></div>"
    }
    if t == "xrefsect" {
        let xt = parsers.xml.find(doc, id, "xreftitle")
        let title = ""
        if xt >= 0 { title = string.strip(parsers.xml.text(doc, xt)) }
        let cls = "xref"
        if title == "Complexity" { cls = "complexity" }
        elif title == "Allocation" { cls = "alloc" }
        elif title == "Host allocation" { cls = "alloc" }        # extensions split host vs device
        elif title == "GPU allocation" { cls = "gpualloc" }      # @gpualloc (cheatah-gpu family)
        elif title == "Lifetime" { cls = "destroy" }             # @destroy — caller must release
        elif title == "Test" { cls = "test" }
        elif title == "Compile-run test" { cls = "crtest" }
        elif title == "System test" { cls = "systest" }
        elif title == "Todo" { cls = "todo" }
        elif title == "Bug" { cls = "bug" }
        let label = title
        if title == "Test" { label = "Unit test" }
        let body = ""
        let xd = parsers.xml.find(doc, id, "xrefdescription")
        if title == "System test" {
            body = render_systests(g, parsers.xml.text(doc, xd))
        } elif title == "Test" or title == "Compile-run test" {
            body = render_tests(g, parsers.xml.text(doc, xd))
        } else {
            if xd >= 0 {
                for c in parsers.xml.children(doc, xd) {
                    if parsers.xml.is_element(doc, c) { body = body + render_node(g, doc, c) }
                }
            }
        }
        return "<div class=\"tag tag-" + cls + "\"><span class=\"tag-k\">" + esc(label) + "</span><span class=\"tag-v\">" + body + "</span></div>"
    }
    if t == "itemizedlist" or t == "orderedlist" {
        let items = ""
        for li in parsers.xml.findall(doc, id, "listitem") {
            let inner = ""
            for c in parsers.xml.children(doc, li) { inner = inner + render_node(g, doc, c) }
            items = items + "<li>" + inner + "</li>"
        }
        if t == "orderedlist" { return "<ol>" + items + "</ol>" }
        return "<ul>" + items + "</ul>"
    }
    if t == "variablelist" {
        let out = "<dl class='vlist'>"
        for c in parsers.xml.children(doc, id) {
            if parsers.xml.is_element(doc, c) {
                let ct = parsers.xml.tag(doc, c)
                if ct == "varlistentry" {
                    let term = parsers.xml.find(doc, c, "term")
                    let inner = ""
                    if term >= 0 {
                        for tc in parsers.xml.children(doc, term) { inner = inner + render_node(g, doc, tc) }
                    }
                    out = out + "<dt>" + inner + "</dt>"
                } elif ct == "listitem" {
                    let inner = ""
                    for lc in parsers.xml.children(doc, c) {
                        if parsers.xml.is_element(doc, lc) { inner = inner + render_node(g, doc, lc) }
                    }
                    out = out + "<dd>" + inner + "</dd>"
                }
            }
        }
        return out + "</dl>"
    }
    if t == "table" {
        let rows = ""
        for r in parsers.xml.findall(doc, id, "row") {
            let cells = ""
            for c in parsers.xml.findall(doc, r, "entry") {
                let ctag = "td"
                if parsers.xml.attr(doc, c, "thead") == "yes" { ctag = "th" }
                let inner = ""
                for p in parsers.xml.children(doc, c) {
                    if parsers.xml.is_element(doc, p) { inner = inner + render_node(g, doc, p) }
                }
                let key = string.strip(parsers.xml.text(doc, c))
                if ctag == "td" and key in g.modules {
                    inner = "<a href=\"" + g.modules[key] + ".html\" class=\"mod-link\">" + inner + "</a>"
                } elif ctag == "td" {
                    inner = color_verdict(inner)
                }
                # scope="col": every table here has a single leading header row, so the
                # header/data relationship is programmatically determinable (WCAG 1.3.1, H63).
                let cattr = ""
                if ctag == "th" { cattr = " scope=\"col\"" }
                cells = cells + "<" + ctag + cattr + ">" + inner + "</" + ctag + ">"
            }
            rows = rows + "<tr>" + cells + "</tr>"
        }
        # The wrapper, not the table, is the scroll container — a <table> made display:block
        # leaves table layout and its cells stop filling the frame. tabindex makes the
        # scroller keyboard-operable (WCAG 2.1.1). See .tscroll in cheatah-docs.css.
        return "<div class=\"tscroll\" tabindex=\"0\"><table class=\"dtable\">" + rows + "</table></div>"
    }
    if t == "programlisting" {
        let fname = string.lower(parsers.xml.attr(doc, id, "filename"))
        let is_cpp = string.endswith(fname, ".cpp") or string.endswith(fname, ".hpp") or string.endswith(fname, ".cc") or string.endswith(fname, ".hh") or string.endswith(fname, ".h") or string.endswith(fname, ".cxx") or string.endswith(fname, ".hxx") or string.endswith(fname, ".ipp") or string.endswith(fname, ".c")
        let lines = ""
        let sep = ""
        for cl in parsers.xml.findall(doc, id, "codeline") {
            let raw = code_text(doc, cl)
            if is_cpp {
                lines = lines + sep + highlight_cpp_line(g, raw)
            } else {
                lines = lines + sep + highlight_code(g, raw)
            }
            sep = chr(10)
        }
        return "<pre class=\"code\"><code>" + lines + "</code></pre>"
    }
    if t == "sect1" or t == "sect2" or t == "sect3" {
        let ti = parsers.xml.find(doc, id, "title")
        let title = ""
        if ti >= 0 { title = first_text(doc, ti) }
        let body = ""
        for c in parsers.xml.children(doc, id) {
            if parsers.xml.is_element(doc, c) and parsers.xml.tag(doc, c) != "title" {
                body = body + render_node(g, doc, c)
            }
        }
        let h = ""
        if title != "" {
            let sid = parsers.xml.attr(doc, id, "id")
            let idattr = ""
            if sid != "" { idattr = " id=\"" + esc(sid) + "\"" }
            h = "<h2" + idattr + ">" + esc(title) + "</h2>"
        }
        return h + body
    }
    if t == "hruler" { return "<hr>" }
    if t == "linebreak" { return "<br>" }
    if t == "computeroutput" {
        let all_sp = true
        for c in parsers.xml.children(doc, id) {
            if parsers.xml.is_element(doc, c) and parsers.xml.tag(doc, c) != "sp" { all_sp = false }
        }
        if all_sp {
            return "<code>" + highlight_code(g, code_text(doc, id)) + "</code>"
        }
        let inner = ""
        for c in parsers.xml.children(doc, id) { inner = inner + render_node(g, doc, c) }
        return "<code>" + inner + "</code>"
    }
    if t == "bold" {
        let inner = ""
        for c in parsers.xml.children(doc, id) { inner = inner + render_node(g, doc, c) }
        return "<strong>" + inner + "</strong>"
    }
    if t == "emphasis" {
        let inner = ""
        for c in parsers.xml.children(doc, id) { inner = inner + render_node(g, doc, c) }
        return "<em>" + inner + "</em>"
    }
    if t == "ref" {
        let refid = parsers.xml.attr(doc, id, "refid")
        let kindref = parsers.xml.attr(doc, id, "kindref")
        if kindref == "" { kindref = "compound" }
        let target = refid
        if kindref != "compound" {
            target = ""
            if refid in g.mi { target = g.mi[refid] }
        }
        let inner = ""
        for c in parsers.xml.children(doc, id) { inner = inner + render_node(g, doc, c) }
        if not (target in g.valid) and not (refid in g.valid) { return inner }
        # Markdown pages that render somewhere other than <refid>.html (a module README folds
        # into the module page; a BENCHMARKS.md is the module's benchmark subpage).
        let href = refid + ".html"
        if refid in g.page_href { href = g.page_href[refid] }
        if kindref != "compound" {
            let compound = target
            if compound == "" {
                let cut = string.rfind(refid, "_1")
                compound = refid
                if cut >= 0 { compound = refid[:cut] }
            }
            href = compound + ".html#" + refid
            if compound in g.page_href { href = g.page_href[compound] + "#" + refid }
        }
        return "<a href=\"" + href + "\">" + inner + "</a>"
    }
    if t == "ulink" {
        let url = parsers.xml.attr(doc, id, "url")
        let inner = ""
        for c in parsers.xml.children(doc, id) { inner = inner + render_node(g, doc, c) }
        if string.contains(url, "://") or string.startswith(url, "mailto:") {
            return "<a href=\"" + esc(url) + "\" target=\"_blank\" rel=\"noopener\">" + inner + "</a>"
        }
        # A relative link resolves to where the target renders (a module page, a source
        # listing); a `#fragment` rides along, so `foo.cpp#L12` lands on the line.
        let key = url
        let frag = ""
        let hash = string.find(key, "#")
        if hash >= 0 {
            frag = key[hash:]
            key = key[:hash]
        }
        while string.startswith(key, "../") { key = key[3:] }
        while string.startswith(key, "./") { key = key[2:] }
        key = string.rstrip(key, "/")
        if key in g.modules {
            return "<a href=\"" + g.modules[key] + ".html" + esc(frag) + "\">" + inner + "</a>"
        }
        if key in g.page_by_file {
            let pr = g.page_by_file[key]
            let href = pr + ".html"
            if pr in g.page_href { href = g.page_href[pr] }
            return "<a href=\"" + href + esc(frag) + "\">" + inner + "</a>"
        }
        if key in g.src_map {
            return "<a href=\"" + g.src_map[key] + esc(frag) + "\">" + inner + "</a>"
        }
        return inner
    }
    if t == "anchor" { return "" }
    if t == "parametername" {
        let inner = ""
        for c in parsers.xml.children(doc, id) { inner = inner + render_node(g, doc, c) }
        return inner
    }
    # unknown / passthrough: inline children
    let inner = ""
    for c in parsers.xml.children(doc, id) { inner = inner + render_node(g, doc, c) }
    return inner
}

# Element children of a description container, dispatched (Renderer.render).
fn render_desc(g, doc, id) {
    if id < 0 { return "" }
    let out = ""
    for c in parsers.xml.children(doc, id) {
        if parsers.xml.is_element(doc, c) { out = out + render_node(g, doc, c) }
    }
    return out
}

# Brief description as inline HTML — the first <para>'s full inline content.
fn render_brief(g, doc, id) {
    if id < 0 { return "" }
    let p = parsers.xml.find(doc, id, "para")
    if p < 0 { return "" }
    let out = ""
    for c in parsers.xml.children(doc, p) { out = out + render_node(g, doc, c) }
    return out
}

# ---------------------------------------------------------------------------
# Page assembly
# ---------------------------------------------------------------------------

fn kind_badge(kind) {
    if kind == "function" { return "fn" }
    if kind == "variable" { return "var" }
    if kind == "typedef" { return "type" }
    return kind
}

fn member_signature(g, doc, m: Member) {
    let typ = ""
    if m.type_id >= 0 {
        for c in parsers.xml.children(doc, m.type_id) { typ = typ + render_node(g, doc, c) }
    }
    let static_html = ""
    if m.is_static { static_html = "<span class=\"kw\">static</span> " }
    return static_html + "<span class=\"mtype\">" + typ + "</span> <span class=\"mname\">" + esc(m.name) + "</span>" + esc(m.args)
}

fn src_link_of(g, m: Member) {
    if m.srcfile == "" { return "" }
    if not (m.srcfile in g.src_map) { return "" }
    let href = g.src_map[m.srcfile]
    if m.srcline != "" { href = href + "#L" + m.srcline }
    return href
}

fn render_member(g, doc, m: Member) {
    let badge = kind_badge(m.kind)
    g.cur_func = m.name
    let brief = render_brief(g, doc, m.brief_id)
    let detail = render_desc(g, doc, m.detail_id) + perf_row(g, m.compound, m.name)
    let src = src_link_of(g, m)
    let src_html = ""
    if src != "" {
        src_html = "<a class=\"src-link\" href=\"" + src + "\" title=\"View source\">source</a>"
    }
    let brief_html = ""
    if brief != "" { brief_html = "<p class=\"member-brief\">" + brief + "</p>" }
    return "<section class=\"member\" id=\"" + m.id + "\">\n" + "  <div class=\"member-head\">\n" + "    <span class=\"badge badge-" + badge + "\">" + badge + "</span>\n" + "    <code class=\"sig\">" + member_signature(g, doc, m) + "</code>\n" + "    <span class=\"member-actions\">" + src_html + "<a class=\"anchor\" href=\"#" + m.id + "\" aria-label=\"permalink\">#</a></span>\n" + "  </div>\n" + "  " + brief_html + "\n" + "  <div class=\"member-body\">" + detail + "</div>\n" + "</section>"
}

# Consolidate the overloads of one function into a single reference block.
fn render_member_group(g, doc, members, idxs: list<int>) {
    if len(idxs) == 1 { return render_member(g, doc, members[idxs[0]]) }
    let head = members[idxs[0]]
    g.cur_func = head.name
    let badge = kind_badge(head.kind)
    # the shared prose comes from the first overload that carries detail
    let primary = idxs[0]
    for i in idxs {
        if members[i].detail_id >= 0 and string.strip(render_desc(g, doc, members[i].detail_id)) != "" {
            primary = i
            break
        }
    }
    let brief = render_brief(g, doc, members[primary].brief_id)
    if brief == "" {
        for i in idxs {
            let b2 = render_brief(g, doc, members[i].brief_id)
            if b2 != "" {
                brief = b2
                break
            }
        }
    }
    let detail = render_desc(g, doc, members[primary].detail_id) + perf_row(g, head.compound, head.name)
    let rows = ""
    for i in idxs {
        let m = members[i]
        let src = src_link_of(g, m)
        let src_html = ""
        if src != "" {
            src_html = "<a class=\"src-link\" href=\"" + src + "\" title=\"View source\">source</a>"
        }
        let idattr = ""
        if m.id != head.id { idattr = " id=\"" + m.id + "\"" }
        rows = rows + "<div class=\"overload\"" + idattr + "><code class=\"sig\">" + member_signature(g, doc, m) + "</code>" + "<span class=\"member-actions\">" + src_html + "<a class=\"anchor\" href=\"#" + m.id + "\" aria-label=\"permalink\">#</a></span></div>"
    }
    let brief_html = ""
    if brief != "" { brief_html = "<p class=\"member-brief\">" + brief + "</p>" }
    return "<section class=\"member\" id=\"" + head.id + "\">\n" + "  <div class=\"member-head\">\n" + "    <span class=\"badge badge-" + badge + "\">" + badge + "</span>\n" + "    <code class=\"sig\"><span class=\"mname\">" + esc(head.name) + "</span> <span class=\"overload-count\">· " + str(len(idxs)) + " overloads</span></code>\n" + "  </div>\n" + "  <div class=\"overload-list\">" + rows + "</div>\n" + "  " + brief_html + "\n" + "  <div class=\"member-body\">" + detail + "</div>\n" + "</section>"
}

# One link of the topbar package switcher; `cur` highlights the package being viewed.
fn pkg_link(href, label, cur) {
    let cls = ""
    if cur { cls = " class=\"current\" aria-current=\"page\"" }
    return "<a href=\"" + href + "\"" + cls + ">" + esc(label) + "</a>"
}

# The topbar package switcher: cheatah · gpu · gpu-linalg · … · standard, on EVERY
# page (core and subsites). Every label is lower-case — these read as package names,
# not prose, and one capitalised tab in the row sticks out. `pkg` is "" on core pages,
# an extension name on its subsite pages, or "standard" on the Biome Standard page;
# hrefs are prefix-aware (subsite pages reach their siblings through "../").
fn pkg_switcher(g, pkg) {
    let prefix = ""
    if pkg != "" and pkg != "standard" { prefix = "../" }
    let out = pkg_link(prefix + "index.html", "cheatah", pkg == "")
    for e in g.ext_names {
        let label = e
        if string.startswith(e, "cheatah-") { label = e[8:] }
        out = out + "<span class=\"pkgs-sep\">·</span>" + pkg_link(prefix + e + "/index.html", label, pkg == e)
    }
    out = out + "<span class=\"pkgs-sep\">·</span>" + pkg_link(prefix + "standard.html", "standard", pkg == "standard")
    return "<nav class=\"pkgs\" aria-label=\"Packages\">" + out + "</nav>"
}

# The page shell, package-aware. Core pages ("" / "standard") load the shared
# assets same-dir; an extension's subsite pages load the shared css/logo from
# the parent ("../"). No <script> anywhere: the site is zero-JS by design.
#
# Two links point at the company storefront — one in the topbar, one in the footer
# copyright — on every page of every subsite. cheatah is free, and the products sold
# there are what pay for it, so the docs carry the way back. They are absolute URLs,
# so `prefix` does not apply to them.
#
# The topbar one is paired with a "Source" link to the repository, to its LEFT. Both sit
# inside a single .topbar-right flex cell rather than becoming a fifth grid column: the
# responsive rule in cheatah-docs.css is that every fixed track must be dropped at the
# breakpoint that hides its content, and a new track would need re-pointing in all three
# media blocks. One cell holding both links inherits the placement .bb already had, so the
# layout math — and docs_a11y_gate.sh's no-horizontal-scroll assertion — is untouched.
# The Source href is the cheatah repo on EVERY subsite, including the extension subsites:
# it is the way back to the language itself, not to the package being read.
fn page_shell_in(g, pkg, title, sidebar, content, toc) {
    let is_sub = pkg != "" and pkg != "standard"
    let prefix = ""
    if is_sub { prefix = "../" }
    let body = string.replace(content, "🐾", "<span class=\"paw\">🐾</span>")
    body = apply_sidebyside(body)
    # No hardcoded data-theme: the theme button was JavaScript and the serving CSP has no
    # script-src, so a baked-in dark attribute would make the stylesheet's light palette
    # unreachable for every reader. Bare <html> lets prefers-color-scheme decide.
    # An empty "On this page" rail is a labelled landmark with nothing in it (and a
    # reserved 224px column), so pages with no headings omit the aside and say so on
    # .layout — keep the two in lockstep.
    let toc_el = ""
    let layout_cls = "layout no-toc"
    if toc != "" {
        toc_el = "\n  <aside class=\"toc\" aria-label=\"On this page\">" + toc + "</aside>"
        layout_cls = "layout"
    }
    # The " · cheatah" suffix exists so a bare identifier ("math", "io::File") is identifiable
    # in a browser tab or a search result. A title that already SAYS cheatah does not need it,
    # and "cheatah-plot · cheatah" reads like a stutter — so the suffix is conditional, which
    # also lets a call site opt out simply by writing a fuller title.
    let head_title = esc(title) + " · cheatah"
    if string.contains(string.lower(title), "cheatah") { head_title = esc(title) }
    return "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n" + "<meta charset=\"utf-8\">\n" + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" + "<meta name=\"generator\" content=\"cheatah\">\n" + "<title>" + head_title + "</title>\n" + "<link rel=\"icon\" href=\"" + prefix + "cheatah-logo.png\" type=\"image/png\">\n" + "<link rel=\"stylesheet\" href=\"" + prefix + "cheatah-docs.css?v=" + g.vers_css + "\">\n" + "</head>\n<body>\n" + "<a class=\"skip\" href=\"#main\">Skip to content</a>\n" + "<header class=\"topbar\">\n  <div class=\"topbar-inner\">\n" + "    <a class=\"brand\" href=\"" + prefix + "index.html\"><img src=\"" + prefix + "cheatah-logo.png\" alt=\"\"><span>cheatah</span></a>\n" + "    " + pkg_switcher(g, pkg) + "\n" + "    <div class=\"topbar-right\">\n" + "      <a class=\"repo\" href=\"https://github.com/BrofessorDoucette/cheatah\">Source <span aria-hidden=\"true\">↗</span></a>\n" + "      <a class=\"bb\" href=\"https://bigbrain-technology.com\">BigBrain <span aria-hidden=\"true\">↗</span></a>\n" + "    </div>\n" + "  </div>\n</header>\n" + "<div class=\"" + layout_cls + "\">\n" + "  <nav class=\"sidebar\" aria-label=\"Modules\">" + sidebar + "</nav>\n" + "  <main id=\"main\" class=\"content\">" + body + "</main>" + toc_el + "\n" + "</div>\n" + "<footer class=\"sitefoot\">© 2026 <a href=\"https://bigbrain-technology.com\">BigBrain LLC</a> — cheatah is free software under the MIT License. Lead engineer &amp; producer: Joshua Doucette, on behalf of BigBrain LLC. <a class=\"donate\" href=\"https://bigbrain-technology.com/cheatah/donate\">&hearts; Donate</a></footer>\n" + "</body>\n</html>"
}

# Server-side sidebar active state (the site ships zero JS): within the page's
# inlined sidebar only, mark the link whose href equals this page's own filename
# with class="active" and render every enclosing <details> dropdown open — so the
# current page is highlighted and its dropdown chain is expanded without any
# client-side script. A page not present in the sidebar is left untouched.
fn mark_active(page, fname) {
    let nav_open = "<nav class=\"sidebar\" aria-label=\"Modules\">"
    let i = string.find(page, nav_open)
    if i < 0 { return page }
    let j = string.find(page[i:], "</nav>")
    if j < 0 { return page }
    j = i + j
    let side = page[i:j]
    let k = string.find(side, "href=\"" + fname + "\"")
    if k < 0 { return page }
    let a = string.rfind(side[:k], "<a ")
    if a < 0 { return page }
    let e = string.find(side[k:], ">")
    if e < 0 { return page }
    e = k + e
    let tag = side[a:e]
    if string.contains(tag, " class=\"") {
        let cut = string.find(tag, " class=\"")
        tag = tag[:cut] + " class=\"active " + tag[cut + 8:]
    } else {
        tag = "<a class=\"active\" " + tag[3:]
    }
    # The <details> dropdowns enclosing the active link: scan the sidebar up to the
    # link, keeping a stack of unclosed <details> opening-tag positions.
    let opens: list<int> = []
    let depth = 0
    let pos = 0
    while pos < a {
        let o = string.find(side[pos:], "<details")
        if o >= 0 { o = pos + o }
        if o >= a { o = -1 }
        let c = string.find(side[pos:], "</details>")
        if c >= 0 { c = pos + c }
        if c >= a { c = -1 }
        if o < 0 and c < 0 { break }
        if c < 0 or (o >= 0 and o < c) {
            if depth < len(opens) { opens[depth] = o }
            else { opens.append(o) }
            depth = depth + 1
            pos = o + 8
        } else {
            if depth > 0 { depth = depth - 1 }
            pos = c + 10
        }
    }
    side = side[:a] + tag + side[e:]
    let oi = depth - 1
    while oi >= 0 {                      # deepest first: earlier offsets stay valid
        let p = opens[oi]
        let q = p + string.find(side[p:], ">")
        side = side[:q] + " open" + side[q:]
        oi = oi - 1
    }
    return page[:i] + side + page[j:]
}

fn page_shell(g, title, sidebar, content, toc) {
    return page_shell_in(g, "", title, sidebar, content, toc)
}

# One module entry in the sidebar tree (submodules as collapsible dropdowns).
fn side_node(g, kids, refid) -> str {
    let c = g.comps[g.comp_idx[refid]]
    let leaf = c.short
    let cut = string.rfind(leaf, "::")
    if cut >= 0 { leaf = leaf[cut + 2:] }
    let link = "<a href=\"" + c.refid + ".html\" data-ref=\"" + c.refid + "\">" + esc(leaf) + "</a>"
    if c.short in kids {
        let inner = ""
        for k in string.split(kids[c.short], us()) {
            if k != "" { inner = inner + "<li>" + side_node(g, kids, k) + "</li>" }
        }
        if inner != "" {
            return "<details class=\"side-sub\"><summary>" + link + "</summary><ul>" + inner + "</ul></details>"
        }
    }
    return link
}

fn guide_link(c: Compound) {
    let label = c.title
    if label == "" { label = c.short }
    return "<li><a href=\"" + c.refid + ".html\" data-ref=\"" + c.refid + "\">" + esc(label) + "</a></li>"
}

# Sort "lower<US>refid" pairs, return the refids joined with <US>.
fn sort_pair_refids(joined_pairs) {
    let toks = string.split(joined_pairs, us())
    let pairs: list<str> = []
    let i = 0
    while i + 1 < len(toks) {
        pairs.append(toks[i] + us() + toks[i + 1])
        i = i + 2
    }
    let out = ""
    let sep = ""
    for p in sorted_strs(pairs) {
        let cut = string.rfind(p, us())
        out = out + sep + p[cut + 1:]
        sep = us()
    }
    return out
}

fn build_sidebar(g) {
    let parts = "<a class=\"side-home\" href=\"index.html\">Overview</a>"
    # guide-page buckets, each sorted by an explicit order key
    let tools_keys: list<str> = []
    let guide_keys: list<str> = []
    let parity_keys: list<str> = []
    let ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "page" and c.refid != "indexpage" and c.refid != "complexity" and c.refid != "alloc" and c.refid != "test" and c.refid != "crtest" and c.refid != "systest" {
            let r = c.refid
            if r == "purrc" { tools_keys.append("0" + us() + str(ci)) }
            elif r == "runtime" { tools_keys.append("1" + us() + str(ci)) }
            elif r == "biome" { tools_keys.append("2" + us() + str(ci)) }
            elif r == "extensions" { tools_keys.append("3" + us() + str(ci)) }
            elif r == "md_compiler_2PYTHON" { parity_keys.append("0" + us() + str(ci)) }
            elif r == "cpp" { parity_keys.append("1" + us() + str(ci)) }
            else {
                let ord_key = "99"
                if r == "why" { ord_key = "00" }
                elif r == "getting-started" { ord_key = "01" }
                elif r == "porting" { ord_key = "02" }
                elif r == "imports" { ord_key = "03" }
                elif r == "ownership" { ord_key = "04" }
                elif r == "performance" { ord_key = "05" }
                elif r == "optimizations" { ord_key = "06" }
                elif r == "security" { ord_key = "07" }
                elif r == "releasing" { ord_key = "08" }
                elif r == "md_CHANGELOG" { ord_key = "09" }
                let label = c.title
                if label == "" { label = c.short }
                guide_keys.append(ord_key + us() + string.lower(label) + us() + str(ci))
            }
        }
        ci = ci + 1
    }
    let tools_sorted = sorted_strs(tools_keys)
    let tlinks = ""
    for k in tools_sorted {
        let cut = string.rfind(k, us())
        tlinks = tlinks + guide_link(g.comps[requests.parse_uint(k[cut + 1:])])
    }
    # The Biome Standard page is generated (not a Doxygen page) — it belongs with
    # the tools that consume it (biome, the extensions).
    tlinks = tlinks + "<li><a href=\"standard.html\" data-ref=\"standard\">Biome Standard</a></li>"
    parts = parts + "<div class=\"side-group\"><div class=\"side-h\">Essential tools</div><ul>" + tlinks + "</ul></div>"
    # Guides — inject the Transpiler entry right before performance/security/changelog
    let links = ""
    let injected = false
    for k in sorted_strs(guide_keys) {
        let cut = string.rfind(k, us())
        let c = g.comps[requests.parse_uint(k[cut + 1:])]
        if (c.refid == "performance" or c.refid == "security" or c.refid == "md_CHANGELOG") and not injected {
            links = links + "<li><a href=\"transpiler.html\" data-ref=\"transpiler\">Transpiler</a></li>"
            injected = true
        }
        links = links + guide_link(c)
    }
    if not injected {
        links = links + "<li><a href=\"transpiler.html\" data-ref=\"transpiler\">Transpiler</a></li>"
    }
    parts = parts + "<div class=\"side-group\"><div class=\"side-h\">Guides</div><ul>" + links + "</ul></div>"
    let parity_sorted = sorted_strs(parity_keys)
    if len(parity_sorted) > 0 {
        let plinks = ""
        for k in parity_sorted {
            let cut = string.rfind(k, us())
            plinks = plinks + guide_link(g.comps[requests.parse_uint(k[cut + 1:])])
        }
        parts = parts + "<div class=\"side-group\"><div class=\"side-h\">Language parity</div><ul>" + plinks + "</ul></div>"
    }
    # Modules: top-level entries with nested submodules (the stdlib only —
    # extension namespaces get their own group below)
    let kid_keys: dict<str, str> = {}
    ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "namespace" and c.ext == "" and string.contains(c.short, "::") {
            let cut = string.rfind(c.short, "::")
            let parent = c.short[:cut]
            let prev = ""
            if parent in kid_keys { prev = kid_keys[parent] + us() }
            kid_keys[parent] = prev + string.lower(c.short) + us() + c.refid
        }
        ci = ci + 1
    }
    let kids: dict<str, str> = {}
    for kv in kid_keys { kids[kv.first] = sort_pair_refids(kv.second) }
    let top_keys: list<str> = []
    ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "namespace" and c.ext == "" and not string.contains(c.short, "::") {
            top_keys.append(string.lower(c.short) + us() + c.refid)
        }
        ci = ci + 1
    }
    let mods = ""
    for k in sorted_strs(top_keys) {
        let cut = string.rfind(k, us())
        mods = mods + "<li class=\"side-mod\">" + side_node(g, kids, k[cut + 1:]) + "</li>"
    }
    parts = parts + "<div class=\"side-group\"><div class=\"side-h\">Modules</div><ul>" + mods + "</ul></div>"
    # Extensions — each sibling extension is its own SUBSITE (docs/html/<ext>/)
    # with a landing page, nested module sidebar and releases page; the core
    # sidebar links each subsite's front door.
    if len(g.ext_names) > 0 {
        let elinks = ""
        for e in g.ext_names {
            elinks = elinks + "<li class=\"side-mod\"><a href=\"" + esc(e) + "/index.html\">" + esc(e) + "</a></li>"
        }
        parts = parts + "<div class=\"side-group\"><div class=\"side-h\">Extensions</div><ul>" + elinks + "</ul></div>"
    }
    return parts
}

fn build_toc(members) {
    if len(members) == 0 { return "" }
    let parts = "<div class=\"toc-h\">On this page</div><ul>"
    let seen: dict<str, bool> = {}
    for m in members {
        if m.kind == "function" and not (m.name in seen) {
            seen[m.name] = true
            parts = parts + "<li><a href=\"#" + m.id + "\">" + esc(m.name) + "</a></li>"
        }
    }
    for m in members {
        if m.kind != "function" {
            parts = parts + "<li><a href=\"#" + m.id + "\">" + esc(m.name) + "</a></li>"
        }
    }
    return parts + "</ul>"
}

# Documents are not storable in containers (no qualified template args), so each
# page re-parses its compound XML — deterministic parsing keeps the node ids
# recorded at load valid against the fresh parse.
fn doc_of(xdir, refid) {
    let path = xdir + "/" + refid + ".xml"
    if os.path.isfile(path) { return parsers.xml.parse(io.read_file(path)) }
    return parsers.xml.parse("")
}

# The XML tree a compound was parsed from: the stdlib's, or its extension's own.
fn xdir_of(c: Compound) {
    if c.ext != "" { return "docs/xml-ext/" + c.ext }
    return "docs/xml"
}

# The CURRENT Biome Standard — the newest entry marked "current" (falling back to
# the newest entry full stop, so a table mid-release still renders honestly).
fn current_standard() {
    let all = biome.known_standards()
    let pick = len(all) - 1
    let i = 0
    while i < len(all) {
        let s = all[i]
        if s.status == "current" { pick = i }
        i = i + 1
    }
    let cur = all[pick]
    return cur
}

# Extension version badge (extension release — Biome Standard), derived from the
# package manager's own in-source table (`import biome`) so it can never go
# stale: a member of the current standard shows its tested tag; a package not in
# the table yet honestly says it joins the next standard.
fn ext_badge_of(extname) {
    let cur = current_standard()
    let tag = biome.component_tag(cur, extname)
    if tag != "" { return extname + " " + tag + " — Biome Standard " + cur.version }
    return extname + " — joins the next standard"
}

# The meta description for compound `ci`.
#
# Doxygen's own brief is the best sentence we have — it is what the author wrote to describe
# the thing, and it is already on the page — so it is the first choice, reduced to plain text.
# The fallback is templated by KIND rather than one generic string: "cheatah standard library
# reference" under every one of 297 pages would be a duplicate-description warning in Search
# Console and, worse, gives a searcher no reason to prefer one result over another.
# @param g the generator state.
# @param ci the compound index.
# @return plain-text description.
fn page_desc(g, ci) {
    let c = g.comps[ci]
    let brief = render_brief(g, doc_of(xdir_of(c), c.refid), c.brief_id)
    let name = string.replace(c.short, "::", ".")
    let where = "the cheatah standard library"
    if c.ext != "" { where = "the cheatah " + c.ext + " package" }
    let fallback = name + " — reference documentation in " + where + "."
    if c.kind == "namespace" {
        fallback = name + " — the " + name + " module of " + where + ": every function, type and constant, with signatures and examples."
    } elif c.kind == "page" {
        fallback = c.title + " — cheatah documentation."
    } elif c.kind == "concept" {
        fallback = name + " — a concept in " + where + ", and what a type must provide to satisfy it."
    } elif c.kind == "class" or c.kind == "struct" {
        fallback = name + " — a type in " + where + ": its members, methods and ownership rules."
    }
    return desc_or(brief, fallback)
}

fn render_compound_page(g, ci, sidebar) {
    let c = g.comps[ci]
    let doc_key = c.refid
    let is_page = c.kind == "page"
    let kind_label = "Guide"
    if c.kind == "namespace" { kind_label = "Module" }
    elif c.kind == "class" { kind_label = "Class" }
    elif c.kind == "struct" { kind_label = "Struct" }
    elif c.kind == "concept" { kind_label = "Concept" }
    g.cur_module = c.short
    g.in_ext = c.ext != ""
    let cdoc = doc_of(xdir_of(c), doc_key)
    let brief = render_brief(g, cdoc, c.brief_id)
    let detail = ""
    if c.kind == "namespace" and c.short in g.readme_key {
        let rdoc = doc_of("docs/xml", g.readme_key[c.short])
        detail = render_desc(g, rdoc, g.readme_node[c.short])
    }
    detail = detail + render_desc(g, cdoc, c.detail_id)
    # A module with a benchmark subpage says so up front: the tables used to be folded in here.
    if c.kind == "namespace" and c.short in g.bench_key {
        detail = "<div class=\"admon bench\"><div class=\"admon-h\">Benchmarks</div><div class=\"admon-b\">Every measured table for <code>" + esc(c.short) + "</code> — with its stamp (commit, host, harness) and the commands that reproduce it — is on the <a href=\"" + bench_page_name(c.short) + "\">" + esc(c.short) + " benchmarks</a> page.</div></div>" + detail
    }
    # group members: functions (overload-consolidated), variables, types
    let sections = ""
    let fn_names: list<str> = []
    for m in c.members {
        if m.kind == "function" and not list_contains(fn_names, m.name) { fn_names.append(m.name) }
    }
    if len(fn_names) > 0 {
        let body = ""
        for fname in fn_names {
            let idxs: list<int> = []
            let mi2 = 0
            while mi2 < len(c.members) {
                if c.members[mi2].kind == "function" and c.members[mi2].name == fname {
                    idxs.append(mi2)
                }
                mi2 = mi2 + 1
            }
            body = body + render_member_group(g, cdoc, c.members, idxs)
        }
        sections = sections + "<h2 class=\"group\">Functions</h2>" + body
    }
    let var_body = ""
    for m in c.members {
        if m.kind == "variable" { var_body = var_body + render_member(g, cdoc, m) }
    }
    if var_body != "" {
        sections = sections + "<h2 class=\"group\">Constants & variables</h2>" + var_body
    }
    let type_body = ""
    for m in c.members {
        if m.kind == "typedef" or m.kind == "enum" {
            type_body = type_body + render_member(g, cdoc, m)
        }
    }
    if type_body != "" { sections = sections + "<h2 class=\"group\">Types</h2>" + type_body }
    # a module page lists its own classes (and, on extension pages, concepts)
    let class_section = ""
    if c.kind == "namespace" and c.ext == "" and c.short in g.classes_of {
        let items = ""
        for cref in string.split(g.classes_of[c.short], us()) {
            if cref == "" { continue }
            let cc = g.comps[g.comp_idx[cref]]
            let leaf = cc.short
            let cut = string.rfind(leaf, "::")
            if cut >= 0 { leaf = leaf[cut + 2:] }
            let ccdoc = doc_of(xdir_of(cc), cc.refid)
            let cbrief = render_brief(g, ccdoc, cc.brief_id)
            let extra = ""
            if cbrief != "" { extra = " — " + cbrief }
            items = items + "<li><a href=\"" + cc.refid + ".html\"><code>" + esc(leaf) + "</code></a>" + extra + "</li>"
        }
        if items != "" {
            class_section = "<h2 class=\"group\">Classes</h2><ul class=\"class-list\">" + items + "</ul>"
        }
    } elif c.kind == "namespace" and c.ext != "" and (c.ext + us() + c.short) in g.ext_classes {
        # extension trees also load struct/concept compounds; list them here, split
        # by kind, with same-dir links (the whole extension lives in one subsite dir)
        let citems = ""
        let kitems = ""
        for tok in string.split(g.ext_classes[c.ext + us() + c.short], us()) {
            if tok == "" { continue }
            let cc = g.comps[requests.parse_uint(tok)]
            let leaf = cc.short
            let cut = string.rfind(leaf, "::")
            if cut >= 0 { leaf = leaf[cut + 2:] }
            let ccdoc = doc_of(xdir_of(cc), cc.refid)
            let cbrief = render_brief(g, ccdoc, cc.brief_id)
            let extra = ""
            if cbrief != "" { extra = " — " + cbrief }
            let item = "<li><a href=\"" + cc.refid + ".html\"><code>" + esc(leaf) + "</code></a>" + extra + "</li>"
            if cc.kind == "concept" {
                kitems = kitems + item
            } else {
                citems = citems + item
            }
        }
        if citems != "" {
            class_section = class_section + "<h2 class=\"group\">Classes</h2><ul class=\"class-list\">" + citems + "</ul>"
        }
        if kitems != "" {
            class_section = class_section + "<h2 class=\"group\">Concepts</h2><ul class=\"class-list\">" + kitems + "</ul>"
        }
    }
    let title_html = "<code>" + esc(c.short) + "</code>"
    if is_page { title_html = esc(c.title) }
    # an extension page carries its version badge (extension release — Biome Standard)
    let badge_html = ""
    if c.ext != "" {
        let btxt = ext_badge_of(c.ext)
        if btxt != "" { badge_html = "<p class=\"ext-badge\">" + esc(btxt) + "</p>" }
    }
    let brief_html = ""
    if brief != "" { brief_html = "<p class=\"lede\">" + brief + "</p>" }
    let content = "<div class=\"page-head\">\n" + "  <div class=\"eyebrow\">" + kind_label + "</div>\n" + "  <h1>" + title_html + "</h1>\n" + "  " + badge_html + brief_html + "\n" + "</div>\n" + "<div class=\"overview\">" + detail + "</div>\n" + class_section + "\n" + sections
    # A bare identifier ("math", "io::File") is a weak title: it says nothing about what
    # site it belongs to, which is all a search result has to go on. Guide pages keep their
    # own titles — they are already sentences.
    let page_title = c.short + " — cheatah standard library"
    if c.ext != "" { page_title = c.short + " — " + c.ext }
    if is_page { page_title = c.title }
    return page_shell_in(g, c.ext, page_title, sidebar, content, build_toc(c.members))
}

# "On this page" for a markdown page: its top-level sections. "" when there are none, so
# page_shell_in omits the rail instead of emitting an empty landmark.
fn sect_toc(doc, id) {
    if id < 0 { return "" }
    let items = ""
    for c in parsers.xml.children(doc, id) {
        if parsers.xml.is_element(doc, c) and parsers.xml.tag(doc, c) == "sect1" {
            let sid = parsers.xml.attr(doc, c, "id")
            let ti = parsers.xml.find(doc, c, "title")
            if sid != "" and ti >= 0 {
                items = items + "<li><a href=\"#" + esc(sid) + "\">" + esc(first_text(doc, ti)) + "</a></li>"
            }
        }
    }
    if items == "" { return "" }
    return "<div class=\"toc-h\">On this page</div><ul>" + items + "</ul>"
}

# A module's benchmark subpage: stdlib/<mod>/BENCHMARKS.md rendered whole, framed as the
# module's, and linking back to it. The sidebar keeps the MODULE active (see main).
fn render_bench_page(g, mod, sidebar) {
    let refid = g.bench_key[mod]
    let bdoc = doc_of("docs/xml", refid)
    g.cur_module = mod
    let title = g.bench_title[mod]
    if title == "" { title = mod + " benchmarks" }
    let back = "index.html"
    if mod in g.modules { back = g.modules[mod] + ".html" }
    let body = render_desc(g, bdoc, g.bench_node[mod])
    let lede = "<p class=\"lede\">The generated measurement tables for the <a href=\"" + back + "\"><code>" + esc(mod) + "</code> module</a> — every case, the harness that measured it, and how to reproduce it.</p>"
    let content = "<div class=\"page-head\">\n" + "  <div class=\"eyebrow\">Benchmarks</div>\n" + "  <h1>" + esc(title) + "</h1>\n" + "  " + lede + "\n" + "</div>\n" + "<div class=\"overview\">" + body + "</div>\n" + "<p class=\"bench-back\"><a href=\"" + back + "\">Back to the <code>" + esc(mod) + "</code> reference</a></p>"
    return page_shell(g, title + " — cheatah standard library", sidebar, content, sect_toc(bdoc, g.bench_node[mod]))
}

fn render_home(g, ci, sidebar) {
    let c = g.comps[ci]
    let hdoc = doc_of(xdir_of(c), c.refid)
    let detail = render_desc(g, hdoc, c.detail_id)
    let content = "<div class=\"home\">\n" + "  <div class=\"hero\">\n" + "    <img class=\"hero-logo\" src=\"cheatah-logo.png\" alt=\"\">\n" + "    <div class=\"hero-text\">\n" + "      <h1 class=\"hero-title\">cheatah</h1>\n" + "      <p class=\"hero-tagline\">Programs so fast they purrrrrrrrrrrrr like a kitten.</p>\n" + "    </div>\n" + "  </div>\n" + "  " + detail + "</div>"
    return page_shell(g, "cheatah — the Python-like language that compiles to native code", sidebar, content, "")
}

fn render_source_page(g, rel_path, sidebar) {
    let raw = io.read_file(rel_path)
    let is_cpp = false
    let dot = string.rfind(rel_path, ".")
    if dot >= 0 {
        let ext = string.lower(rel_path[dot:])
        is_cpp = ext == ".cpp" or ext == ".hpp" or ext == ".cc" or ext == ".hh" or ext == ".cxx" or ext == ".hxx" or ext == ".h" or ext == ".ipp" or ext == ".inl" or ext == ".c" or ext == ".tpp" or ext == ".js"
    }
    let rows = ""
    let i = 1
    for line in string.splitlines(raw) {
        let hl = ""
        if is_cpp {
            hl = highlight_cpp_line(g, line)
        } elif string.endswith(rel_path, ".sh") {
            hl = esc(line)
        } else {
            hl = highlight_code(g, line)
        }
        rows = rows + "<div class=\"srcline\" id=\"L" + str(i) + "\">" + "<a class=\"lnno\" href=\"#L" + str(i) + "\">" + str(i) + "</a>" + "<code class=\"lc\">" + hl + "</code></div>"
        i = i + 1
    }
    let content = "<div class=\"page-head\"><div class=\"eyebrow\">Source</div>" + "<h1><code>" + esc(rel_path) + "</code></h1></div>" + "<div class=\"srcview\">" + rows + "</div>"
    return page_shell(g, rel_path + " · source", sidebar, content, "")
}

fn xpile_pane(fname, lang_label, code_html) {
    return "<figure class=\"xpile-pane\">" + "<pre class=\"code\"><code>" + code_html + "</code></pre>" + "<figcaption><span class=\"fname\">" + esc(fname) + "</span>" + "<span class=\"xpile-lang\">" + esc(lang_label) + "</span></figcaption></figure>"
}

fn rstrip_newlines(s) {
    let e = len(s)
    while e > 0 and byte_at(s, e - 1) == 10 { e = e - 1 }
    return s[:e]
}

fn transpiler_section(g, ex_name, blurb) {
    let purr_f = "gen/" + ex_name + ".purr"
    let cpp_f = "gen/" + ex_name + ".gen.cpp"
    if not os.path.isfile(purr_f) or not os.path.isfile(cpp_f) { return "" }
    let purr_html = highlight_block(g, rstrip_newlines(io.read_file(purr_f)), "purr")
    let cpp_html = highlight_block(g, rstrip_newlines(io.read_file(cpp_f)), "cpp")
    return "<section class=\"xpile-ex\" id=\"" + ex_name + "\">" + "<h2 class=\"group\"><code>" + ex_name + ".purr</code></h2>" + "<p class=\"xpile-blurb\">" + blurb + "</p>" + "<div class=\"xpile\">" + xpile_pane(ex_name + ".purr", "cheatah", purr_html) + xpile_pane(ex_name + ".gen.cpp", "C++", cpp_html) + "</div></section>"
}

fn render_transpiler_page(g, sidebar) {
    let ex_names = ["fizzbuzz", "http_response", "grades", "palette", "vectors", "numerics", "shapes"]
    let blurbs = [ "Ranges, <code>if</code>, floor division <code>//</code>, and string building.", "A <code>+</code>-chain self-append lowers to one chained <code>((head += a) += b) += c;</code> — no temporary per piece.", "A <code>struct</code> with a method, a <code>list</code>, and method-call (UFCS) syntax.", "A scoped <code>enum</code> with <code>match</code>/<code>case</code> — the <code>enum class</code> lowering, with a generated <code>operator&lt;&lt;</code>.", "<code>ndarray</code> arrays through <code>linalg</code> routines — the numeric core, with per-module namespace aliases (<code>ndarray::</code>, <code>linalg::</code>).", "Four modules linked into one program: <code>math</code>, <code>ndarray</code> and <code>linalg</code> each lower to an <code>#include</code> and a short namespace alias, solving a 3×3 system on the SIMD core.", "An <code>interface</code> lowers to a C++20 <b>concept</b> (a <code>static_assert</code> checks every <code>struct</code> that fulfills it), and an interface-typed parameter constrains the generated template — no inheritance."
    ]
    let sections = ""
    let toc_items = ""
    let i = 0
    while i < len(ex_names) {
        let s = transpiler_section(g, ex_names[i], blurbs[i])
        if s != "" {
            sections = sections + s
            toc_items = toc_items + "<li><a href=\"#" + ex_names[i] + "\">" + esc(ex_names[i]) + "</a></li>"
        }
        i = i + 1
    }
    let intro = "<p><code>purrc</code> is a <strong>transpiler</strong>: it compiles a " + "<code>.purr</code> program to modern C++ — the <code>.gen.cpp</code> shown on " + "the right — which is then built at <code>-O3 -march=native</code> into a loadable " + "module the <code>cheatah</code> runtime runs. The whole program is emitted inside a " + "<code>namespace cheatah_program</code>, where each module gets its own short alias " + "(<code>io::</code>, <code>ndarray::</code>, …) and the exported entry point is a " + "one-line <code>extern \"C\"</code> trampoline.</p>" + "<p>These are the programs in the repository's <code>gen/</code> folder; regenerate " + "them with <code>bash gen/generate.sh</code> to see how a language change moves the " + "output.</p>"
    let content = "<div class=\"page-head\"><div class=\"eyebrow\">Guide</div>" + "<h1>Transpiler</h1>" + "<p class=\"lede\">What <code>purrc</code> emits — every <code>gen/</code> " + "example, <code>.purr</code> beside its generated C++.</p></div>" + "<div class=\"overview\">" + intro + "</div>" + sections
    let toc = ""
    if toc_items != "" { toc = "<div class=\"toc-h\">On this page</div><ul>" + toc_items + "</ul>" }
    return page_shell(g, "Transpiler — how cheatah becomes C++", sidebar, content, toc)
}

# ---------------------------------------------------------------------------
# Extension subsites — manifests, changelogs, landing/releases pages, and the
# Biome Standard page. All data comes from the imported biome table and the
# sibling repos' own manifests/changelogs — nothing hand-maintained here.
# (Subsites carry no search index: the site is zero-JS by design.)
# ---------------------------------------------------------------------------

# Parse ../<ext>/cheatah.toml for the landing page's depends-on line and the
# standard page's dependency diagram. Both dependency shapes are normalized:
#   [extensions]   requires = ["cheatah-gpu"]      (list form)
#   [extensions]   cheatah-gpu = "v0.5.0-alpha"    (biome's own written form)
#   [dependencies] cheatah-gpu = ">=0.5.0"         (constraint form)
# Also reads [cheatah] version — the toolchain release the extension targets.
# A missing manifest is recorded honestly (ext_manifest=false -> "manifest pending").
fn load_ext_manifest(g, extname) {
    let path = "../" + extname + "/cheatah.toml"
    g.ext_deps[extname] = ""
    g.ext_toolchain[extname] = ""
    if not os.path.isfile(path) {
        g.ext_manifest[extname] = false
        return 0
    }
    g.ext_manifest[extname] = true
    let deps: list<str> = []
    let section = ""
    for raw in string.split(io.read_file(path), "\n") {
        let line = string.strip(raw)
        if len(line) == 0 { continue }
        if string.startswith(line, "#") { continue }
        if string.startswith(line, "[") {
            section = string.strip(line, "[]")
            continue
        }
        let eq = string.find(line, "=")
        if eq < 0 { continue }
        let key = string.strip(line[:eq])
        let val = string.strip(line[eq + 1:])
        if section == "cheatah" and key == "version" {
            g.ext_toolchain[extname] = string.strip(val, "\"")
        } elif section == "extensions" {
            if key == "requires" {
                for part in string.split(val, ",") {
                    let name = string.strip(part, " \t[]\"")
                    if name != "" and not list_contains(deps, name) { deps.append(name) }
                }
            } elif not list_contains(deps, key) {
                deps.append(key)          # biome's shape: the key IS the dependency
            }
        } elif section == "dependencies" {
            if string.startswith(key, "cheatah-") and not list_contains(deps, key) {
                deps.append(key)          # sibling-extension constraint; path deps stay out
            }
        }
    }
    let joined = ""
    let sep = ""
    for d in deps {
        joined = joined + sep + d
        sep = us()
    }
    g.ext_deps[extname] = joined
    return 0
}

# **bold** spans in already-plain changelog prose (escaped); an unpaired ** stays literal.
fn md_bold(s) {
    let parts = string.split(s, "**")
    let out = esc(parts[0])
    let i = 1
    while i < len(parts) {
        if i + 1 < len(parts) {
            out = out + "<strong>" + esc(parts[i]) + "</strong>" + esc(parts[i + 1])
            i = i + 2
        } else {
            out = out + "**" + esc(parts[i])
            i = i + 1
        }
    }
    return out
}

# Minimal Markdown-inline rendering for changelog text — `code` spans and **bold**
# (the constructs the sibling CHANGELOGs use); everything else is escaped prose.
# How many ** markers a prose run contains.
fn count_bold(s) {
    return len(string.split(s, "**")) - 1
}

# Minimal Markdown-inline rendering for changelog text — `code` spans and **bold**.
#
# Bold may WRAP a code span (`**`gpu.Buffer` and `gpu.Image`**`), so the ** markers CANNOT
# be paired inside each backtick-delimited segment independently: the opening and closing
# marker land in different segments and both survive as literal asterisks. So pair them
# across the whole line, carrying the open/closed state through the code spans, which are
# emitted verbatim and never affect it. An odd marker out stays literal, as before.
fn md_inline(s) {
    let parts = string.split(s, "`")
    let kinds = [""]
    let texts = [parts[0]]
    kinds[0] = "p"
    let i = 1
    while i < len(parts) {
        if i + 1 < len(parts) {
            kinds.append("c")
            texts.append(parts[i])
            kinds.append("p")
            texts.append(parts[i + 1])
            i = i + 2
        } else {
            kinds.append("p")            # a lone trailing backtick is literal text
            texts.append("`" + parts[i])
            i = i + 1
        }
    }
    let total = 0
    let k = 0
    while k < len(texts) {
        if kinds[k] == "p" { total = total + count_bold(texts[k]) }
        k = k + 1
    }
    let usable = total - (total % 2)     # an unpaired trailing ** is not a marker
    let seen = 0
    let open = false
    let out = ""
    k = 0
    while k < len(texts) {
        if kinds[k] == "c" {
            out = out + "<code>" + esc(texts[k]) + "</code>"
        } else {
            let segs = string.split(texts[k], "**")
            out = out + esc(segs[0])
            let j = 1
            while j < len(segs) {
                if seen < usable {
                    if open { out = out + "</strong>" } else { out = out + "<strong>" }
                    open = not open
                    seen = seen + 1
                } else {
                    out = out + "**"
                }
                out = out + esc(segs[j])
                j = j + 1
            }
        }
        k = k + 1
    }
    return out
}

# Render a sibling CHANGELOG.md as the releases-page body: '## ' headings become
# anchored release sections (#rel-N), '### ' subheads, '- ' bullets (indented
# continuation lines fold in), fenced code through the site highlighter, and the
# rest paragraphs. Returns "" when the file does not exist.
fn render_changelog_body(g, path) {
    if not os.path.isfile(path) { return "" }
    let out = ""
    let para = ""
    let list_html = ""
    let item = ""
    let code = ""
    let code_lang = ""
    let code_sep = ""
    let in_code = false
    let nrel = 0
    for raw in string.split(io.read_file(path), "\n") {
        let line = string.rstrip(raw, " \t\r")
        let sline = string.strip(line)
        if in_code {
            if string.startswith(sline, "```") {
                out = out + "<pre class=\"code\"><code>" + highlight_block(g, code, code_lang) + "</code></pre>"
                code = ""
                code_sep = ""
                in_code = false
            } else {
                code = code + code_sep + line
                code_sep = "\n"
            }
            continue
        }
        if string.startswith(sline, "```") {
            if para != "" { out = out + "<p>" + md_inline(para) + "</p>" }
            para = ""
            if item != "" { list_html = list_html + "<li>" + md_inline(item) + "</li>" }
            item = ""
            if list_html != "" { out = out + "<ul>" + list_html + "</ul>" }
            list_html = ""
            in_code = true
            code_lang = "purr"
            if string.contains(sline, "cpp") or string.contains(sline, "c++") { code_lang = "cpp" }
            continue
        }
        let is_h2 = string.startswith(line, "## ")
        let is_h3 = string.startswith(line, "### ")
        if is_h3 { is_h2 = false }
        let is_bullet = string.startswith(line, "- ")
        if is_h2 or is_h3 or is_bullet or sline == "" or string.startswith(line, "# ") {
            # every structural boundary flushes the open paragraph/list
            if para != "" { out = out + "<p>" + md_inline(para) + "</p>" }
            para = ""
            if is_bullet {
                if item != "" { list_html = list_html + "<li>" + md_inline(item) + "</li>" }
                item = sline[2:]
                continue
            }
            if item != "" { list_html = list_html + "<li>" + md_inline(item) + "</li>" }
            item = ""
            if list_html != "" { out = out + "<ul>" + list_html + "</ul>" }
            list_html = ""
            if is_h2 {
                nrel = nrel + 1
                out = out + "<h2 class=\"group\" id=\"rel-" + str(nrel) + "\">" + md_inline(string.strip(line[3:])) + "</h2>"
            } elif is_h3 {
                out = out + "<h3>" + md_inline(string.strip(line[4:])) + "</h3>"
            }
            # a '# ' page title and blank lines emit nothing themselves
            continue
        }
        if item != "" and string.startswith(line, " ") {
            item = item + " " + sline              # bullet continuation line
            continue
        }
        if item != "" {
            list_html = list_html + "<li>" + md_inline(item) + "</li>"
            item = ""
            out = out + "<ul>" + list_html + "</ul>"
            list_html = ""
        }
        if para != "" { para = para + " " }
        para = para + sline
    }
    if para != "" { out = out + "<p>" + md_inline(para) + "</p>" }
    if item != "" { list_html = list_html + "<li>" + md_inline(item) + "</li>" }
    if list_html != "" { out = out + "<ul>" + list_html + "</ul>" }
    if in_code and code != "" {
        out = out + "<pre class=\"code\"><code>" + highlight_block(g, code, code_lang) + "</code></pre>"
    }
    return out
}

# The latest release headline of a CHANGELOG: its first '## ' heading, skipping a
# leading "Unreleased" section (work that has not shipped is not a release).
fn first_release_heading(path) {
    if not os.path.isfile(path) { return "" }
    for line in string.split(io.read_file(path), "\n") {
        if string.startswith(line, "## ") {
            let h = string.strip(line[3:])
            if not string.startswith(h, "Unreleased") { return h }
        }
    }
    return ""
}

# One node of a subsite's module tree, nested like the core sidebar. `kids` maps
# an owner short name to <US>-joined child comp indices; `present` marks which
# shorts have a page in THIS extension — a namespace whose parent has no page
# keeps its full dotted label (e.g. `gpu.linalg` when `gpu` itself is empty).
fn ext_side_node(g, kids, present, idx) -> str {
    let c = g.comps[idx]
    let label = c.short
    let cut = string.rfind(label, "::")
    if cut >= 0 {
        if label[:cut] in present {
            label = label[cut + 2:]
        } else {
            label = string.replace(label, "::", ".")
        }
    }
    let link = "<a href=\"" + c.refid + ".html\" data-ref=\"" + c.refid + "\">" + esc(label) + "</a>"
    if c.short in kids {
        let inner = ""
        for k in string.split(kids[c.short], us()) {
            if k != "" { inner = inner + "<li>" + ext_side_node(g, kids, present, requests.parse_uint(k)) + "</li>" }
        }
        if inner != "" {
            return "<details class=\"side-sub\"><summary>" + link + "</summary><ul>" + inner + "</ul></details>"
        }
    }
    return link
}

# The subsite sidebar for one extension: Overview -> its landing page, Releases ->
# its changelog page, the way back to the core docs, then this extension's own
# module tree (nested exactly like the core Modules group).
fn build_ext_sidebar(g, extname) {
    let parts = "<a class=\"side-home\" href=\"index.html\">Overview</a>"
    parts = parts + "<div class=\"side-group\"><ul>" + "<li><a href=\"releases.html\" data-ref=\"releases\">Releases</a></li>" + "<li><a href=\"../index.html\">cheatah docs</a></li>" + "</ul></div>"
    let present: dict<str, bool> = {}
    let ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "namespace" and c.ext == extname { present[c.short] = true }
        ci = ci + 1
    }
    let kid_keys: dict<str, str> = {}
    ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "namespace" and c.ext == extname and string.contains(c.short, "::") {
            let cut = string.rfind(c.short, "::")
            let parent = c.short[:cut]
            if parent in present {
                let prev = ""
                if parent in kid_keys { prev = kid_keys[parent] + us() }
                kid_keys[parent] = prev + string.lower(c.short) + us() + str(ci)
            }
        }
        ci = ci + 1
    }
    let kids: dict<str, str> = {}
    for kv in kid_keys { kids[kv.first] = sort_pair_refids(kv.second) }
    let top_keys: list<str> = []
    ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "namespace" and c.ext == extname {
            let is_top = not string.contains(c.short, "::")
            if not is_top {
                let cut = string.rfind(c.short, "::")
                if not (c.short[:cut] in present) { is_top = true }
            }
            if is_top { top_keys.append(string.lower(string.replace(c.short, "::", ".")) + us() + str(ci)) }
        }
        ci = ci + 1
    }
    let mods = ""
    for k in sorted_strs(top_keys) {
        let cut = string.rfind(k, us())
        mods = mods + "<li class=\"side-mod\">" + ext_side_node(g, kids, present, requests.parse_uint(k[cut + 1:])) + "</li>"
    }
    if mods != "" {
        parts = parts + "<div class=\"side-group\"><div class=\"side-h\">Modules</div><ul>" + mods + "</ul></div>"
    }
    return parts
}

# The subsite landing page (docs/html/<ext>/index.html): what the package is, its
# release + standard badge, what it depends on, its modules, and its releases.
fn render_ext_home(g, extname, sidebar) {
    let desc = biome.extension_desc(extname)
    let badge = ext_badge_of(extname)
    let dep_html = ""
    if extname in g.ext_manifest and g.ext_manifest[extname] {
        dep_html = "<a href=\"../index.html\">cheatah</a>"
        let tv = g.ext_toolchain[extname]
        if tv != "" { dep_html = dep_html + " (toolchain v" + esc(tv) + ")" }
        for d in string.split(g.ext_deps[extname], us()) {
            if d == "" { continue }
            if list_contains(g.ext_names, d) {
                dep_html = dep_html + " · <a href=\"../" + esc(d) + "/index.html\">" + esc(d) + "</a>"
            } else {
                dep_html = dep_html + " · " + esc(d)
            }
        }
    } else {
        dep_html = "<em>manifest pending</em> — this extension's <code>cheatah.toml</code> has not landed yet"
    }
    let keys: list<str> = []
    let ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "namespace" and c.ext == extname {
            keys.append(string.lower(string.replace(c.short, "::", ".")) + us() + str(ci))
        }
        ci = ci + 1
    }
    let rows = ""
    for k in sorted_strs(keys) {
        let cut = string.rfind(k, us())
        let c = g.comps[requests.parse_uint(k[cut + 1:])]
        let cdoc = doc_of(xdir_of(c), c.refid)
        let brief = render_brief(g, cdoc, c.brief_id)
        rows = rows + "<tr><td><a href=\"" + c.refid + ".html\" class=\"mod-link\"><code>" + esc(string.replace(c.short, "::", ".")) + "</code></a></td><td>" + brief + "</td></tr>"
    }
    let table = ""
    if rows != "" {
        table = "<h2 class=\"group\">Modules</h2><div class=\"tscroll\" tabindex=\"0\"><table class=\"dtable\"><tr><th scope=\"col\">Module</th><th scope=\"col\">What it gives you</th></tr>" + rows + "</table></div>"
    } else {
        table = "<p>No documented modules yet — this extension's API pages appear here as soon as its headers carry documented symbols.</p>"
    }
    let desc_html = ""
    if desc != "" { desc_html = "\n  <p class=\"lede\">" + esc(desc) + "</p>" }
    let content = "<div class=\"page-head\">\n" + "  <div class=\"eyebrow\">Extension</div>\n" + "  <h1><code>" + esc(extname) + "</code></h1>\n" + "  <p class=\"ext-badge\">" + esc(badge) + "</p>" + desc_html + "\n" + "</div>\n" + "<p class=\"ext-deps\">Depends on: " + dep_html + "</p>\n" + table + "\n" + "<p><a href=\"releases.html\">Release history</a> · <a href=\"../standard.html\">The Biome Standard</a></p>"
    return page_shell_in(g, extname, extname, sidebar, content, "")
}

# The subsite releases page (docs/html/<ext>/releases.html): the sibling repo's
# CHANGELOG.md, release by release; no changelog yet is said out loud.
fn render_ext_releases(g, extname, sidebar) {
    let path = "../" + extname + "/CHANGELOG.md"
    let body = render_changelog_body(g, path)
    let toc = ""
    if body == "" {
        body = "<p>No releases yet — <code>" + esc(extname) + "</code> has not cut a tagged release. Its <code>CHANGELOG.md</code> renders here the day the first one lands.</p>"
    } else {
        let items = ""
        let n = 0
        for line in string.split(io.read_file(path), "\n") {
            if string.startswith(line, "## ") and not string.startswith(line, "### ") {
                n = n + 1
                items = items + "<li><a href=\"#rel-" + str(n) + "\">" + esc(string.strip(line[3:])) + "</a></li>"
            }
        }
        if items != "" { toc = "<div class=\"toc-h\">Releases</div><ul>" + items + "</ul>" }
    }
    let content = "<div class=\"page-head\">\n" + "  <div class=\"eyebrow\">Releases</div>\n" + "  <h1><code>" + esc(extname) + "</code></h1>\n" + "  <p class=\"lede\">Every notable change, release by release.</p>\n" + "</div>\n" + body
    return page_shell_in(g, extname, extname + " releases", sidebar, content, toc)
}

# The dependency diagram on the standard page: one box per site package, arrows
# for the depends-on edges parsed from the manifests. Static inline SVG themed
# through the site's CSS variables — no scripts, no external assets. Layers:
# cheatah at the bottom, extensions standing on the stdlib alone above it, and
# extensions built on other extensions on top.
fn dep_diagram_svg(g) {
    let box_h = 44
    let geo: dict<str, str> = {}      # name -> "x<US>y<US>w"
    # cheatah: one wide box at the bottom
    geo["cheatah"] = "190" + us() + "232" + us() + "240"
    let l1: list<str> = []
    let l2: list<str> = []
    for e in g.ext_names {
        if g.ext_deps[e] == "" { l1.append(e) } else { l2.append(e) }
    }
    # place a layer's boxes: evenly spread, centered on the 620-unit canvas
    let li = 0
    while li < 2 {
        let row = l1
        let y = 124
        if li == 1 {
            row = l2
            y = 16
        }
        let total = 0
        for e in row {
            let label = e
            if string.startswith(e, "cheatah-") { label = e[8:] }
            total = total + 28 + 9 * len(label)
        }
        if len(row) > 1 { total = total + 48 * (len(row) - 1) }
        let x = (620 - total) // 2
        for e in row {
            let label = e
            if string.startswith(e, "cheatah-") { label = e[8:] }
            let w = 28 + 9 * len(label)
            geo[e] = str(x) + us() + str(y) + us() + str(w)
            x = x + w + 48
        }
        li = li + 1
    }
    # boxes (each linking its package) …
    let boxes = ""
    let names: list<str> = ["cheatah"]
    for e in g.ext_names { names.append(e) }
    for name in names {
        let toks = string.split(geo[name], us())
        let bx = requests.parse_uint(toks[0])
        let by = requests.parse_uint(toks[1])
        let bw = requests.parse_uint(toks[2])
        let label = name
        if string.startswith(name, "cheatah-") { label = name[8:] }
        let href = "index.html"
        let cls = "dep-box dep-box-core"
        if name != "cheatah" {
            href = name + "/index.html"
            cls = "dep-box"
        }
        boxes = boxes + "<a href=\"" + esc(href) + "\"><rect class=\"" + cls + "\" x=\"" + str(bx) + "\" y=\"" + str(by) + "\" width=\"" + str(bw) + "\" height=\"" + str(box_h) + "\" rx=\"9\"/>" + "<text x=\"" + str(bx + bw // 2) + "\" y=\"" + str(by + 27) + "\" text-anchor=\"middle\">" + esc(label) + "</text></a>"
    }
    # … and the depends-on arrows (an extension with no extension deps stands on cheatah)
    let edges = ""
    for e in g.ext_names {
        let dep_list = g.ext_deps[e]
        if dep_list == "" { dep_list = "cheatah" }
        for d in string.split(dep_list, us()) {
            if d == "" { continue }
            if not (d in geo) { continue }
            let a = string.split(geo[e], us())
            let b = string.split(geo[d], us())
            let ax = requests.parse_uint(a[0])
            let ay = requests.parse_uint(a[1])
            let aw = requests.parse_uint(a[2])
            let bx = requests.parse_uint(b[0])
            let by = requests.parse_uint(b[1])
            let bw = requests.parse_uint(b[2])
            if ay == by {
                # same layer: a short horizontal arrow between box edges
                let y = ay + box_h // 2
                let x1 = ax + aw
                let x2 = bx - 3
                if bx < ax {
                    x1 = ax
                    x2 = bx + bw + 3
                }
                edges = edges + "<line class=\"dep-edge\" x1=\"" + str(x1) + "\" y1=\"" + str(y) + "\" x2=\"" + str(x2) + "\" y2=\"" + str(y) + "\" marker-end=\"url(#dep-arrow)\"/>"
            } else {
                edges = edges + "<line class=\"dep-edge\" x1=\"" + str(ax + aw // 2) + "\" y1=\"" + str(ay + box_h) + "\" x2=\"" + str(bx + bw // 2) + "\" y2=\"" + str(by - 3) + "\" marker-end=\"url(#dep-arrow)\"/>"
            }
        }
    }
    return "<svg class=\"dep-svg\" viewBox=\"0 0 620 300\" role=\"img\" aria-label=\"Dependency diagram: extensions stack on the cheatah toolchain\">" + "<defs><marker id=\"dep-arrow\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path class=\"dep-arrowhead\" d=\"M0,0 L8,4 L0,8 z\"/></marker></defs>" + edges + boxes + "</svg>"
}

# docs/html/standard.html — the Biome Standard page: the current standard's
# member table, the append-only history, the dependency diagram, and the
# latest-release rollup across every site package.
fn render_standard_page(g, sidebar) {
    let cur = current_standard()
    let rows = ""
    for c in cur.components {
        let link = "<code>" + esc(c.name) + "</code>"
        if c.name == "cheatah" {
            link = "<a href=\"index.html\"><code>cheatah</code></a>"
        } elif list_contains(g.ext_names, c.name) {
            link = "<a href=\"" + esc(c.name) + "/index.html\"><code>" + esc(c.name) + "</code></a>"
        }
        let what = "the language toolchain + standard library"
        if c.name != "cheatah" { what = biome.extension_desc(c.name) }
        rows = rows + "<tr><td>" + link + "</td><td><code>" + esc(c.tag) + "</code></td><td>" + esc(what) + "</td></tr>"
    }
    let pending = ""
    let psep = ""
    for e in g.ext_names {
        if biome.component_tag(cur, e) == "" {
            pending = pending + psep + "<a href=\"" + esc(e) + "/index.html\"><code>" + esc(e) + "</code></a>"
            psep = ", "
        }
    }
    let pending_html = ""
    if pending != "" {
        pending_html = "<p>" + pending + " — documented on this site but not yet members: each joins the next standard once it passes the cross-member gate.</p>"
    }
    let hist = ""
    let all = biome.known_standards()
    let i = 0
    while i < len(all) {
        let s = all[i]
        let comps = ""
        let csep = ""
        for c in s.components {
            comps = comps + csep + "<code>" + esc(c.name) + " " + esc(c.tag) + "</code>"
            csep = " · "
        }
        # the table reads newest-first: prepend each (append-only) table entry
        hist = "<tr><td><strong>" + esc(s.version) + "</strong></td><td>" + esc(s.released) + "</td><td>" + esc(s.status) + "</td><td>" + comps + "</td></tr>" + hist
        i = i + 1
    }
    let roll = ""
    let core_head = first_release_heading("CHANGELOG.md")
    if core_head != "" {
        roll = roll + "<tr><td><a href=\"index.html\"><code>cheatah</code></a></td><td>" + md_inline(core_head) + " — <a href=\"md_CHANGELOG.html\">release notes</a></td></tr>"
    }
    for e in g.ext_names {
        let h = first_release_heading("../" + e + "/CHANGELOG.md")
        let cell = "<em>no releases yet</em>"
        if h != "" {
            cell = md_inline(h) + " — <a href=\"" + esc(e) + "/releases.html\">release notes</a>"
        }
        roll = roll + "<tr><td><a href=\"" + esc(e) + "/index.html\"><code>" + esc(e) + "</code></a></td><td>" + cell + "</td></tr>"
    }
    let content = "<div class=\"page-head\">\n" + "  <div class=\"eyebrow\">Versioning</div>\n" + "  <h1>The Biome Standard</h1>\n" + "  <p class=\"lede\">One user-facing version naming a set of component releases — the cheatah toolchain plus extensions — tested to work together. A project pins one standard in its <code>cheatah.toml</code>; <a href=\"biome.html\">biome</a> resolves every component tag from it.</p>\n" + "</div>\n" + "<h2 class=\"group\" id=\"current\">Current — Biome Standard " + esc(cur.version) + "</h2>" + "<p>Released " + esc(cur.released) + ". The tested-together members:</p>" + "<div class=\"tscroll\" tabindex=\"0\"><table class=\"dtable\"><tr><th scope=\"col\">Component</th><th scope=\"col\">Release</th><th scope=\"col\">What it is</th></tr>" + rows + "</table></div>" + pending_html + "<h2 class=\"group\" id=\"deps\">How the packages stack</h2>" + "<p>Dependency edges come from each repo's own <code>cheatah.toml</code> manifest; every extension stands on the cheatah toolchain.</p>" + dep_diagram_svg(g) + "<h2 class=\"group\" id=\"history\">History</h2>" + "<p>Append-only: once released, only a standard's status line ever changes.</p>" + "<div class=\"tscroll\" tabindex=\"0\"><table class=\"dtable\"><tr><th scope=\"col\">Standard</th><th scope=\"col\">Released</th><th scope=\"col\">Status</th><th scope=\"col\">Members</th></tr>" + hist + "</table></div>" + "<h2 class=\"group\" id=\"rollup\">Latest release notes</h2>" + "<div class=\"tscroll\" tabindex=\"0\"><table class=\"dtable\"><tr><th scope=\"col\">Package</th><th scope=\"col\">Latest release</th></tr>" + roll + "</table></div>"
    let toc = "<div class=\"toc-h\">On this page</div><ul>" + "<li><a href=\"#current\">Current standard</a></li>" + "<li><a href=\"#deps\">How the packages stack</a></li>" + "<li><a href=\"#history\">History</a></li>" + "<li><a href=\"#rollup\">Latest release notes</a></li>" + "</ul>"
    return page_shell_in(g, "standard", "The Biome Standard", sidebar, content, toc)
}

# ---------------------------------------------------------------------------
# Loading
# ---------------------------------------------------------------------------

fn text_of_child(doc, id, ctag) {
    let n = parsers.xml.find(doc, id, ctag)
    if n < 0 { return "" }
    return first_text(doc, n)
}

# "…/stdlib/<mod>/<leaf>"? -> the module name, else "". `leaf` is "/README.md" (folded into
# the module page) or "/BENCHMARKS.md" (the module's benchmark subpage).
fn md_module_of(path, leaf) {
    if not string.endswith(path, leaf) { return "" }
    let dirpath = path[:len(path) - len(leaf)]
    let cut = string.rfind(dirpath, "/")
    if cut < 0 { return "" }
    let mod = dirpath[cut + 1:]
    let parent = dirpath[:cut]
    if parent == "stdlib" or string.endswith(parent, "/stdlib") {
        # every char of mod must be \w (the Python pattern is stdlib/(\w+)/README\.md$)
        let i = 0
        while i < len(mod) {
            if not is_word_b(byte_at(mod, i)) { return "" }
            i = i + 1
        }
        if mod != "" { return mod }
    }
    return ""
}

fn is_internal_namespace(nsname) {
    for seg in string.split(nsname, "::") {
        if seg == "detail" { return true }
        if string.contains(seg, "anonymous") { return true }
        if string.startswith(seg, "@") { return true }
    }
    return false
}

# Parse index.xml + every compound XML into g.
fn load_all(g) {
    let idx = parsers.xml.parse(io.read_file("docs/xml/index.xml"))
    let idx_root = parsers.xml.find(idx, parsers.xml.root(idx), "doxygenindex")
    for c in parsers.xml.findall(idx, idx_root, "compound") {
        let kind = parsers.xml.attr(idx, c, "kind")
        if kind != "namespace" and kind != "class" and kind != "page" { continue }
        let refid = parsers.xml.attr(idx, c, "refid")
        let cdoc = parsers.xml.parse(io.read_file("docs/xml/" + refid + ".xml"))
        let dox = parsers.xml.find(cdoc, parsers.xml.root(cdoc), "doxygen")
        let cdef = parsers.xml.find(cdoc, dox, "compounddef")
        if cdef < 0 { continue }
        if kind == "page" {
            let loc = parsers.xml.find(cdoc, cdef, "location")
            let lfile = ""
            if loc >= 0 { lfile = parsers.xml.attr(cdoc, loc, "file") }
            if lfile != "" {
                # Doxygen records the path it was given (repo-relative) or an absolute one;
                # either way a relative link from another document resolves to this page.
                let relf = lfile
                let here = os.getcwd() + "/"
                if string.startswith(relf, here) { relf = relf[len(here):] }
                g.page_by_file[relf] = refid
            }
            let mod = md_module_of(lfile, "/README.md")
            if mod != "" {
                g.readme_key[mod] = refid
                g.readme_node[mod] = parsers.xml.find(cdoc, cdef, "detaileddescription")
                continue
            }
            let bmod = md_module_of(lfile, "/BENCHMARKS.md")
            if bmod != "" {
                # not a compound: it is neither a Guide in the sidebar nor a page of its own
                # in the generic loop — main() renders it as the module's benchmark subpage
                g.bench_key[bmod] = refid
                g.bench_node[bmod] = parsers.xml.find(cdoc, cdef, "detaileddescription")
                g.bench_title[bmod] = text_of_child(cdoc, cdef, "title")
                continue
            }
        }
        let cname = text_of_child(cdoc, cdef, "compoundname")
        if cname == "" { cname = text_of_child(idx, c, "name") }
        if cname == "" { cname = refid }
        if kind == "namespace" and is_internal_namespace(cname) { continue }
        let comp = Compound({.refid = refid, .kind = kind, .name = cname})
        comp.short = string.replace(cname, "cheatah::", "")
        comp.title = text_of_child(cdoc, cdef, "title")
        if comp.title == "" { comp.title = comp.short }
        comp.brief_id = parsers.xml.find(cdoc, cdef, "briefdescription")
        comp.detail_id = parsers.xml.find(cdoc, cdef, "detaileddescription")
        if kind == "namespace" {
            g.mod_short[refid] = string.replace(comp.short, "::", ".")
        }
        let seen_ids: dict<str, bool> = {}
        for md in parsers.xml.iter(cdoc, cdef, "memberdef") {
            let mid = parsers.xml.attr(cdoc, md, "id")
            if mid in seen_ids { continue }
            seen_ids[mid] = true
            let m = Member({.id = mid})
            m.kind = parsers.xml.attr(cdoc, md, "kind")
            m.is_static = parsers.xml.attr(cdoc, md, "static") == "yes"
            m.name = text_of_child(cdoc, md, "name")
            m.type_id = parsers.xml.find(cdoc, md, "type")
            m.args = string.strip(text_of_child(cdoc, md, "argsstring"))
            m.brief_id = parsers.xml.find(cdoc, md, "briefdescription")
            m.detail_id = parsers.xml.find(cdoc, md, "detaileddescription")
            m.compound = refid
            let loc = parsers.xml.find(cdoc, md, "location")
            if loc >= 0 {
                m.srcfile = parsers.xml.attr(cdoc, loc, "bodyfile")
                if m.srcfile == "" { m.srcfile = parsers.xml.attr(cdoc, loc, "declfile") }
                if m.srcfile == "" { m.srcfile = parsers.xml.attr(cdoc, loc, "file") }
                m.srcline = parsers.xml.attr(cdoc, loc, "bodystart")
                if m.srcline == "" { m.srcline = parsers.xml.attr(cdoc, loc, "declline") }
                if m.srcline == "" { m.srcline = parsers.xml.attr(cdoc, loc, "line") }
                # the declaring header gets a listing too: a README's `[foo.hpp](foo.hpp)`
                # link lands on the doc comments, not only on the body in foo.cpp
                let decl = parsers.xml.attr(cdoc, loc, "declfile")
                if decl == "" { decl = parsers.xml.attr(cdoc, loc, "file") }
                if decl != "" { g.decl_files[decl] = true }
            }
            comp.members.append(m)
            g.mi[mid] = refid
        }
        if comp.kind == "namespace" and len(comp.members) == 0 { continue }
        g.comp_idx[refid] = len(g.comps)
        g.comps.append(comp)
    }
}

# Parse one extension's Doxygen XML tree (docs/xml-ext/<ext>/): its namespaces —
# plus classes, structs and concepts — become the pages of that extension's
# SUBSITE (docs/html/<ext>/). Loaded fully apart from the stdlib so the stdlib
# output stays identical whether or not an extension tree is present. Extension
# compounds are deliberately NOT registered in g.comp_idx: an extension may
# document a namespace the stdlib also owns (cheatah-gpu-linalg overloads
# `cheatah::linalg`), and the shared refid must keep resolving to the CORE page.
fn load_ext_tree(g, extname) {
    let xdir = "docs/xml-ext/" + extname
    let idx = parsers.xml.parse(io.read_file(xdir + "/index.xml"))
    let idx_root = parsers.xml.find(idx, parsers.xml.root(idx), "doxygenindex")
    for c in parsers.xml.findall(idx, idx_root, "compound") {
        let kind = parsers.xml.attr(idx, c, "kind")
        if kind != "namespace" and kind != "class" and kind != "struct" and kind != "concept" { continue }
        let refid = parsers.xml.attr(idx, c, "refid")
        let cdoc = parsers.xml.parse(io.read_file(xdir + "/" + refid + ".xml"))
        let dox = parsers.xml.find(cdoc, parsers.xml.root(cdoc), "doxygen")
        let cdef = parsers.xml.find(cdoc, dox, "compounddef")
        if cdef < 0 { continue }
        let cname = text_of_child(cdoc, cdef, "compoundname")
        if cname == "" { cname = text_of_child(idx, c, "name") }
        if cname == "" { cname = refid }
        if is_internal_namespace(cname) { continue }
        let comp = Compound({.refid = refid, .kind = kind, .name = cname, .ext = extname})
        comp.short = string.replace(cname, "cheatah::", "")
        comp.title = text_of_child(cdoc, cdef, "title")
        if comp.title == "" { comp.title = comp.short }
        comp.brief_id = parsers.xml.find(cdoc, cdef, "briefdescription")
        comp.detail_id = parsers.xml.find(cdoc, cdef, "detaileddescription")
        let seen_ids: dict<str, bool> = {}
        for md in parsers.xml.iter(cdoc, cdef, "memberdef") {
            let mid = parsers.xml.attr(cdoc, md, "id")
            if mid in seen_ids { continue }
            seen_ids[mid] = true
            let m = Member({.id = mid})
            m.kind = parsers.xml.attr(cdoc, md, "kind")
            m.is_static = parsers.xml.attr(cdoc, md, "static") == "yes"
            m.name = text_of_child(cdoc, md, "name")
            m.type_id = parsers.xml.find(cdoc, md, "type")
            m.args = string.strip(text_of_child(cdoc, md, "argsstring"))
            m.brief_id = parsers.xml.find(cdoc, md, "briefdescription")
            m.detail_id = parsers.xml.find(cdoc, md, "detaileddescription")
            m.compound = refid
            # extension sources live in the sibling repo: no source pages/links
            comp.members.append(m)
            g.mi[mid] = refid
        }
        # an empty namespace (e.g. the bare `cheatah` container) has no page;
        # classes/structs/concepts keep theirs even when memberless
        if kind == "namespace" and len(comp.members) == 0 { continue }
        g.comps.append(comp)
        g.valid[refid] = true
    }
}

fn files_sorted(dirpath, exts) {
    let out: list<str> = []
    if not os.path.isdir(dirpath) { return out }
    for f in os.listdir(dirpath) {
        for e in exts {
            if string.endswith(f, e) { out.append(f) }
        }
    }
    return sorted_strs(out)
}

fn cpp_files_sorted(dirpath) { return files_sorted(dirpath, [".cpp"]) }

# The programs that measured every published table get a source page, so a benchmark
# page can link the harness beside the numbers and the link resolves on the site.
fn harness_sources() {
    let out: list<str> = []
    for d in ["tests/benchmarks", "stdlib/regex/bench", "scripts/bench"] {
        for f in files_sorted(d, [".cpp", ".hpp", ".purr", ".py", ".sh"]) { out.append(d + "/" + f) }
    }
    for f in ["scripts/numpy_compare.py", "scripts/perf_suite.py", "scripts/app_compare.purr", "scripts/bench_run.sh", "scripts/bench_gate.sh", "docs/gen-cheatah/gen_bench.purr", "docs/gen-cheatah/gen_bench_parallel.purr", "docs/gen-cheatah/gen_bench_compare.purr", "docs/gen-cheatah/gen_bench.py"] {
        out.append(f)
    }
    return out
}

fn build_test_index(g) {
    for tdir in ["stdlib/tests", "stdlib/memory/tests", "tests/purrc"] {
        for f in cpp_files_sorted(tdir) {
            let rel = tdir + "/" + f
            let lineno = 1
            for line in string.splitlines(io.read_file(rel)) {
                let hit = find_test_in_line(line)
                if hit != "" {
                    let cut = string.find(hit, us())
                    g.test_index[hit[:cut] + "." + hit[cut + 1:]] = rel + us() + str(lineno)
                }
                lineno = lineno + 1
            }
        }
    }
}

fn qual_module_of(qual) {
    if qual == "" { return "builtins" }
    if qual == "math" or qual == "io" or qual == "string" or qual == "ndarray" or qual == "linalg" or qual == "os" or qual == "socket" or qual == "statistics" or qual == "random" or qual == "hashlib" or qual == "datetime" or qual == "time" {
        return qual
    }
    if qual == "os.path" { return "os::path" }
    return us()          # sentinel: not a mapped module
}

# Scan the app system tests: (module, function) -> the system tests calling it.
fn build_app_usage(g) {
    let raw: dict<str, bool> = {}
    for f in cpp_files_sorted("tests/purrc") {
        if not string.startswith(f, "app_") { continue }
        let text = io.read_file("tests/purrc/" + f)
        let tname = ""
        for line in string.splitlines(text) {
            let hit = find_test_in_line(line)
            if hit != "" {
                let cut = string.find(hit, us())
                tname = hit[:cut] + "." + hit[cut + 1:]
                break
            }
        }
        if tname == "" { continue }
        let a = string.find(text, "R\"PURR(")
        if a < 0 { continue }
        let b = string.find(text[a:], ")PURR\"")
        if b < 0 { continue }
        let purr = text[a + 7:a + b]
        # every `qual.func(` call site
        let i = 0
        while i < len(purr) {
            let bb = byte_at(purr, i)
            if is_word_b(bb) {
                let segs: list<str> = []
                let j = i
                while true {
                    let s0 = j
                    while is_word_b(byte_at(purr, j)) { j = j + 1 }
                    segs.append(purr[s0:j])
                    if byte_at(purr, j) == 46 and is_word_b(byte_at(purr, j + 1)) {
                        j = j + 1
                    } else { break }
                }
                let k = j
                while is_space_b(byte_at(purr, k)) { k = k + 1 }
                if byte_at(purr, k) == 40 and len(segs) > 0 {
                    let qual = ""
                    let qsep = ""
                    let si = 0
                    while si + 1 < len(segs) {
                        qual = qual + qsep + segs[si]
                        qsep = "."
                        si = si + 1
                    }
                    let mod = qual_module_of(qual)
                    if mod != us() {
                        raw[mod + us() + segs[len(segs) - 1] + us() + tname] = true
                    }
                    i = k + 1
                    continue
                }
                i = j
            } else {
                i = i + 1
            }
        }
    }
    # group "mod<US>func<US>test" -> app_usage["mod<US>func"] = sorted joined tests
    let grouped: dict<str, str> = {}
    for kv in raw {
        let key = kv.first
        let c2 = string.rfind(key, us())
        let mk = key[:c2]
        let tname = key[c2 + 1:]
        let prev = ""
        if mk in grouped { prev = grouped[mk] + us() }
        grouped[mk] = prev + tname
    }
    for kv in grouped {
        let names = sorted_strs(string.split(kv.second, us()))
        let joined = ""
        let sep = ""
        for n in names {
            joined = joined + sep + n
            sep = us()
        }
        g.app_usage[kv.first] = joined
    }
}

fn add_kw(d, words) {
    for w in string.split(words, " ") { d[w] = true }
}

fn write_file(path, content) {
    # extension subsites live in subdirectories (docs/html/<ext>/…)
    let cut = string.rfind(path, "/")
    if cut > 0 {
        let dir = path[:cut]
        if not os.path.isdir(dir) { os.makedirs(dir) }
    }
    with io.open(path, "w") as f {
        f.write(content)
    }
}

# Walk a description subtree registering section/anchor ids as valid link targets.
fn register_anchors(g, doc, id) {
    if id < 0 { return 0 }
    let stack = [id]
    while len(stack) > 0 {
        let last = len(stack) - 1
        let n = stack[last]
        let next_stack: list<int> = []
        let i = 0
        while i < last {
            next_stack.append(stack[i])
            i = i + 1
        }
        stack = next_stack
        if parsers.xml.is_element(doc, n) {
            let t = parsers.xml.tag(doc, n)
            if t == "sect1" or t == "sect2" or t == "sect3" or t == "sect4" or t == "anchor" {
                let sid = parsers.xml.attr(doc, n, "id")
                if sid != "" { g.valid[sid] = true }
            }
            for c in parsers.xml.children(doc, n) { stack.append(c) }
        }
    }
    return 0
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

fn main() {
    if not os.path.isdir("docs/xml") {
        io.print("generate: docs/xml not found — run Doxygen with GENERATE_XML=YES first")
        return
    }
    let g = Gen({.cur_module = "", .in_ext = false})
    # Where this tree is served. The ONLY absolute-URL knob in the generator — everything
    # else is bare-relative on purpose — and it exists so the pages can carry an absolute
    # rel="canonical" (see seo_head). Slash-terminated; canon_url appends to it directly.
    g.site_base = os.getenv("DOCS_BASE_URL", "https://bigbrain-technology.com/docs/cheatah-docs/")

    # highlighter vocabularies (the compiler's keywords + Python's, minus literals)
    add_kw(g.kw, "and as break case constexpr continue elif else enum except false fn for from if import in interface let match not or raise return struct true try while with")
    add_kw(g.kw, "def class lambda yield pass global nonlocal del assert finally is await async")
    add_kw(g.consts, "true false None True False")
    add_kw(g.cpp_kw, "alignas alignof auto bool break case char class concept const constexpr continue decltype default delete do double else enum explicit extern float for friend if inline int long mutable namespace new noexcept nullptr operator private protected public requires return short signed sizeof static static_assert struct switch template this throw true false try typedef typename union unsigned using virtual void volatile while")
    add_kw(g.cpp_consts, "true false nullptr")
    add_kw(g.block_tags, "parameterlist simplesect xrefsect itemizedlist orderedlist variablelist table programlisting hruler sect1 sect2 sect3")

    # per-function perf numbers (regenerated by scripts/perf_suite.py, not the gate)
    if os.path.isfile("docs/perf_data.json") {
        let pd = PerfData({.meta = PerfMeta({.numpy = ""})})
        if parsers.json.read(io.read_file("docs/perf_data.json"), pd) {
            g.perf = pd.functions
            g.perf_numpy = pd.meta.numpy
            g.perf_cpython = pd.meta.cpython
            let i = 0
            while i < len(g.perf) {
                g.perf_i[g.perf[i].name] = i
                i = i + 1
            }
        }
    }

    load_all(g)
    let ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "namespace" { g.modules[c.short] = c.refid }
        g.valid[c.refid] = true
        ci = ci + 1
    }
    # A markdown link to a module's README.md or BENCHMARKS.md arrives as a <ref> to that
    # page's refid: both are valid targets, resolved to where they actually render.
    for kv in g.bench_key {
        g.valid[kv.second] = true
        g.page_href[kv.second] = bench_page_name(kv.first)
        register_anchors(g, doc_of("docs/xml", kv.second), g.bench_node[kv.first])
    }
    for kv in g.readme_key {
        if kv.first in g.modules {
            g.valid[kv.second] = true
            g.page_href[kv.second] = g.modules[kv.first] + ".html"
        }
    }
    # section anchors in details/briefs/READMEs are valid link targets too
    ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        let adoc = doc_of(xdir_of(c), c.refid)
        register_anchors(g, adoc, c.detail_id)
        register_anchors(g, adoc, c.brief_id)
        if c.short in g.readme_key {
            let ardoc = doc_of("docs/xml", g.readme_key[c.short])
            register_anchors(g, ardoc, g.readme_node[c.short])
        }
        ci = ci + 1
    }

    # source pages: every file a member is defined in + the test sources
    let src_set: dict<str, bool> = {}
    ci = 0
    while ci < len(g.comps) {
        for m in g.comps[ci].members {
            if m.srcfile != "" { src_set[m.srcfile] = true }
        }
        ci = ci + 1
    }
    for tdir in ["stdlib/tests", "stdlib/memory/tests", "tests/purrc"] {
        for f in cpp_files_sorted(tdir) { src_set[tdir + "/" + f] = true }
    }
    for h in harness_sources() { src_set[h] = true }
    for kv in g.decl_files { src_set[kv.first] = true }
    let src_paths: list<str> = []
    for kv in src_set { src_paths.append(kv.first) }
    src_paths = sorted_strs(src_paths)
    let src_sorted: list<str> = []
    for p in src_paths {
        if os.path.isfile(p) {
            g.src_map[p] = src_page_name(p)
            src_sorted.append(p)
        }
    }
    build_test_index(g)
    build_app_usage(g)

    if not os.path.isdir("docs/html") { os.makedirs("docs/html") }

    # class -> owning module (sorted by lowercased short), then synthesize any
    # module page referenced as a parent/owner but lacking its own namespace
    let class_keys: dict<str, str> = {}
    ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "class" and string.contains(c.short, "::") {
            let cut = string.rfind(c.short, "::")
            let owner = c.short[:cut]
            let prev = ""
            if owner in class_keys { prev = class_keys[owner] + us() }
            class_keys[owner] = prev + string.lower(c.short) + us() + c.refid
        }
        ci = ci + 1
    }
    let needed: dict<str, bool> = {}
    for kv in class_keys {
        g.classes_of[kv.first] = sort_pair_refids(kv.second)
        needed[kv.first] = true
    }
    ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.kind == "namespace" {
            let segs = string.split(c.short, "::")
            let prefix = ""
            let sep = ""
            let i = 0
            while i + 1 < len(segs) {
                prefix = prefix + sep + segs[i]
                sep = "::"
                needed[prefix] = true
                i = i + 1
            }
        }
        ci = ci + 1
    }
    let missing: list<str> = []
    for kv in needed {
        if not (kv.first in g.modules) { missing.append(kv.first) }
    }
    for short in sorted_strs(missing) {
        let srefid = "nsx_" + string.replace(short, "::", "_")
        let sc = Compound({.refid = srefid, .kind = "namespace"})
        sc.name = "cheatah::" + short
        sc.short = short
        sc.title = string.replace(short, "::", ".")
        sc.brief_id = -1
        sc.detail_id = -1
        g.comp_idx[srefid] = len(g.comps)
        g.comps.append(sc)
        g.mod_short[srefid] = string.replace(short, "::", ".")
        g.valid[srefid] = true
    }

    # extension trees (docs/xml-ext/<ext>/) — each sibling extension joins the
    # site as its own SUBSITE (docs/html/<ext>/): module/class/concept pages
    # plus a landing + releases page
    let n_stdlib = len(g.comps)
    if os.path.isdir("docs/xml-ext") {
        let ext_dirs: list<str> = []
        for d in os.listdir("docs/xml-ext") {
            if os.path.isfile("docs/xml-ext/" + d + "/index.xml") { ext_dirs.append(d) }
        }
        g.ext_names = sorted_strs(ext_dirs)
        for extname in g.ext_names {
            load_ext_tree(g, extname)
            load_ext_manifest(g, extname)
        }
    }
    # section anchors on extension pages are valid link targets too
    ci = n_stdlib
    while ci < len(g.comps) {
        let c = g.comps[ci]
        let adoc = doc_of(xdir_of(c), c.refid)
        register_anchors(g, adoc, c.detail_id)
        register_anchors(g, adoc, c.brief_id)
        ci = ci + 1
    }
    # extension classes/structs/concepts, listed on their owning module's page
    # (indices, not refids — refids may repeat across separate Doxygen trees)
    ci = n_stdlib
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.ext != "" and c.kind != "namespace" and string.contains(c.short, "::") {
            let cut = string.rfind(c.short, "::")
            let key = c.ext + us() + c.short[:cut]
            let prev = ""
            if key in g.ext_classes { prev = g.ext_classes[key] + us() }
            g.ext_classes[key] = prev + string.lower(c.short) + us() + str(ci)
        }
        ci = ci + 1
    }
    let ext_classes_sorted: dict<str, str> = {}
    for kv in g.ext_classes { ext_classes_sorted[kv.first] = sort_pair_refids(kv.second) }
    g.ext_classes = ext_classes_sorted

    let sidebar = build_sidebar(g)

    # content hash for cache busting (?v=…) — the stylesheet is the only shared asset
    g.vers_css = hashlib.sha256(io.read_file("docs/gen/assets/cheatah-docs.css"))[:8]

    let pages = 0
    for p in src_sorted {
        write_file("docs/html/" + g.src_map[p],
                   with_seo(mark_active(render_source_page(g, p, sidebar), g.src_map[p]), g,
                            g.src_map[p], "Source listing: " + p + " in the cheatah toolchain.", true))
        pages = pages + 1
    }
    ci = 0
    while ci < len(g.comps) {
        let c = g.comps[ci]
        if c.ext != "" {
            ci = ci + 1
            continue                   # extension pages render into their subsite below
        }
        if c.kind == "page" {
            if c.refid == "indexpage" {
                write_file("docs/html/index.html",
                           with_seo(mark_active(render_home(g, ci, sidebar), "index.html"), g, "index.html",
                                    "cheatah — pronounced cheetah, misspelled on purpose — is a small, Python-like programming language that compiles to native machine code. This is the standard library reference.", false))
                pages = pages + 1
            } elif c.refid != "complexity" and c.refid != "alloc" and c.refid != "test" and c.refid != "crtest" and c.refid != "systest" {
                write_file("docs/html/" + c.refid + ".html",
                           with_seo(mark_active(render_compound_page(g, ci, sidebar), c.refid + ".html"), g,
                                    c.refid + ".html", page_desc(g, ci), false))
                pages = pages + 1
            }
        } else {
            write_file("docs/html/" + c.refid + ".html",
                       with_seo(mark_active(render_compound_page(g, ci, sidebar), c.refid + ".html"), g,
                                c.refid + ".html", page_desc(g, ci), false))
            pages = pages + 1
        }
        ci = ci + 1
    }
    write_file("docs/html/transpiler.html",
               with_seo(mark_active(render_transpiler_page(g, sidebar), "transpiler.html"), g, "transpiler.html",
                        "How the cheatah compiler turns a .purr source file into modern C++, and from there into native machine code.", false))
    write_file("docs/html/standard.html",
               with_seo(mark_active(render_standard_page(g, sidebar), "standard.html"), g, "standard.html",
                        "The Biome Standard: one semantic version naming the set of cheatah toolchain and package releases that are known to work together.", false))
    pages = pages + 2

    # benchmark subpages: one per stdlib/<mod>/BENCHMARKS.md, with the MODULE's sidebar
    # entry marked active (the page is the module's, not a guide of its own)
    let bench_mods: list<str> = []
    for kv in g.bench_key { bench_mods.append(kv.first) }
    for mod in sorted_strs(bench_mods) {
        let fname = bench_page_name(mod)
        let active = fname
        if mod in g.modules { active = g.modules[mod] + ".html" }
        write_file("docs/html/" + fname,
                   with_seo(mark_active(render_bench_page(g, mod, sidebar), active), g, fname,
                            mod + " benchmarks — the generated measurement tables for the cheatah " + mod + " module: every case, the harness that measured it, and how to reproduce it.", false))
        pages = pages + 1
    }

    # extension subsites: docs/html/<ext>/ — landing + releases + this
    # extension's own pages (the shared css/logo stay in the parent;
    # subsite pages reach them through "../")
    for extname in g.ext_names {
        let esb = build_ext_sidebar(g, extname)
        write_file("docs/html/" + extname + "/index.html",
                   with_seo(mark_active(render_ext_home(g, extname, esb), "index.html"), g, extname + "/index.html",
                            extname + " — an extension package for the cheatah programming language: what it provides and how to depend on it.", false))
        write_file("docs/html/" + extname + "/releases.html",
                   with_seo(mark_active(render_ext_releases(g, extname, esb), "releases.html"), g, extname + "/releases.html",
                            extname + " release history: every published version, what changed, and the Biome Standard it targets.", false))
        pages = pages + 2
        ci = 0
        while ci < len(g.comps) {
            let c = g.comps[ci]
            if c.ext == extname {
                write_file("docs/html/" + extname + "/" + c.refid + ".html",
                           with_seo(mark_active(render_compound_page(g, ci, esb), c.refid + ".html"), g,
                                    extname + "/" + c.refid + ".html", page_desc(g, ci), false))
                pages = pages + 1
            }
            ci = ci + 1
        }
    }

    write_file("docs/html/cheatah-docs.css", io.read_file("docs/gen/assets/cheatah-docs.css"))
    if os.path.isfile("docs/theme/cheatah-logo.png") {
        write_file("docs/html/cheatah-logo.png", io.read_file("docs/theme/cheatah-logo.png"))
    }
    io.print("generate: wrote " + str(pages) + " pages -> " + os.path.join(os.getcwd(), "docs/html"))
    if len(g.missing_tests) > 0 {
        let names: list<str> = []
        for kv in g.missing_tests { names.append(kv.first) }
        io.print("generate: " + str(len(names)) + " @test name(s) resolve to no test source (scripts/doc_lint.sh tests lists them)")
        if os.getenv("DOCS_LIST_MISSING_TESTS", "") != "" {
            for n in sorted_strs(names) { io.print("  " + n) }
        }
    }
}

main()
