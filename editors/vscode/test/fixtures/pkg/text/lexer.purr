# pkg.textlex — a tiny lexer fixture. Its physical path (pkg/text/lexer.purr) deliberately does NOT
# match the module tail (`pkg.textlex`), mirroring glGAN's re-exported submodules: resolution is by
# symbol under the package, not by dotted-path-to-file.

# The one thing a stage needs from a text container.
interface TextSource {
    fn size(self)
    fn at(self, i: int)
}

# The default adapter: a plain string.
struct StrText: TextSource {
    s: str

    fn size(self) -> int {
        return int(len(self.s))
    }
    fn at(self, i: int) -> str {
        return self.s[i]
    }
}

# Scan a TextSource into a length. The one heavy function.
fn scan(text: TextSource) -> int {
    return text.size()
}
